return {
    {
        name = "SuperSpeed",
        desc = "superspeed | sets walkspeed to 100",
        args = false,
        run = function(value)
            local char = game.Players.LocalPlayer.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = 100 end
        end,
    },
    {
        name = "LowGravity",
        desc = "lowgravity | sets gravity to 50",
        args = false,
        run = function(value)
            workspace.Gravity = 50
        end,
    },
    {
        name = "CustomSpeed",
        desc = "customspeed | sets a custom speed",
        args = true,
        run = function(value)
            local n = tonumber(value) or 16
            local char = game.Players.LocalPlayer.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = n end
        end,
    },
}
