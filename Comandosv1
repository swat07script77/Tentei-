        local ContentFrame = Instance.new("Frame")
        ContentFrame.Size = UDim2.new(1, 0, 1, -50)
        ContentFrame.Position = UDim2.new(0, 0, 0, 50)
        ContentFrame.BackgroundTransparency = 1
        ContentFrame.ClipsDescendants = true
        ContentFrame.ZIndex = 2
        ContentFrame.Parent = BodyFrame

        local tabButtons = {}
        local tabPanels = {}
        local currentTab = nil

        local function switchTab(name)
            if currentTab == name then return end
            currentTab = name
            for tabName, btn in pairs(tabButtons) do
                local active = (tabName == name)
                TweenService:Create(btn, TweenInfo.new(0.15), {
                    BackgroundColor3 = active and Colors.TabActive or Colors.TabInactive
                }):Play()
            end
            for tabName, panel in pairs(tabPanels) do
                panel.Visible = (tabName == name)
            end
        end

        local function createTab(name, order)
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(0, 118, 1, 0)
            btn.BackgroundColor3 = Colors.TabInactive
            btn.Text = name
            btn.TextColor3 = Colors.Text
            btn.Font = Enum.Font.GothamBold
            btn.TextSize = 13
            btn.AutoButtonColor = false
            btn.LayoutOrder = order
            btn.ZIndex = 3
            btn.Active = true
            btn.Parent = TabBar
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

            btn.MouseEnter:Connect(function()
                if currentTab ~= name then
                    TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = Colors.TabHover}):Play()
                end
            end)
            btn.MouseLeave:Connect(function()
                if currentTab ~= name then
                    TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = Colors.TabInactive}):Play()
                end
            end)
            btn.MouseButton1Click:Connect(function()
                switchTab(name)
            end)

            local panel = Instance.new("Frame")
            panel.Size = UDim2.new(1, 0, 1, 0)
            panel.BackgroundTransparency = 1
            panel.Visible = false
            panel.ZIndex = 2
            panel.Parent = ContentFrame

            local lay = Instance.new("UIListLayout")
            lay.FillDirection = Enum.FillDirection.Vertical
            lay.SortOrder = Enum.SortOrder.LayoutOrder
            lay.Padding = UDim.new(0, 5)
            lay.Parent = panel

            tabButtons[name] = btn
            tabPanels[name] = panel
            return panel
        end

        local lettersPanel = createTab("Letters", 1)
        local function buildLetters()
            local r1 = createRow(lettersPanel, 1)
            for _, k in ipairs({
                {"Q", Enum.KeyCode.Q}, {"W", Enum.KeyCode.W}, {"E", Enum.KeyCode.E},
                {"R", Enum.KeyCode.R}, {"T", Enum.KeyCode.T}, {"Y", Enum.KeyCode.Y},
                {"U", Enum.KeyCode.U}, {"I", Enum.KeyCode.I}, {"O", Enum.KeyCode.O},
                {"P", Enum.KeyCode.P},
            }) do createKey(r1, k[1], k[2], 56, "normal") end

            local r2 = createRow(lettersPanel, 2)
            for _, k in ipairs({
                {"A", Enum.KeyCode.A}, {"S", Enum.KeyCode.S}, {"D", Enum.KeyCode.D},
                {"F", Enum.KeyCode.F}, {"G", Enum.KeyCode.G}, {"H", Enum.KeyCode.H},
                {"J", Enum.KeyCode.J}, {"K", Enum.KeyCode.K}, {"L", Enum.KeyCode.L},
            }) do createKey(r2, k[1], k[2], 56, "normal") end

            local r3 = createRow(lettersPanel, 3)
            for _, k in ipairs({
                {"Z", Enum.KeyCode.Z}, {"X", Enum.KeyCode.X}, {"C", Enum.KeyCode.C},
                {"V", Enum.KeyCode.V}, {"B", Enum.KeyCode.B}, {"N", Enum.KeyCode.N},
                {"M", Enum.KeyCode.M},
            }) do createKey(r3, k[1], k[2], 56, "normal") end

            local r4 = createRow(lettersPanel, 4)
            shiftKeyRef = createKey(r4, "Shift", nil, 80, "special", "shift")
            capsKeyRef  = createKey(r4, "Caps",  Enum.KeyCode.CapsLock, 70, "special", "caps")
            createKey(r4, "Space", Enum.KeyCode.Space, 230, "normal")
            createKey(r4, "Back",  Enum.KeyCode.Backspace, 70, "special")

            local r5 = createRow(lettersPanel, 5)
            createKey(r5, "Tab",   Enum.KeyCode.Tab,    80, "special")
            createKey(r5, "Enter", Enum.KeyCode.Return, 100, "special")
        end
        buildLetters()

        local numPanel = createTab("Numbers", 2)
        local function buildNumbers()
            local r1 = createRow(numPanel, 1)
            for _, k in ipairs({
                {"1", Enum.KeyCode.One}, {"2", Enum.KeyCode.Two}, {"3", Enum.KeyCode.Three},
                {"4", Enum.KeyCode.Four}, {"5", Enum.KeyCode.Five}, {"6", Enum.KeyCode.Six},
                {"7", Enum.KeyCode.Seven}, {"8", Enum.KeyCode.Eight}, {"9", Enum.KeyCode.Nine},
                {"0", Enum.KeyCode.Zero},
            }) do createKey(r1, k[1], k[2], 52, "normal") end

            local r2 = createRow(numPanel, 2)
            for _, k in ipairs({
                {"-", Enum.KeyCode.Minus}, {"=", Enum.KeyCode.Equals},
                {"[", Enum.KeyCode.LeftBracket}, {"]", Enum.KeyCode.RightBracket},
                {";", Enum.KeyCode.Semicolon}, {"'", Enum.KeyCode.Quote},
                {",", Enum.KeyCode.Comma}, {".", Enum.KeyCode.Period},
                {"/", Enum.KeyCode.Slash}, {"\\", Enum.KeyCode.BackSlash},
            }) do createKey(r2, k[1], k[2], 52, "normal") end

            local r3 = createRow(numPanel, 3)
            createKey(r3, "`", Enum.KeyCode.Backquote, 60, "normal")
            createKey(r3, "Esc", Enum.KeyCode.Escape, 90, "special")
            createKey(r3, "Del", Enum.KeyCode.Delete, 90, "special")
            createKey(r3, "Ins", Enum.KeyCode.Insert, 90, "special")
            createKey(r3, "Menu", Enum.KeyCode.Menu, 90, "special")

            local r4 = createRow(numPanel, 4)
            createKey(r4, "Home",  Enum.KeyCode.Home,     90, "special")
            createKey(r4, "End",   Enum.KeyCode.End,      90, "special")
            createKey(r4, "PgUp",  Enum.KeyCode.PageUp,   90, "special")
            createKey(r4, "PgDn",  Enum.KeyCode.PageDown, 90, "special")

            local r5 = createRow(numPanel, 5)
            createKey(r5, "Print", Enum.KeyCode.Print,      100, "func")
            createKey(r5, "Scroll",Enum.KeyCode.ScrollLock, 100, "func")
            createKey(r5, "Pause", Enum.KeyCode.Pause,      100, "func")
        end
        buildNumbers()

        local funcPanel = createTab("F1 - F12", 3)
        local function buildFunctions()
            local r1 = createRow(funcPanel, 1)
            for i = 1, 6 do
                createKey(r1, "F"..i, Enum.KeyCode["F"..i], 90, "func")
            end
            local r2 = createRow(funcPanel, 2)
            for i = 7, 12 do
                createKey(r2, "F"..i, Enum.KeyCode["F"..i], 90, "func")
            end

            local r3 = createRow(funcPanel, 3)
            createKey(r3, "Shift (L)", Enum.KeyCode.LeftShift,  110, "special")
            createKey(r3, "Shift (R)", Enum.KeyCode.RightShift, 110, "special")
            createKey(r3, "Ctrl (L)",  Enum.KeyCode.LeftControl, 110, "special")
            createKey(r3, "Ctrl (R)",  Enum.KeyCode.RightControl,110, "special")

            local r4 = createRow(funcPanel, 4)
            createKey(r4, "Alt (L)", Enum.KeyCode.LeftAlt,   110, "special")
            createKey(r4, "Alt (R)", Enum.KeyCode.RightAlt,  110, "special")
            createKey(r4, "Meta (L)",Enum.KeyCode.LeftMeta,  110, "special")
            createKey(r4, "Meta (R)",Enum.KeyCode.RightMeta, 110, "special")
        end
        buildFunctions()

        local arrowPanel = createTab("Arrows", 4)
        local function buildArrows()
            local grid = Instance.new("Frame")
            grid.Size = UDim2.new(0, 200, 0, 140)
            grid.Position = UDim2.new(0.5, -100, 0, 10)
            grid.BackgroundTransparency = 1
            grid.ZIndex = 2
            grid.Parent = arrowPanel

            local function makeArrow(x, y, label, code)
                local row = Instance.new("Frame")
                row.Size = UDim2.new(0, 60, 0, 60)
                row.Position = UDim2.new(0, x, 0, y)
                row.BackgroundTransparency = 1
                row.ZIndex = 2
                row.Parent = grid
                createKey(row, label, code, 60, "special")
            end

            makeArrow(70, 0,   "Up",    Enum.KeyCode.Up)
            makeArrow(0,  70,  "Left",  Enum.KeyCode.Left)
            makeArrow(70, 70,  "Down",  Enum.KeyCode.Down)
            makeArrow(140, 70, "Right", Enum.KeyCode.Right)

            local r1 = createRow(arrowPanel, 2)
            r1.Position = UDim2.new(0, 0, 0, 160)
            createKey(r1, "Enter", Enum.KeyCode.Return, 100, "special")
            createKey(r1, "Back",  Enum.KeyCode.Backspace, 80, "special")
        end
        buildArrows()

        local numpadPanel = createTab("Numpad", 5)
        local function buildNumpad()
            local rows = {
                {{"NumLk", Enum.KeyCode.KeypadEquals, "special"}, {"/", Enum.KeyCode.KeypadDivide}, {"*", Enum.KeyCode.KeypadMultiply}, {"-", Enum.KeyCode.KeypadMinus}},
                {{"7", Enum.KeyCode.KeypadSeven}, {"8", Enum.KeyCode.KeypadEight}, {"9", Enum.KeyCode.KeypadNine}, {"+", Enum.KeyCode.KeypadPlus}},
                {{"4", Enum.KeyCode.KeypadFour}, {"5", Enum.KeyCode.KeypadFive}, {"6", Enum.KeyCode.KeypadSix}, {"=", Enum.KeyCode.KeypadEquals}},
                {{"1", Enum.KeyCode.KeypadOne}, {"2", Enum.KeyCode.KeypadTwo}, {"3", Enum.KeyCode.KeypadThree}, {"Ent", Enum.KeyCode.KeypadEnter}},
                {{"0", Enum.KeyCode.KeypadZero}, {".", Enum.KeyCode.KeypadPeriod}, {"Del", Enum.KeyCode.KeypadPeriod, "special"}, {"", nil}},
            }
            for i, row in ipairs(rows) do
                local r = createRow(numpadPanel, i)
                for _, k in ipairs(row) do
                    if k[2] then
                        createKey(r, k[1], k[2], 80, k[3] or "normal")
                    end
                end
            end
        end
        buildNumpad()

        switchTab("Letters")

        UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            local key = input.KeyCode
            if key == Enum.KeyCode.LeftShift or key == Enum.KeyCode.RightShift then
                shiftActive = true; updateShiftVisual(); return
            end
            if key == Enum.KeyCode.CapsLock then
                capsActive = not capsActive; updateCapsVisual(); return
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Keyboard then
                if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
                    shiftActive = false
                    updateShiftVisual()
                end
            end
        end)
    end,
},
