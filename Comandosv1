    name = "antihumanoidmod",
    desc = "antihumanoidmod | WARNING: HIGH BAN RISK! Blocks scripts from modifying your Humanoid.",
    args = false,
    run = function()
        _G.AntiHumanoidActive = true
        local player = game.Players.LocalPlayer
        
        local function protectCharacter(char)
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if humanoid then
                local mt = getrawmetatable and getrawmetatable(humanoid)
                if mt and setreadonly then
                    pcall(function()
                        setreadonly(mt, false)
                        local oldNewIndex = mt.__newindex
                        mt.__newindex = newcclosure(function(self, idx, val)
                            if _G.AntiHumanoidActive and self == humanoid then
                                if idx == "WalkSpeed" or idx == "JumpPower" or idx == "Health" or idx == "MaxHealth" or idx == "JumpHeight" then
                                    return
                                end
                            end
                            return oldNewIndex(self, idx, val)
                        end)
                        setreadonly(mt, true)
                    end)
                end
            end
        end
        
        if player.Character then
            protectCharacter(player.Character)
        end
        
        if not _G._AntiHumanoidCharConn then
            _G._AntiHumanoidCharConn = player.CharacterAdded:Connect(function(char)
                task.wait(0.5)
                if _G.AntiHumanoidActive then
                    protectCharacter(char)
                end
            end)
        end
    end,
