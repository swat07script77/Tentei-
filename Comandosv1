{
    name = "VehicleFly",
    desc = "vehiclefly | fly your vehicle with WASD (E/Q up/down), usage: vehiclefly <speed>",
    args = true,
    run = function(value)
        local me = game.Players.LocalPlayer
        local RunService = game:GetService("RunService")
        local UIS = game:GetService("UserInputService")

        if _G.VehFlyActive then
            _G.VehFlyActive = false
            if _G.VehFlyConn then _G.VehFlyConn:Disconnect(); _G.VehFlyConn = nil end
            if _G.VehFlyBg then _G.VehFlyBg:Destroy(); _G.VehFlyBg = nil end
            if _G.VehFlyBv then _G.VehFlyBv:Destroy(); _G.VehFlyBv = nil end
            if _G.VehFlyInputB then _G.VehFlyInputB:Disconnect(); _G.VehFlyInputB = nil end
            if _G.VehFlyInputE then _G.VehFlyInputE:Disconnect(); _G.VehFlyInputE = nil end
            _G.VehFlyCtrl = nil
            _G.VehFlyUp = false
            _G.VehFlyDown = false
            return
        end

        local speed = tonumber(value) or 50
        _G.VehFlySpeed = speed

        local char = me.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or not hum.SeatPart then
            createNotification("VehicleFly", "You need to be sitting in a vehicle", CONFIG.NotifColorRed)
            return
        end

        local seat = hum.SeatPart
        local vehicle = seat:FindFirstAncestorWhichIsA("Model")
        if not vehicle then return end

        local root = vehicle.PrimaryPart or seat

        _G.VehFlyActive = true
        _G.VehFlyCtrl = { F = 0, B = 0, L = 0, R = 0 }

        _G.VehFlyBg = Instance.new("BodyGyro")
        _G.VehFlyBg.P = 9e4
        _G.VehFlyBg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        _G.VehFlyBg.CFrame = root.CFrame
        _G.VehFlyBg.Parent = root

        _G.VehFlyBv = Instance.new("BodyVelocity")
        _G.VehFlyBv.Velocity = Vector3.new(0, 0, 0)
        _G.VehFlyBv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        _G.VehFlyBv.Parent = root

        local camera = workspace.CurrentCamera

        _G.VehFlyConn = RunService.RenderStepped:Connect(function()
            if not _G.VehFlyActive then return end
            local r = vehicle.PrimaryPart or seat
            if not r then return end

            local move = (camera.CFrame.LookVector * (_G.VehFlyCtrl.F + _G.VehFlyCtrl.B)) +
                ((camera.CFrame * CFrame.new(_G.VehFlyCtrl.L + _G.VehFlyCtrl.R, 0, 0).p) - camera.CFrame.p)
            local vertical = 0
            if _G.VehFlyUp then vertical = vertical + 1 end
            if _G.VehFlyDown then vertical = vertical - 1 end
            move = move + Vector3.new(0, vertical, 0)

            _G.VehFlyBv.Velocity = move * speed
            _G.VehFlyBg.CFrame = camera.CFrame
        end)

        _G.VehFlyInputB = UIS.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.KeyCode == Enum.KeyCode.W then _G.VehFlyCtrl.F = 1
            elseif input.KeyCode == Enum.KeyCode.S then _G.VehFlyCtrl.B = -1
            elseif input.KeyCode == Enum.KeyCode.A then _G.VehFlyCtrl.L = -1
            elseif input.KeyCode == Enum.KeyCode.D then _G.VehFlyCtrl.R = 1
            elseif input.KeyCode == Enum.KeyCode.E then _G.VehFlyUp = true
            elseif input.KeyCode == Enum.KeyCode.Q then _G.VehFlyDown = true end
        end)

        _G.VehFlyInputE = UIS.InputEnded:Connect(function(input)
            if input.KeyCode == Enum.KeyCode.W then _G.VehFlyCtrl.F = 0
            elseif input.KeyCode == Enum.KeyCode.S then _G.VehFlyCtrl.B = 0
            elseif input.KeyCode == Enum.KeyCode.A then _G.VehFlyCtrl.L = 0
            elseif input.KeyCode == Enum.KeyCode.D then _G.VehFlyCtrl.R = 0
            elseif input.KeyCode == Enum.KeyCode.E then _G.VehFlyUp = false
            elseif input.KeyCode == Enum.KeyCode.Q then _G.VehFlyDown = false end
        end)
    end,
},
