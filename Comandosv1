            if v:IsA("VehicleSeat") then
                v.MaxSpeed = speed
                v.Torque = speed * 100
            end
            if v:IsA("BodyVelocity") or v:IsA("BodyAngularVelocity") then
                v.MaxForce = Vector3.new(speed * 1000, speed * 1000, speed * 1000)
            end
        end
    end,
