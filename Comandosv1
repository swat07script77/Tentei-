{
    name = "ToolAttach",
    desc = "toolattach | gives you a tool that flings players to the void on click",
    args = false,
    run = function(value)
        local Players = game:GetService("Players")
        local RunService = game:GetService("RunService")
        local me = game.Players.LocalPlayer
        local mouse = me:GetMouse()

        task.spawn(function()
            while true do
                RunService.Heartbeat:Wait()
                local char = me.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local humanoid = char and char:FindFirstChildOfClass("Humanoid")

                if humanoid then
                    humanoid.MaxHealth = math.huge
                    humanoid.Health = humanoid.MaxHealth
                end

                local destroyHeight = workspace.FallenPartsDestroyHeight or -500
                if root and root.Position.Y < destroyHeight + 100 then
                    root.CFrame = CFrame.new(root.Position.X, 50, root.Position.Z)
                    root.Velocity = Vector3.new(0, 0, 0)
                    root.RotVelocity = Vector3.new(0, 0, 0)
                end
            end
        end)

        local function WalkFlingVoid(state)
            if not state then
                _G.WalkFlingVoidActive = false
                if _G.WalkFlingVoidThread then
                    task.cancel(_G.WalkFlingVoidThread)
                    _G.WalkFlingVoidThread = nil
                end
                local char = me.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root then
                    root.Velocity = Vector3.new(0, 0, 0)
                    root.RotVelocity = Vector3.new(0, 0, 0)
                end
                return
            end

            _G.WalkFlingVoidActive = true
            _G.WalkFlingVoidThread = task.spawn(function()
                repeat
                    RunService.Heartbeat:Wait()
                    if not _G.WalkFlingVoidActive then break end
                    local character = me.Character
                    local root = character and character:FindFirstChild("HumanoidRootPart")
                    if not root then break end

                    root.Velocity = Vector3.new(0, -10000, 0)
                    RunService.RenderStepped:Wait()
                    if _G.WalkFlingVoidActive and character and character.Parent and root and root.Parent then
                        root.Velocity = Vector3.new(0, -10000, 0)
                    end
                    RunService.Stepped:Wait()
                    if _G.WalkFlingVoidActive and character and character.Parent and root and root.Parent then
                        root.Velocity = Vector3.new(0, -10000, 0)
                    end
                until not _G.WalkFlingVoidActive
            end)
        end

        local function UnWalkFlingVoid()
            WalkFlingVoid(false)
        end

        local tool = Instance.new("Tool")
        tool.Name = "attach"
        tool.RequiresHandle = false
        tool.CanBeDropped = false

        local isExecuting = false

        local function onActivated()
            if isExecuting then return end

            local myChar = me.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not myRoot then return end

            local targetPart = mouse.Target
            if not targetPart then return end

            local targetChar = targetPart:FindFirstAncestorOfClass("Model")
            local targetPlayer = Players:GetPlayerFromCharacter(targetChar)
            local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")

            if targetPlayer and targetPlayer ~= me and targetRoot then
                isExecuting = true

                local originalCFrame = myRoot.CFrame
                WalkFlingVoid(true)

                local startTime = tick()
                local connection
                connection = RunService.Heartbeat:Connect(function()
                    if tick() - startTime < 2 and targetRoot and targetRoot.Parent and myRoot and myRoot.Parent then
                        myRoot.CFrame = targetRoot.CFrame * CFrame.Angles(math.rad(90), 0, 0)
                    else
                        connection:Disconnect()
                    end
                end)

                task.wait(2)

                UnWalkFlingVoid()
                if myRoot and myRoot.Parent then
                    myRoot.CFrame = originalCFrame
                    myRoot.Velocity = Vector3.new(0, 0, 0)
                    myRoot.RotVelocity = Vector3.new(0, 0, 0)
                end

                isExecuting = false
            end
        end

        tool.Activated:Connect(onActivated)
        tool.GripPos = Vector3.new(0, 9e99, 0)
        tool.Parent = me.Character or me:WaitForChild("Backpack")
    end,
},
