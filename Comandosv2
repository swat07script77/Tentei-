            if not c then return end
            for _, part in ipairs(c:GetChildren()) do
                if part:IsA("BasePart") then
                    _G.SuperFlingBackup.Parts[part] = part.CustomPhysicalProperties
                    pcall(function()
                        part.CustomPhysicalProperties = PhysicalProperties.new(0.01, 0, 0, 0, 0)
                    end)
                end
            end
        end

        local function restaurarTudo()
            local backup = _G.SuperFlingBackup
            if not backup then return end

            pcall(function()
                local n = settings().Network
                if backup.Network.IncomingReplicationLag ~= nil then n.IncomingReplicationLag = backup.Network.IncomingReplicationLag end
                if backup.Network.OutgoingReplicationLag ~= nil then n.OutgoingReplicationLag = backup.Network.OutgoingReplicationLag end
                if backup.Network.IncomingReplicationRate ~= nil then n.IncomingReplicationRate = backup.Network.IncomingReplicationRate end
                if backup.Network.OutgoingReplicationRate ~= nil then n.OutgoingReplicationRate = backup.Network.OutgoingReplicationRate end
                if backup.Network.PhysicsSendRate ~= nil then n.PhysicsSendRate = backup.Network.PhysicsSendRate end
                if backup.Network.PhysicsReceiveRate ~= nil then n.PhysicsReceiveRate = backup.Network.PhysicsReceiveRate end
                if backup.Network.DataSendRate ~= nil then n.DataSendRate = backup.Network.DataSendRate end
                if backup.Network.DataReceiveRate ~= nil then n.DataReceiveRate = backup.Network.DataReceiveRate end
            end)

            pcall(function()
                local p = settings().Physics
                if backup.Physics.AllowSleeping ~= nil then p.AllowSleeping = backup.Physics.AllowSleeping end
                if backup.Physics.ThrottleAdjustTime ~= nil then p.ThrottleAdjustTime = backup.Physics.ThrottleAdjustTime end
            end)

            for part, props in pairs(backup.Parts) do
                pcall(function()
                    if part and part.Parent then
                        part.CustomPhysicalProperties = props
                    end
                end)
            end

            if type(raknet) == "table" and type(raknet.desync) == "function" then
                pcall(function() raknet.desync(false) end)
            end

