    desc = "superfling | flings a player with extreme force (name to target)",
    args = true,
    run = function(value)
        local arg = tostring(value or "")
        if arg == "" then return end

        local q = string.lower(arg)
        local target = nil
        for _, p in ipairs(game.Players:GetPlayers()) do
            if p ~= player then
                if string.lower(p.Name) == q or string.lower(p.DisplayName) == q
                    or string.find(string.lower(p.Name), q, 1, true)
                    or string.find(string.lower(p.DisplayName), q, 1, true) then
                    target = p
                    break
                end
            end
        end
        if not target or not target.Character then return end

        local char = player.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end

        local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
        local targetHum = target.Character:FindFirstChildOfClass("Humanoid")
        if not targetRoot or not targetHum then return end

        local sethiddenproperty = sethiddenproperty or function() return false end

        _G.SuperFlingBackup = { Network = {}, Physics = {}, Parts = {} }

        pcall(function()
            local n = settings().Network
            _G.SuperFlingBackup.Network.IncomingReplicationLag = n.IncomingReplicationLag
            _G.SuperFlingBackup.Network.OutgoingReplicationLag = n.OutgoingReplicationLag
            _G.SuperFlingBackup.Network.IncomingReplicationRate = n.IncomingReplicationRate
            _G.SuperFlingBackup.Network.OutgoingReplicationRate = n.OutgoingReplicationRate
            _G.SuperFlingBackup.Network.PhysicsSendRate = n.PhysicsSendRate
            _G.SuperFlingBackup.Network.PhysicsReceiveRate = n.PhysicsReceiveRate
            _G.SuperFlingBackup.Network.DataSendRate = n.DataSendRate
            _G.SuperFlingBackup.Network.DataReceiveRate = n.DataReceiveRate
        end)

        pcall(function()
            local p = settings().Physics
            _G.SuperFlingBackup.Physics.AllowSleeping = p.AllowSleeping
            _G.SuperFlingBackup.Physics.ThrottleAdjustTime = p.ThrottleAdjustTime
        end)

        local function sistema1_SimRadius()
            pcall(function()
                sethiddenproperty(player, "SimulationRadius", math.huge)
                sethiddenproperty(player, "MaxSimulationRadius", math.huge)
            end)
        end

        local function sistema2_NetworkRates()
            pcall(function()
                local n = settings().Network
                n.IncomingReplicationLag = -1000
                n.OutgoingReplicationLag = -1000
                n.IncomingReplicationRate = 1000000
                n.OutgoingReplicationRate = 1000000
                n.PhysicsSendRate = 1000000
                n.PhysicsReceiveRate = 1000000
                n.DataSendRate = 1000000
                n.DataReceiveRate = 1000000
            end)
        end

        local function sistema3_Raknet()
            if type(raknet) == "table" and type(raknet.desync) == "function" then
                pcall(function() raknet.desync(true) end)
            end
        end

        local function sistema4_NoSleep()
            pcall(function()
                local p = settings().Physics
                if p then
                    p.AllowSleeping = false
                    p.ThrottleAdjustTime = 0
                end
            end)
