                local h = c:FindFirstChildOfClass("Humanoid")
                if h then
                    pcall(function()
                        h:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
                        h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
                        h.ChangeState(Enum.HumanoidStateType.Running)
                    end)
                end
            end

            _G.SuperFlingBackup = nil
        end

        local function aplicarTudo()
            sistema1_SimRadius()
            sistema2_NetworkRates()
            sistema3_Raknet()
            sistema4_NoSleep()
            sistema5_NetOwner()
        end

        aplicarTudo()
        sistema8_FisicaLeve()

        _G.SuperFlingActive = true
        _G.SuperFlingTarget = target

        hum.PlatformStand = true
        pcall(function()
            targetHum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        end)

        if _G.SuperFlingBV then
            pcall(function() _G.SuperFlingBV:Destroy() end)
        end

        local bv = Instance.new("BodyVelocity")
        bv.Name = "SuperFlingBV"
        bv.Velocity = Vector3.new(9e18, 9e18, 9e18)
        bv.MaxForce = Vector3.new(1/0, 1/0, 1/0)
        bv.Parent = targetRoot
        _G.SuperFlingBV = bv

        if _G.SuperFlingAntiDelayLoop then _G.SuperFlingAntiDelayLoop:Disconnect() end
        _G.SuperFlingAntiDelayLoop = RunService.Heartbeat:Connect(function()
            if not _G.SuperFlingActive then return end
            sistema1_SimRadius()
            sistema3_Raknet()
            sistema5_NetOwner()
        end)

        if _G.SuperFlingAntiDelayThread then task.cancel(_G.SuperFlingAntiDelayThread) end
        _G.SuperFlingAntiDelayThread = task.spawn(function()
            while _G.SuperFlingActive do
                task.wait(1)
                sistema2_NetworkRates()
                sistema4_NoSleep()
            end
        end)

        if _G.SuperFlingDied then _G.SuperFlingDied:Disconnect() end
        _G.SuperFlingDied = hum.Died:Connect(function()
            _G.SuperFlingActive = false
            if _G.SuperFlingBV then pcall(function() _G.SuperFlingBV:Destroy() end); _G.SuperFlingBV = nil end
            if _G.SuperFlingAntiDelayLoop then _G.SuperFlingAntiDelayLoop:Disconnect(); _G.SuperFlingAntiDelayLoop = nil end
            if _G.SuperFlingAntiDelayThread then task.cancel(_G.SuperFlingAntiDelayThread); _G.SuperFlingAntiDelayThread = nil end
            restaurarTudo()
        end)

        local superFlingOffset = Vector3.new(0, -3, 0)

        if _G.SuperFlingConn then _G.SuperFlingConn:Disconnect() end
        _G.SuperFlingConn = RunService.Heartbeat:Connect(function()
            if not _G.SuperFlingActive then return end

            local curChar = player.Character
            local curTarget = _G.SuperFlingTarget and _G.SuperFlingTarget.Character
            if not curChar or not curTarget then
                _G.SuperFlingActive = false
                if _G.SuperFlingBV then pcall(function() _G.SuperFlingBV:Destroy() end); _G.SuperFlingBV = nil end
                if _G.SuperFlingAntiDelayLoop then _G.SuperFlingAntiDelayLoop:Disconnect(); _G.SuperFlingAntiDelayLoop = nil end
                if _G.SuperFlingAntiDelayThread then task.cancel(_G.SuperFlingAntiDelayThread); _G.SuperFlingAntiDelayThread = nil end
                if _G.SuperFlingConn then _G.SuperFlingConn:Disconnect(); _G.SuperFlingConn = nil end
                restaurarTudo()
                return
            end

            local curRoot = curChar:FindFirstChild("HumanoidRootPart")
            local curTargetRoot = curTarget:FindFirstChild("HumanoidRootPart")
            if not curRoot or not curTargetRoot then return end

            curRoot.CFrame = CFrame.new(curTargetRoot.Position + superFlingOffset) * CFrame.Angles(-math.pi/2, 0, 0)
            curRoot.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
            curRoot.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
        end)
    end,
