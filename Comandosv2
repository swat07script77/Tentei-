                    or string.find(string.lower(p.DisplayName), q, 1, true) then
                    tPlayer = p
                    break
                end
            end
        end
        if not tPlayer then return end

        local function Kill()
            repeat task.wait() until tPlayer.Character
                and tPlayer.Character:FindFirstChildOfClass("Humanoid")
                and tPlayer.Character:FindFirstChildOfClass("Humanoid").Health > 0

            local Character = player.Character
            if not Character then return end
            local Humanoid = Character:FindFirstChildOfClass("Humanoid")
            local RootPart = Humanoid and Humanoid.RootPart
