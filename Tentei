
local SwordTab = S.Window:CreateTab("Sword", "swords")



local reachActive = false
local reachValue = 60
local reachSaved = {}
local reachConn = nil

SwordTab:CreateSlider({
    Title = "Reach Value",
    Min = 1, Max = 1000, Default = 60,
    Callback = function(v) reachValue = v end,
})

SwordTab:CreateToggle({
    Title = "Reach",
    Default = false,
    Callback = function(Value)
        pcall(function()
            reachActive = Value
            if reachConn then reachConn:Disconnect(); reachConn = nil end
            local char = S.Player.Character
            if not char then return end
            if Value then
                for _, v in ipairs(char:GetDescendants()) do
                    if v:IsA("Tool") and v:FindFirstChild("Handle") then
                        if not reachSaved[v] then
                            reachSaved[v] = { Size = v.Handle.Size, GripPos = v.GripPos }
                        end
                        v.Handle.Size = Vector3.new(0.5, 0.5, reachValue)
                        v.GripPos = Vector3.new(0, 0, 0)
                    end
                end
                reachConn = char.ChildAdded:Connect(function(child)
                    if reachActive and child:IsA("Tool") and child:FindFirstChild("Handle") then
                        if not reachSaved[child] then
                            reachSaved[child] = { Size = child.Handle.Size, GripPos = child.GripPos }
                        end
                        child.Handle.Size = Vector3.new(0.5, 0.5, reachValue)
                        child.GripPos = Vector3.new(0, 0, 0)
                    end
                end)
            else
                for tool, data in pairs(reachSaved) do
                    if tool and tool.Parent then
                        pcall(function()
                            if tool:FindFirstChild("Handle") then tool.Handle.Size = data.Size end
                            tool.GripPos = data.GripPos
                        end)
                    end
                end
                reachSaved = {}
            end
        end)
    end,
})

