})

Players.PlayerAdded:Connect(function(plr)
    if plr == LocalPlayer then return end
    plr.CharacterAdded:Connect(function()
        if viewToolActive then
            task.wait(0.5)
            if viewToolActive then BuildToolView(plr) end
        end
    end)
    if viewToolActive and plr.Character then
        task.wait(0.3)
        BuildToolView(plr)
    end
end)

Players.PlayerRemoving:Connect(function(plr)
    DestroyToolView(plr)
end)

LocalPlayer.CharacterAdded:Connect(function()
    if viewToolActive then
        task.wait(0.5)
        DestroyAllToolViews()
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then BuildToolView(plr) end
        end
    end
end)

