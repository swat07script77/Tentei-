local useToolsActive = false
local useToolsAmount = 1
local useToolsDelay = 0
local useToolsThread = nil

SwordTab:CreateSlider({
    Title = "UseTools Amount",
    Min = 1, Max = 50, Default = 1,
    Callback = function(v) useToolsAmount = v end,
})

SwordTab:CreateSlider({
    Title = "UseTools Delay",
    Min = 0, Max = 10, Default = 0,
    Callback = function(v) useToolsDelay = v end,
})

SwordTab:CreateToggle({
    Title = "UseTools",
    Default = false,
    Callback = function(Value)
        pcall(function()
            useToolsActive = Value
            if useToolsThread then task.cancel(useToolsThread); useToolsThread = nil end
            if not Value then return end
            useToolsThread = task.spawn(function()
                while useToolsActive do
                    local bp = S.Player:FindFirstChildOfClass("Backpack")
                    local char = S.Player.Character
                    if bp and char then
                        for _, v in ipairs(bp:GetChildren()) do
                            if v:IsA("Tool") and useToolsActive then
                                v.Parent = char
                                for _ = 1, useToolsAmount do
                                    if not useToolsActive then break end
                                    pcall(function() v:Activate() end)
                                    if useToolsDelay > 0 then task.wait(useToolsDelay) end
                                end
                                if v and v.Parent == char then v.Parent = bp end
                            end
                        end
                    end
                    task.wait(0.1)
                end
            end)
        end)
    end,
})

SwordTab:CreateButton({
    Title = "CopyTools",
    Callback = function()
        pcall(function()
            local found = GetPlayerByName(SwordTarget)
            if not found then return end
            local bp = found:FindFirstChildOfClass("Backpack")
            local myBp = S.Player:FindFirstChildOfClass("Backpack")
            if bp and myBp then
                for _, v in ipairs(bp:GetChildren()) do
                    if v:IsA("Tool") then pcall(function() v:Clone().Parent = myBp end) end
                end
            end
        end)
    end,
})

local viewToolActive = false
local viewToolConn = nil
local viewToolSaved = {}

SwordTab:CreateToggle({
    Title = "View Tool",
    Default = false,
    Callback = function(Value)
        pcall(function()
            viewToolActive = Value
            if viewToolConn then viewToolConn:Disconnect(); viewToolConn = nil end
            if not Value then
                for tool, data in pairs(viewToolSaved) do
                    if tool and tool.Parent then
                        pcall(function()
                            tool.Size = data.Size
                            tool.Transparency = data.Transparency
                        end)
                    end
                end
                viewToolSaved = {}
                return
            end
            viewToolConn = S.RS.Heartbeat:Connect(function()
                if not viewToolActive then return end
                local target = GetPlayerByName(SwordTarget)
                if not target or not target.Character then return end
                for _, v in ipairs(target.Character:GetChildren()) do
                    if v:IsA("Tool") then
                        local handle = v:FindFirstChild("Handle")
                        if handle then
                            if not viewToolSaved[handle] then
                                viewToolSaved[handle] = { Size = handle.Size, Transparency = handle.Transparency }
                            end
                            handle.Size = Vector3.new(3, 3, 3)
                            handle.Transparency = 0.5
                        end
                    end
                end
            end)
        end)
    end,
})

SwordTab:CreateButton({
    Title = "Tool Grab",
    Callback = function()
        pcall(function()
            local found = GetPlayerByName(SwordTarget)
            if not found or not found.Character then return end
            local myBp = S.Player:FindFirstChildOfClass("Backpack")
            if not myBp then return end
            for _, v in ipairs(found.Character:GetChildren()) do
                if v:IsA("Tool") then
                    pcall(function() v.Parent = myBp end)
                end
            end
        end)
    end,
})

