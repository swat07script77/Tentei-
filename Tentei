local function FindToolTexture(tool)
    if viewToolCachedTextures[tool] then
        local cached = viewToolCachedTextures[tool]
        if cached:IsDescendantOf(game) then return cached.Texture end
        viewToolCachedTextures[tool] = nil
    end
    for _, child in ipairs(tool:GetDescendants()) do
        if child:IsA("Texture") or child:IsA("Decal") then
            local tex = child.Texture
            if tex and tex ~= "" and tex ~= "rbxassetid://0" then
                viewToolCachedTextures[tool] = child
                return tex
            end
        end
    end
    return nil
end

