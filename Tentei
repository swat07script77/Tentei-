local SwordTab = Window:CreateTab("Sword", "swords")

local function GetPlayerByName(name)
    if not name or name == "" then return nil end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name == name then return plr end
    end
    return nil
end

local function AttackPlayer(targetPlayer, tool)
    if not firetouchinterest then return end
    local handle = tool and tool:FindFirstChild("Handle")
    if not handle then return end
    if not targetPlayer.Character then return end
    local hum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
    local root = hum and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root or not hum or hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then return end
    pcall(function()
        firetouchinterest(handle, root, 1)
        firetouchinterest(handle, root, 0)
    end)
end

local function GetToolTexture(tool)
    if not tool then return nil end
    local handle = tool:FindFirstChild("Handle")
    if handle then
        local mesh = handle:FindFirstChildOfClass("SpecialMesh")
        if mesh and mesh.TextureId and mesh.TextureId ~= "" then return mesh.TextureId end
        for _, c in ipairs(handle:GetChildren()) do
            if c:IsA("Texture") or c:IsA("Decal") then
                if c.Texture and c.Texture ~= "" and c.Texture ~= "rbxassetid://0" then return c.Texture end
            end
        end
    end
    for _, c in ipairs(tool:GetDescendants()) do
        if c:IsA("Texture") or c:IsA("Decal") then
            if c.Texture and c.Texture ~= "" and c.Texture ~= "rbxassetid://0" then return c.Texture end
        end
    end
    return nil
end

local function GetPlayerTools(plr)
    local tools = {}
    local char = plr.Character
    if char then
        for _, c in ipairs(char:GetChildren()) do
            if c:IsA("Tool") then table.insert(tools, c) end
        end
    end
    local bp = plr:FindFirstChild("Backpack")
    if bp then
        for _, c in ipairs(bp:GetChildren()) do
            if c:IsA("Tool") then table.insert(tools, c) end
        end
    end
    return tools
end

local SwordTarget = nil
local SwordTargetConn = nil

local function RefreshSwordTargetList()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then table.insert(list, plr.Name) end
    end
    table.sort(list)
    if SwordTargetConn and SwordTargetConn.Update then
        pcall(function() SwordTargetConn:Update({ Options = list }) end)
    end
end

SwordTargetConn = SwordTab:CreateDropdown({
    Title = "Select Target",
    Options = {},
    Callback = function(Value) SwordTarget = Value end,
})
RefreshSwordTargetList()

SwordTab:CreateButton({
    Title = "Refresh Target List",
    Callback = function() RefreshSwordTargetList() end,
})

Players.PlayerAdded:Connect(function() task.defer(RefreshSwordTargetList) end)
Players.PlayerRemoving:Connect(function() task.defer(RefreshSwordTargetList) end)

local killAuraActive = false
local killAuraConn = nil

SwordTab:CreateToggle({
    Title = "Kill Aura",
    Default = false,
    Callback = function(Value)
        pcall(function()
            killAuraActive = Value
            if killAuraConn then killAuraConn:Disconnect(); killAuraConn = nil end
            if not Value then return end
            if not firetouchinterest then
                Window:Notify({ Title = "Kill Aura", Description = "Needs firetouchinterest", Duration = 3, Type = "error" })
                killAuraActive = false
                return
            end
            killAuraConn = RunService.Heartbeat:Connect(function()
                if not killAuraActive then return end
                local curChar = LocalPlayer.Character
                if not curChar then return end
                local curTool = curChar:FindFirstChildOfClass("Tool")
                if not curTool or not curTool:FindFirstChild("Handle") then
                    killAuraActive = false
                    if killAuraConn then killAuraConn:Disconnect(); killAuraConn = nil end
                    return
                end
                for _, target in ipairs(Players:GetPlayers()) do
                    if target ~= LocalPlayer and target.Character then
                        AttackPlayer(target, curTool)
                    end
                end
            end)
        end)
    end,
})

local killTargetActive = false
local killTargetConn = nil

SwordTab:CreateToggle({
    Title = "Kill Target",
    Default = false,
    Callback = function(Value)
        pcall(function()
            killTargetActive = Value
            if killTargetConn then killTargetConn:Disconnect(); killTargetConn = nil end
            if not Value then return end
            if not firetouchinterest then
                Window:Notify({ Title = "Kill Target", Description = "Needs firetouchinterest", Duration = 3, Type = "error" })
                killTargetActive = false
                return
            end
            local target = GetPlayerByName(SwordTarget)
            if not target then
                Window:Notify({ Title = "Kill Target", Description = "Select a target first", Duration = 3, Type = "warning" })
                killTargetActive = false
                return
            end
            killTargetConn = RunService.Heartbeat:Connect(function()
                if not killTargetActive then return end
                local curChar = LocalPlayer.Character
                if not curChar then return end
                local curTool = curChar:FindFirstChildOfClass("Tool")
                if not curTool or not curTool:FindFirstChild("Handle") then return end
                local t = GetPlayerByName(SwordTarget)
                if not t or not t.Character then return end
                local tHum = t.Character:FindFirstChildOfClass("Humanoid")
                if not tHum or tHum.Health <= 0 then
                    killTargetActive = false
                    if killTargetConn then killTargetConn:Disconnect(); killTargetConn = nil end
                    return
                end
                AttackPlayer(t, curTool)
            end)
        end)
    end,
})

local autoToolActive = false
local autoToolConn = nil

SwordTab:CreateToggle({
    Title = "Auto Tool",
    Default = false,
    Callback = function(Value)
        pcall(function()
            autoToolActive = Value
            if autoToolConn then autoToolConn:Disconnect(); autoToolConn = nil end
            if not Value then return end
            autoToolConn = RunService.Heartbeat:Connect(function()
                if not autoToolActive then return end
                local char = LocalPlayer.Character
                if not char then return end
                local backpack = LocalPlayer:FindFirstChild("Backpack")
                if not backpack then return end
                local tools = {}
                for _, t in ipairs(backpack:GetChildren()) do
                    if t:IsA("Tool") then table.insert(tools, t) end
                end
                if #tools == 0 then return end
                local currentTool = char:FindFirstChildOfClass("Tool")
                local nextIndex = 1
                if currentTool then
                    for i, t in ipairs(tools) do
                        if t == currentTool then
                            nextIndex = i + 1
                            if nextIndex > #tools then nextIndex = 1 end
                            break
                        end
                    end
                end
                local nextTool = tools[nextIndex]
                if nextTool and nextTool ~= currentTool then
                    pcall(function() char.Humanoid:EquipTool(nextTool) end)
                end
            end)
        end)
    end,
})

local reachActive = false
local reachValue = 60
local reachSaved = {}
local reachConn = nil

SwordTab:CreateSlider({
    Title = "Reach Value",
    Min = 1, Max = 1000, Default = 60,
    Callback = function(v) reachValue = v end,
})

SwordTab:CreateToggle({
    Title = "Reach",
    Default = false,
    Callback = function(Value)
        pcall(function()
            reachActive = Value
            if reachConn then reachConn:Disconnect(); reachConn = nil end
            local char = LocalPlayer.Character
            if not char then return end
            if Value then
                for _, v in ipairs(char:GetDescendants()) do
                    if v:IsA("Tool") and v:FindFirstChild("Handle") then
                        if not reachSaved[v] then
                            reachSaved[v] = { Size = v.Handle.Size, GripPos = v.GripPos }
                        end
                        v.Handle.Size = Vector3.new(0.5, 0.5, reachValue)
                        v.GripPos = Vector3.new(0, 0, 0)
                    end
                end
                reachConn = char.ChildAdded:Connect(function(child)
                    if reachActive and child:IsA("Tool") and child:FindFirstChild("Handle") then
                        if not reachSaved[child] then
                            reachSaved[child] = { Size = child.Handle.Size, GripPos = child.GripPos }
                        end
                        child.Handle.Size = Vector3.new(0.5, 0.5, reachValue)
                        child.GripPos = Vector3.new(0, 0, 0)
                    end
                end)
            else
                for tool, data in pairs(reachSaved) do
                    if tool and tool.Parent then
                        pcall(function()
                            if tool:FindFirstChild("Handle") then tool.Handle.Size = data.Size end
                            tool.GripPos = data.GripPos
                        end)
                    end
                end
                reachSaved = {}
            end
        end)
    end,
})

local gripActive = false
local gripX, gripY, gripZ = 0, 0, 0
local gripSaved = {}
local gripConn = nil

local function ApplyGripAll()
    local char = LocalPlayer.Character
    if not char then return end
    for _, t in ipairs(char:GetDescendants()) do
        if t:IsA("Tool") then t.GripPos = Vector3.new(gripX, gripY, gripZ) end
    end
end

SwordTab:CreateSlider({
    Title = "Grip X", Min = -10, Max = 10, Default = 0,
    Callback = function(v) gripX = v; if gripActive then ApplyGripAll() end end,
})
SwordTab:CreateSlider({
    Title = "Grip Y", Min = -10, Max = 10, Default = 0,
    Callback = function(v) gripY = v; if gripActive then ApplyGripAll() end end,
})
SwordTab:CreateSlider({
    Title = "Grip Z", Min = -10, Max = 10, Default = 0,
    Callback = function(v) gripZ = v; if gripActive then ApplyGripAll() end end,
})

SwordTab:CreateToggle({
    Title = "GripPos",
    Default = false,
    Callback = function(Value)
        pcall(function()
            gripActive = Value
            if gripConn then gripConn:Disconnect(); gripConn = nil end
            local char = LocalPlayer.Character
            if not char then return end
            if Value then
                for _, t in ipairs(char:GetDescendants()) do
                    if t:IsA("Tool") then
                        if not gripSaved[t] then gripSaved[t] = t.GripPos end
                        t.GripPos = Vector3.new(gripX, gripY, gripZ)
                    end
                end
                gripConn = char.ChildAdded:Connect(function(child)
                    if gripActive and child:IsA("Tool") then
                        if not gripSaved[child] then gripSaved[child] = child.GripPos end
                        child.GripPos = Vector3.new(gripX, gripY, gripZ)
                    end
                end)
            else
                for tool, orig in pairs(gripSaved) do
                    if tool and tool.Parent then
                        pcall(function() tool.GripPos = orig end)
                    end
                end
                gripSaved = {}
            end
        end)
    end,
})

local useToolsActive = false
local useToolsAmount = 1
local useToolsDelay = 0
local useToolsThread = nil

SwordTab:CreateSlider({
    Title = "UseTools Amount", Min = 1, Max = 50, Default = 1,
    Callback = function(v) useToolsAmount = v end,
})
SwordTab:CreateSlider({
    Title = "UseTools Delay", Min = 0, Max = 10, Default = 0,
    Callback = function(v) useToolsDelay = v end,
})

SwordTab:CreateToggle({
    Title = "UseTools",
    Default = false,
    Callback = function(Value)
        pcall(function()
            useToolsActive = Value
            if useToolsThread then task.cancel(useToolsThread); useToolsThread = nil end
            if not Value then return end
            useToolsThread = task.spawn(function()
                while useToolsActive do
                    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
                    local char = LocalPlayer.Character
                    if bp and char then
                        for _, v in ipairs(bp:GetChildren()) do
                            if v:IsA("Tool") and useToolsActive then
                                v.Parent = char
                                for _ = 1, useToolsAmount do
                                    if not useToolsActive then break end
                                    pcall(function() v:Activate() end)
                                    if useToolsDelay > 0 then task.wait(useToolsDelay) end
                                end
                                if v and v.Parent == char then v.Parent = bp end
                            end
                        end
                    end
                    task.wait(0.1)
                end
            end)
        end)
    end,
})

SwordTab:CreateButton({
    Title = "CopyTools",
    Callback = function()
        pcall(function()
            local found = GetPlayerByName(SwordTarget)
            if not found then return end
            local bp = found:FindFirstChildOfClass("Backpack")
            local myBp = LocalPlayer:FindFirstChildOfClass("Backpack")
            if bp and myBp then
                for _, v in ipairs(bp:GetChildren()) do
                    if v:IsA("Tool") then pcall(function() v:Clone().Parent = myBp end) end
                end
            end
        end)
    end,
})

local viewToolActive = false
local viewToolData = {}

local function DestroyToolView(plr)
    local d = viewToolData[plr]
    if not d then return end
    for _, c in ipairs(d.conns) do pcall(function() c:Disconnect() end) end
    if d.billboard then pcall(function() d.billboard:Destroy() end) end
    viewToolData[plr] = nil
end

local function DestroyAllToolViews()
    local list = {}
    for plr in pairs(viewToolData) do table.insert(list, plr) end
    for _, plr in ipairs(list) do DestroyToolView(plr) end
end

local function RebuildToolRow(plr)
    local d = viewToolData[plr]
    if not d or not d.row or not d.row.Parent then return end
    local row = d.row
    for _, child in ipairs(row:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    local tools = GetPlayerTools(plr)
    if #tools == 0 then
        row.Visible = false
        return
    end
    row.Visible = true
    for i, tool in ipairs(tools) do
        local item = Instance.new("Frame")
        item.Name = "Tool_" .. i
        item.BackgroundColor3 = Color3.fromRGB(20, 22, 28)
        item.BackgroundTransparency = 0.15
        item.BorderSizePixel = 0
        item.LayoutOrder = i
        item.AutomaticSize = Enum.AutomaticSize.XY
        item.Parent = row

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = item

        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(96, 176, 255)
        stroke.Thickness = 1
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        stroke.Parent = item

        local pad = Instance.new("UIPadding")
        pad.PaddingTop = UDim.new(0, 4)
        pad.PaddingBottom = UDim.new(0, 4)
        pad.PaddingLeft = UDim.new(0, 5)
        pad.PaddingRight = UDim.new(0, 5)
        pad.Parent = item

        local vlist = Instance.new("UIListLayout")
        vlist.FillDirection = Enum.FillDirection.Vertical
        vlist.SortOrder = Enum.SortOrder.LayoutOrder
        vlist.HorizontalAlignment = Enum.HorizontalAlignment.Center
        vlist.Padding = UDim.new(0, 2)
        vlist.Parent = item

        local nameLabel = Instance.new("TextLabel")
        nameLabel.LayoutOrder = 1
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = tool.Name
        nameLabel.TextColor3 = Color3.fromRGB(240, 245, 255)
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextSize = 11
        nameLabel.AutomaticSize = Enum.AutomaticSize.X
        nameLabel.Size = UDim2.new(0, 0, 0, 13)
        nameLabel.TextXAlignment = Enum.TextXAlignment.Center
        nameLabel.Parent = item

        local iconFrame = Instance.new("Frame")
        iconFrame.LayoutOrder = 2
        iconFrame.BackgroundColor3 = Color3.fromRGB(10, 12, 16)
        iconFrame.BorderSizePixel = 0
        iconFrame.Size = UDim2.new(0, 22, 0, 22)
        iconFrame.Parent = item

        local iconCorner = Instance.new("UICorner")
        iconCorner.CornerRadius = UDim.new(0, 4)
        iconCorner.Parent = iconFrame

        local tex = GetToolTexture(tool)
        if tex then
            local img = Instance.new("ImageLabel")
            img.BackgroundTransparency = 1
            img.Size = UDim2.new(1, -4, 1, -4)
            img.Position = UDim2.new(0, 2, 0, 2)
            img.Image = tex
            img.ScaleType = Enum.ScaleType.Fit
            img.Parent = iconFrame
        else
            local fb = Instance.new("TextLabel")
            fb.BackgroundTransparency = 1
            fb.Size = UDim2.new(1, 0, 1, 0)
            fb.Text = string.sub(tool.Name, 1, 1):upper()
            fb.TextColor3 = Color3.fromRGB(96, 176, 255)
            fb.Font = Enum.Font.GothamBold
            fb.TextSize = 12
            fb.Parent = iconFrame
        end
    end
end

local function BuildToolView(plr)
    if plr == LocalPlayer then return end
    local char = plr.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end
    local existing = viewToolData[plr]
    if existing and existing.head == head and existing.billboard and existing.billboard.Parent then
        return
    end
    DestroyToolView(plr)

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "SwatToolView_" .. plr.Name
    billboard.Adornee = head
    billboard.AlwaysOnTop = true
    billboard.StudsOffset = Vector3.new(0, 3.2, 0)
    billboard.MaxDistance = 500
    billboard.Size = UDim2.new(0, 0, 0, 0)
    billboard.AutomaticSize = Enum.AutomaticSize.XY
    billboard.Parent = head

    local row = Instance.new("Frame")
    row.BackgroundTransparency = 1
    row.BorderSizePixel = 0
    row.Size = UDim2.new(0, 0, 0, 0)
    row.AutomaticSize = Enum.AutomaticSize.XY
    row.Parent = billboard

    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Horizontal
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.VerticalAlignment = Enum.VerticalAlignment.Center
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 4)
    layout.Parent = row

    local conns = {}

    table.insert(conns, char.ChildAdded:Connect(function(c)
        if c:IsA("Tool") then task.defer(function() RebuildToolRow(plr) end) end
    end))
    table.insert(conns, char.ChildRemoved:Connect(function(c)
        if c:IsA("Tool") then task.defer(function() RebuildToolRow(plr) end) end
    end))

    local bp = plr:FindFirstChild("Backpack")
    if bp then
        table.insert(conns, bp.ChildAdded:Connect(function(c)
            if c:IsA("Tool") then task.defer(function() RebuildToolRow(plr) end) end
        end))
        table.insert(conns, bp.ChildRemoved:Connect(function(c)
            if c:IsA("Tool") then task.defer(function() RebuildToolRow(plr) end) end
        end))
    end

    table.insert(conns, plr.ChildAdded:Connect(function(c)
        if c.Name == "Backpack" then
            task.defer(function()
                local newBP = plr:FindFirstChild("Backpack")
                if newBP then
                    table.insert(conns, newBP.ChildAdded:Connect(function(t)
                        if t:IsA("Tool") then task.defer(function() RebuildToolRow(plr) end) end
                    end))
                    table.insert(conns, newBP.ChildRemoved:Connect(function(t)
                        if t:IsA("Tool") then task.defer(function() RebuildToolRow(plr) end) end
                    end))
                    RebuildToolRow(plr)
                end
            end)
        end
    end))

    viewToolData[plr] = {
        billboard = billboard,
        row = row,
        head = head,
        conns = conns,
    }

    RebuildToolRow(plr)
end

SwordTab:CreateToggle({
    Title = "Tool View",
    Default = false,
