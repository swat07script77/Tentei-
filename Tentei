        pcall(function()
            viewToolActive = Value
            if Value then
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer then BuildToolView(plr) end
                end
            end
        end)
    end,
})

SwordTab:CreateButton({
