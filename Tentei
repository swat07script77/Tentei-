-- Garante os serviços de forma estrita e segura
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Garante que a UI e a Aba foram inicializadas antes de prosseguir
local Window = Window or getgenv().Window
local SwordTab = Window and Window.CreateTab and Window:CreateTab("Sword", "swords") or nil

if not SwordTab then
    warn("[SwatUI] Erro: A variável Window ou CreateTab não foi encontrada. Certifique-se de carregar a UI principal primeiro.")
    return
end

local function GetPlayerByName(name)
    if not name or name == "" then return nil end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name == name then return plr end
    end
    return nil
end

local function GetActiveTool()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Tool")
end

local function AttackPlayer(targetPlayer, tool)
    if not firetouchinterest then return end
    local handle = tool and tool:FindFirstChild("Handle")
    if not handle then return end
    if not targetPlayer.Character then return end
    local hum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
    local root = hum and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root or not hum or hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then return end
    pcall(function()
        firetouchinterest(handle, root, 1)
        firetouchinterest(handle, root, 0)
    end)
end

local SwordTarget = nil
local SwordTargetConn = nil

local function RefreshSwordTargetList()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then table.insert(list, plr.Name) end
    end
    if #list == 0 then table.insert(list, "Nenhum") end
    table.sort(list)
    pcall(function()
        if SwordTargetConn then
            if typeof(SwordTargetConn.Refresh) == "function" then
                SwordTargetConn:Refresh(list)
            elseif typeof(SwordTargetConn.SetValues) == "function" then
                SwordTargetConn:SetValues(list)
            elseif typeof(SwordTargetConn.Set) == "function" then
                SwordTargetConn:Set(list)
            end
        end
    end)
end

SwordTargetConn = SwordTab:CreateDropdown({
    Title = "Select Target",
    Options = {"Carregando..."},
    Callback = function(Value) SwordTarget = Value end,
})
task.spawn(RefreshSwordTargetList)

SwordTab:CreateButton({
    Title = "Refresh Target List",
    Callback = function() RefreshSwordTargetList() end,
})

-- KILL AURA
local killAuraActive = false
local killAuraConn = nil

SwordTab:CreateToggle({
    Title = "Kill Aura",
    Default = false,
    Callback = function(Value)
        pcall(function()
            killAuraActive = Value
            if killAuraConn then killAuraConn:Disconnect(); killAuraConn = nil end
            if not Value then return end
            if not firetouchinterest then
                Window:Notify({ Title = "Kill Aura", Description = "Needs firetouchinterest", Duration = 3, Type = "error" })
                killAuraActive = false
                return
            end
            killAuraConn = RunService.Heartbeat:Connect(function()
                if not killAuraActive then return end
                local curTool = GetActiveTool()
                if not curTool or not curTool:FindFirstChild("Handle") then return end
                for _, target in ipairs(Players:GetPlayers()) do
                    if target ~= LocalPlayer and target.Character then
                        AttackPlayer(target, curTool)
                    end
                end
            end)
        end)
    end,
})

-- KILL TARGET
local killTargetActive = false
local killTargetConn = nil

SwordTab:CreateToggle({
    Title = "Kill Target",
    Default = false,
    Callback = function(Value)
        pcall(function()
            killTargetActive = Value
            if killTargetConn then killTargetConn:Disconnect(); killTargetConn = nil end
            if not Value then return end
            if not firetouchinterest then
                Window:Notify({ Title = "Kill Target", Description = "Needs firetouchinterest", Duration = 3, Type = "error" })
                killTargetActive = false
                return
            end
            local target = GetPlayerByName(SwordTarget)
            if not target then
                Window:Notify({ Title = "Kill Target", Description = "Select a target first", Duration = 3, Type = "warning" })
                killTargetActive = false
                return
            end
            killTargetConn = RunService.Heartbeat:Connect(function()
                if not killTargetActive then return end
                local curTool = GetActiveTool()
                if not curTool or not curTool:FindFirstChild("Handle") then return end
                local t = GetPlayerByName(SwordTarget)
                if not t or not t.Character then return end
                local tHum = t.Character:FindFirstChildOfClass("Humanoid")
                if not tHum or tHum.Health <= 0 then
                    killTargetActive = false
                    if killTargetConn then killTargetConn:Disconnect(); killTargetConn = nil end
                    return
                end
                AttackPlayer(t, curTool)
            end)
        end)
    end,
})

-- AUTO TOOL
local autoToolActive = false
local autoToolConn = nil

SwordTab:CreateToggle({
    Title = "Auto Tool",
    Default = false,
    Callback = function(Value)
        pcall(function()
            autoToolActive = Value
            if autoToolConn then autoToolConn:Disconnect(); autoToolConn = nil end
            if not Value then return end
            autoToolConn = RunService.Heartbeat:Connect(function()
                if not autoToolActive then return end
                local char = LocalPlayer.Character
                if not char then return end
                local backpack = LocalPlayer:FindFirstChild("Backpack")
                if not backpack then return end
                local tools = {}
                for _, t in ipairs(backpack:GetChildren()) do
                    if t:IsA("Tool") then table.insert(tools, t) end
                end
                if #tools == 0 then return end
                local currentTool = char:FindFirstChildOfClass("Tool")
                local nextIndex = 1
                if currentTool then
                    for i, t in ipairs(tools) do
                        if t == currentTool then
                            nextIndex = i + 1
                            if nextIndex > #tools then nextIndex = 1 end
                            break
                        end
                    end
                end
                local nextTool = tools[nextIndex]
                if nextTool and nextTool ~= currentTool then
                    pcall(function() char.Humanoid:EquipTool(nextTool) end)
                end
            end)
        end)
    end,
})

-- REACH
local reachActive = false
local reachValue = 60
local reachSaved = {}
local reachConn = nil

SwordTab:CreateSlider({
    Title = "Reach Value",
    Min = 1, Max = 1000, Default = 60,
    Callback = function(v) reachValue = v end,
})

SwordTab:CreateToggle({
    Title = "Reach",
    Default = false,
    Callback = function(Value)
        pcall(function()
            reachActive = Value
            if reachConn then reachConn:Disconnect(); reachConn = nil end
            local char = LocalPlayer.Character
            if not char then return end
            if Value then
                for _, v in ipairs(char:GetDescendants()) do
                    if v:IsA("Tool") and v:FindFirstChild("Handle") then
                        if not reachSaved[v] then
                            reachSaved[v] = { Size = v.Handle.Size, GripPos = v.GripPos }
                        end
                        v.Handle.Size = Vector3.new(0.5, 0.5, reachValue)
                        v.GripPos = Vector3.new(0, 0, 0)
                    end
                end
                reachConn = char.ChildAdded:Connect(function(child)
                    if reachActive and child:IsA("Tool") and child:FindFirstChild("Handle") then
                        if not reachSaved[child] then
                            reachSaved[child] = { Size = child.Handle.Size, GripPos = child.GripPos }
                        end
                        child.Handle.Size = Vector3.new(0.5, 0.5, reachValue)
                        child.GripPos = Vector3.new(0, 0, 0)
                    end
                end)
            else
                for tool, data in pairs(reachSaved) do
                    if tool and tool.Parent then
                        pcall(function()
                            if tool:FindFirstChild("Handle") then tool.Handle.Size = data.Size end
                            tool.GripPos = data.GripPos
                        end)
                    end
                end
                reachSaved = {}
            end
        end)
    end,
})

-- GRIP CONTROLS
local gripActive = false
local gripX, gripY, gripZ = 0, 0, 0
local gripSaved = {}
local gripConn = nil

SwordTab:CreateSlider({ Title = "Grip X", Min = -10, Max = 10, Default = 0, Callback = function(v) gripX = v end })
SwordTab:CreateSlider({ Title = "Grip Y", Min = -10, Max = 10, Default = 0, Callback = function(v) gripY = v end })
SwordTab:CreateSlider({ Title = "Grip Z", Min = -10, Max = 10, Default = 0, Callback = function(v) gripZ = v end })

SwordTab:CreateToggle({
    Title = "GripPos",
    Default = false,
    Callback = function(Value)
        pcall(function()
            gripActive = Value
            if gripConn then gripConn:Disconnect(); gripConn = nil end
            local char = LocalPlayer.Character
            if not char then return end
            if Value then
                for _, t in ipairs(char:GetDescendants()) do
                    if t:IsA("Tool") then
                        if not gripSaved[t] then gripSaved[t] = t.GripPos end
                        t.GripPos = Vector3.new(gripX, gripY, gripZ)
                    end
                end
                gripConn = char.ChildAdded:Connect(function(child)
                    if gripActive and child:IsA("Tool") then
                        if not gripSaved[child] then gripSaved[child] = child.GripPos end
                        child.GripPos = Vector3.new(gripX, gripY, gripZ)
                    end
                end)
            else
                for tool, orig in pairs(gripSaved) do
                    if tool and tool.Parent then
                        pcall(function() tool.GripPos = orig end)
                    end
                end
                gripSaved = {}
            end
        end)
    end,
})

-- AUTO VIEW TOOLS (3D Menu na cabeça de cada jogador)
local autoViewActive = false
local autoViewConns = {}

local function CreateToolBillboard(player)
    if player == LocalPlayer then return end
    if autoViewConns[player] then return end

    local billboardGui = Instance.new("BillboardGui")
    billboardGui.Name = "SwatToolView"
    billboardGui.Size = UDim2.new(0, 120, 0, 45)
    billboardGui.StudsOffset = Vector3.new(0, 2.5, 0)
    billboardGui.AlwaysOnTop = true

    local frame = Instance.new("Frame", billboardGui)
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
    frame.BackgroundTransparency = 0.2
    
    local uiCorner = Instance.new("UICorner", frame)
    uiCorner.CornerRadius = UDim.new(0, 6)

    local uiStroke = Instance.new("UIStroke", frame)
    uiStroke.Color = Color3.fromRGB(40, 40, 40)
    uiStroke.Thickness = 1

    local imgLabel = Instance.new("ImageLabel", frame)
    imgLabel.Name = "ToolImage"
    imgLabel.Size = UDim2.new(0, 32, 0, 32)
    imgLabel.Position = UDim2.new(0, 6, 0.5, -16)
    imgLabel.BackgroundTransparency = 1
    imgLabel.Image = ""

    local nameLabel = Instance.new("TextLabel", frame)
    nameLabel.Name = "ToolName"
    nameLabel.Size = UDim2.new(1, -44, 1, 0)
    nameLabel.Position = UDim2.new(0, 42, 0, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextSize = 11
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.TextWrapped = true
    nameLabel.Text = "None"

    local conn = RunService.Heartbeat:Connect(function()
        if not autoViewActive or not player.Character then
            billboardGui.Enabled = false
            return
        end
        local head = player.Character:FindFirstChild("Head")
        if not head then
            billboardGui.Enabled = false
            return
        end
        billboardGui.Parent = head
        billboardGui.Enabled = true

        local tool = player.Character:FindFirstChildOfClass("Tool")
        if tool then
            nameLabel.Text = tool.Name
            if tool.TextureId and tool.TextureId ~= "" then
                imgLabel.Image = tool.TextureId
            else
                imgLabel.Image = "rbxassetid://6023426915"
            end
        else
            nameLabel.Text = "Nenhuma"
            imgLabel.Image = ""
        end
    end)

    autoViewConns[player] = { Gui = billboardGui, Conn = conn }
end

local function RemoveToolBillboard(player)
    if autoViewConns[player] then
        if autoViewConns[player].Conn then autoViewConns[player].Conn:Disconnect() end
        if autoViewConns[player].Gui then autoViewConns[player].Gui:Destroy() end
        autoViewConns[player] = nil
    end
end

SwordTab:CreateToggle({
    Title = "Auto View Tools (3D)",
    Default = false,
    Callback = function(Value)
        autoViewActive = Value
        if Value then
            for _, plr in ipairs(Players:GetPlayers()) do
                CreateToolBillboard(plr)
            }
            Players.PlayerAdded:Connect(CreateToolBillboard)
            Players.PlayerRemoving:Connect(RemoveToolBillboard)
        else
            for _, plr in ipairs(Players:GetPlayers()) do
                RemoveToolBillboard(plr)
            end
        end
    end,
})

-- FERRAMENTAS EXTRAS
SwordTab:CreateButton({
    Title = "Tool Grab",
    Callback = function()
        pcall(function()
            local found = GetPlayerByName(SwordTarget)
            if not found or not found.Character then return end
            local myBp = LocalPlayer:FindFirstChildOfClass("Backpack")
            if not myBp then return end
            for _, v in ipairs(found.Character:GetChildren()) do
                if v:IsA("Tool") then
                    pcall(function() v.Parent = myBp end)
                end
            end
        end)
    end,
})

SwordTab:CreateButton({
    Title = "CopyTools",
    Callback = function()
        pcall(function()
            local found = GetPlayerByName(SwordTarget)
            if not found then return end
            local bp = found:FindFirstChildOfClass("Backpack")
            local myBp = LocalPlayer:FindFirstChildOfClass("Backpack")
            if bp and myBp then
                for _, v in ipairs(bp:GetChildren()) do
                    if v:IsA("Tool") then pcall(function() v:Clone().Parent = myBp end) end
                end
            end
        end)
    end,
})
