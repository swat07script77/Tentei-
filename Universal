        local gr = Instance.new("UIGradient", fpsPingFrame)
        gr.Color = ColorSequence.new(Color3.fromRGB(30, 30, 45), Color3.fromRGB(15, 15, 25))
        fpsPingLabel = Instance.new("TextLabel", fpsPingFrame)
        fpsPingLabel.Size = UDim2.new(0.5, -10, 1, 0)
        fpsPingLabel.Position = UDim2.new(0, 5, 0, 0)
        fpsPingLabel.BackgroundTransparency = 1
        fpsPingLabel.Font = Enum.Font.GothamBold
        fpsPingLabel.Text = "FPS: 60"
        fpsPingLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
        fpsPingLabel.TextSize = 14
        fpsPingLabel.TextXAlignment = Enum.TextXAlignment.Left
        pingPingLabel = Instance.new("TextLabel", fpsPingFrame)
        pingPingLabel.Size = UDim2.new(0.5, -10, 1, 0)
        pingPingLabel.Position = UDim2.new(0.5, 5, 0, 0)
        pingPingLabel.BackgroundTransparency = 1
        pingPingLabel.Font = Enum.Font.GothamBold
        pingPingLabel.Text = "PING: 0"
        pingPingLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
        pingPingLabel.TextSize = 14
        pingPingLabel.TextXAlignment = Enum.TextXAlignment.Left
        fpsPingFrame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                fpsPingDragging = true
                fpsPingDragStart = input.Position
                fpsPingStartPos = fpsPingFrame.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then fpsPingDragging = false end
                end)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if fpsPingDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - fpsPingDragStart
                fpsPingFrame.Position = UDim2.new(
                    fpsPingStartPos.X.Scale, fpsPingStartPos.X.Offset + delta.X,
                    fpsPingStartPos.Y.Scale, fpsPingStartPos.Y.Offset + delta.Y
                )
            end
        end)
        fpsPingFrameCount = 0
        fpsPingTimeAccumulator = 0
        if fpsPingConn then fpsPingConn:Disconnect() end
        fpsPingConn = RunService.RenderStepped:Connect(function(dt)
