            if not target then
                Window:Notify({ Title = "Kill", Description = "Select a player.", Duration = 2, Type = "warning" })
                return
            end
            local c = LocalPlayer.Character
            if not c then return end
            local h = Hum(c)
            local r = Root(c)
            if not h or not r then return end
            local tChar = target.Character
            if not tChar then return end
            local tHead = getHead(tChar)
            local tHRP = Root(tChar)
            if not tHead or not tHRP then return end
            local originalCF = r.CFrame
