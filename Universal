pcall(function()
    local antiRingActive = false
    local antiRingConn = nil
    local noclipParts = {}

    local function setNoClipOnPart(part)
        if part:IsA("BasePart") and not noclipParts[part] then
            if not part.Anchored and part:FindFirstAncestorOfClass("Model") ~= LocalPlayer.Character then
                noclipParts[part] = true
                part.CanCollide = false
            end
        end
    end

    AntiTab:CreateToggle({
