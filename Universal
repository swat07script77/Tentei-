local killActive, killConnection, killOriginalCFrame, killTarget, killCooldown
killActive = false
killCooldown = false
local BOBBING_SPEED = 20
local UP_FORCE = Vector3.new(0, 9e9, 0)

local function stopKill()
    if killConnection then killConnection:Disconnect() end
    local char = player.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if root then
            if killOriginalCFrame then root.CFrame = killOriginalCFrame end
            root.Velocity = Vector3.zero
            root.RotVelocity = Vector3.zero
            detach(root)
        end
        if hum then hum.PlatformStand = false end
    end
    killActive = false
    killConnection = nil
    killTarget = nil
end

local function startKill(targetPlayer)
    if killActive then return end
    if killCooldown then return end
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    local targetChar = targetPlayer.Character
    if not targetChar then return end
    local targetHead = targetChar:FindFirstChild("Head")
    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetHead or not targetHRP then return end
    killActive = true
    killTarget = targetPlayer
    killOriginalCFrame = root.CFrame
    hum.PlatformStand = true
    root.Velocity = Vector3.zero
    root.RotVelocity = Vector3.zero
    local startTime = tick()
    killConnection = RunService.Heartbeat:Connect(function()
        if not killActive then return end
        if tick() - startTime >= 3 or not killTarget.Character then
            stopKill()
            return
        end
        local curTarget = killTarget.Character
        if not curTarget then return end
        local curHead = curTarget:FindFirstChild("Head")
        local curHRP = curTarget:FindFirstChild("HumanoidRootPart")
        if not curHead or not curHRP then return end
        local headPos = curHead.Position
        local bellyPos = curHRP.Position
        local cycle = (tick() * BOBBING_SPEED) % 1
        local y = headPos.Y + (bellyPos.Y - headPos.Y) * (0.5 - 0.5 * math.cos(cycle * 2 * math.pi))
        root.CFrame = CFrame.new(headPos.X, y, headPos.Z)
        root.Velocity = Vector3.zero
        root.RotVelocity = Vector3.zero
        curHRP.Velocity = UP_FORCE
        curHRP.RotVelocity = Vector3.zero
        attach(root, curHRP)
    end)
    killCooldown = true
    task.delay(3, function() killCooldown = false end)
end

