                for _, bv in pairs(glitterLoopBvTable) do pcall(function() bv:Destroy() end) end
                glitterLoopBvTable = {}
                local char = LocalPlayer.Character
                if char then
                    local root = char:FindFirstChild("HumanoidRootPart")
                    local hum  = char:FindFirstChildOfClass("Humanoid")
                    if root and glitterLoopOriginalCF then
                        root.CFrame = glitterLoopOriginalCF
                        root.Velocity = Vector3.zero
                        root.RotVelocity = Vector3.zero
                        detach(root)
                    end
                    if hum then hum.PlatformStand = false; hum.Sit = false end
                end
                glitterLoopOriginalCF = nil
                return
            end

            local char = LocalPlayer.Character
            if not char then glitterLoopActive = false; return end
            local myRoot = char:FindFirstChild("HumanoidRootPart")
            local myHum  = char:FindFirstChildOfClass("Humanoid")
            if not myRoot or not myHum then glitterLoopActive = false; return end

            myHum.PlatformStand = true
            glitterLoopOriginalCF = myRoot.CFrame
            local targetIndex = 1
            local lastSwitch = tick()

            glitterLoopConn = RunService.Heartbeat:Connect(function()
                if not glitterLoopActive then return end
                local curChar = LocalPlayer.Character
                if not curChar then return end
                local curRoot = curChar:FindFirstChild("HumanoidRootPart")
                if not curRoot then return end

                local targets = {}
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        table.insert(targets, p)
                    end
                end
                if #targets == 0 then return end

                if tick() - lastSwitch >= 0.2 then
                    targetIndex = targetIndex % #targets + 1
                    lastSwitch = tick()
                end

                local target = targets[targetIndex]
                if not target then return end
                local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
                if not targetRoot then return end

                if not glitterLoopBvTable[targetRoot] then
                    local bv = Instance.new("BodyVelocity")
                    bv.Name = "EpixVel"
                    bv.Velocity = Vector3.new(9e8, 9e8, 9e8)
                    bv.MaxForce = Vector3.new(1/0, 1/0, 1/0)
                    bv.Parent = targetRoot
                    glitterLoopBvTable[targetRoot] = bv
                end

                local timeNow = tick()
                local cyclePos = (timeNow * 2.5) % 2
                local currentY
                if cyclePos < 1 then
                    currentY = -3 + (3.5 * cyclePos)
                else
                    currentY = 0.5 - (3.5 * (cyclePos - 1))
                end

                curRoot.CFrame = CFrame.new(targetRoot.Position + Vector3.new(0, currentY, 0)) * CFrame.Angles(math.rad(90), 0, 0)
                curRoot.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
                curRoot.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
                attach(curRoot, targetRoot)
            end)
        end,
    })
end)
