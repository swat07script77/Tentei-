                    way = way + vel * dt
                    if not hrp:IsGrounded() then
                        hrp.CFrame = CFrame.new(pos + lv * way, toP) * bringOffRot
                        hrp.Velocity = lv * (vel + 1)
                        hrp.RotVelocity = v3_0
                    end
                    attach(hrp, hrp1)
