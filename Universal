            if Value then
                if antiBangDetectionConn then antiBangDetectionConn:Disconnect() end
                antiBangDetectionConn = RunService.Heartbeat:Connect(function()
                    if not antiBangToggleActive or antiBangInProgress then return end
                    if getBangPlayerWithinRange() then doAntiBangTeleport() end
                end)
            else
                if antiBangDetectionConn then antiBangDetectionConn:Disconnect(); antiBangDetectionConn = nil end
            end
        end,
    })

    AntiTab:CreateButton({
        Title = "Bang Escape",
        Callback = function()
            if antiBangInProgress then return end
