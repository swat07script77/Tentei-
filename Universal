                    sethiddenproperty(LocalPlayer, "MaxSimulationRadius", 112412400000)
                end)
                for _, d in ipairs(workspace:GetDescendants()) do
                    if d.ClassName == "Humanoid" and d.Parent then
                        if not Players:GetPlayerFromCharacter(d.Parent) then
                            pcall(function()
                                d.WalkSpeed = 0
                                d.JumpPower = 0
                                d.JumpHeight = 0
                                d.PlatformStand = true
                            end)
                            local root = d.Parent:FindFirstChild("HumanoidRootPart")
                            if root then pcall(function() root.Anchored = true end) end
                        end
                    end
                end
            end
        end)
    end,
})
