local function SaveViewTool(tool)
    if not viewToolSaved[tool] then
        viewToolSaved[tool] = { Size = tool.Size, Transparency = tool.Transparency }
    end
end

local function RestoreViewTool(tool)
    local data = viewToolSaved[tool]
    if data and tool.Parent then
        pcall(function()
            tool.Size = data.Size
            tool.Transparency = data.Transparency
        end)
    end
    viewToolSaved[tool] = nil
end

