local flingActive, flingConnection, flingOriginalCFrame, flingBV, flingCooldown
flingActive = false
flingCooldown = false

local function stopFling()
    if flingConnection then flingConnection:Disconnect() end
    if flingBV then flingBV:Destroy() end
    local char = player.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if root then
            if flingOriginalCFrame then root.CFrame = flingOriginalCFrame end
            root.Velocity = Vector3.zero
            root.RotVelocity = Vector3.zero
            detach(root)
        end
        if hum then hum.PlatformStand = false end
    end
    flingActive = false
    flingConnection = nil
    flingBV = nil
    flingOriginalCFrame = nil
end

local function startFling(targetPlayer)
    if flingActive then return end
    if flingCooldown then return end
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    local targetChar = targetPlayer.Character
    if not targetChar then return end
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end
    flingActive = true
    flingOriginalCFrame = root.CFrame
    hum.PlatformStand = true
    root.Velocity = Vector3.zero
    root.RotVelocity = Vector3.zero
    if flingBV then flingBV:Destroy() end
    flingBV = Instance.new("BodyVelocity")
    flingBV.Velocity = Vector3.new(9e8, 9e8, 9e8)
    flingBV.MaxForce = Vector3.new(1/0, 1/0, 1/0)
    flingBV.Parent = targetRoot
    local orbitPositions = {
        CFrame.new(0, 1.5, 0), CFrame.new(0, -1.5, 0),
        CFrame.new(2.25, 1.5, -2.25), CFrame.new(-2.25, -1.5, 2.25),
        CFrame.new(0, 1.5, 0), CFrame.new(0, -1.5, 0)
    }
    local orbitIndex, orbitAngle = 1, 0
    local startTime = tick()
    flingConnection = RunService.Heartbeat:Connect(function(dt)
        if not flingActive then return end
        if tick() - startTime >= 3 or not targetPlayer.Character then stopFling() return end
        local curTarget = targetPlayer.Character
        local curTargetRoot = curTarget and curTarget:FindFirstChild("HumanoidRootPart")
        if not curTargetRoot then return end
        orbitIndex = orbitIndex % #orbitPositions + 1
        orbitAngle = orbitAngle + 100 * dt
        local offset = orbitPositions[orbitIndex]
        local rotOffset = offset * CFrame.Angles(math.rad(orbitAngle), 0, 0)
        if root and root.Parent then
            root.CFrame = CFrame.new(curTargetRoot.Position) * rotOffset
            root.Velocity = Vector3.new(9e7, 9e7*10, 9e7)
            root.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
            attach(root, curTargetRoot)
        end
    end)
    flingCooldown = true
    task.delay(3, function() flingCooldown = false end)
end

