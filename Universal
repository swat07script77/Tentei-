                    flyLastctrl = {f = flyCtrl.f, b = flyCtrl.b, l = flyCtrl.l, r = flyCtrl.r}
                elseif (flyCtrl.l + flyCtrl.r) == 0 and (flyCtrl.f + flyCtrl.b) == 0 and flySpeed ~= 0 then
                    flyBv.velocity = ((workspace.CurrentCamera.CoordinateFrame.lookVector * (flyLastctrl.f + flyLastctrl.b)) +
                        ((workspace.CurrentCamera.CoordinateFrame * CFrame.new(flyLastctrl.l + flyLastctrl.r, (flyLastctrl.f + flyLastctrl.b) * 0.2, 0).p) -
                        workspace.CurrentCamera.CoordinateFrame.p)) * flySpeed
                else
                    flyBv.velocity = Vector3.new(0, 0, 0)
                end
                flyBg.cframe = workspace.CurrentCamera.CoordinateFrame * CFrame.Angles(-math.rad((flyCtrl.f + flyCtrl.b) * 50 * flySpeed / flyMaxspeed), 0, 0)
            end)
            table.insert(flyConnections, flyConnection)
        end

        startFly()
        if Notify then Notify("Fly", "Ativado (Velocidade: " .. flySpeeds .. ")", 2) end

        local inputBegan = game:GetService("UserInputService").InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed or not flyNowe then return end
            if input.KeyCode == Enum.KeyCode.E then
                flyTis = game:GetService("RunService").Heartbeat:Connect(function()
                    if not flyNowe then if flyTis then flyTis:Disconnect(); flyTis = nil end return end
                    local char = player.Character
                    if char then
                        local root = char:FindFirstChild("HumanoidRootPart")
                        if root then root.CFrame = root.CFrame * CFrame.new(0, 1, 0) end
                    end
                end)
            elseif input.KeyCode == Enum.KeyCode.Q then
                flyDis = game:GetService("RunService").Heartbeat:Connect(function()
                    if not flyNowe then if flyDis then flyDis:Disconnect(); flyDis = nil end return end
                    local char = player.Character
                    if char then
                        local root = char:FindFirstChild("HumanoidRootPart")
                        if root then root.CFrame = root.CFrame * CFrame.new(0, -1, 0) end
                    end
                end)
            end
        end)
        local inputEnded = game:GetService("UserInputService").InputEnded:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if input.KeyCode == Enum.KeyCode.E then
                if flyTis then flyTis:Disconnect(); flyTis = nil end
            elseif input.KeyCode == Enum.KeyCode.Q then
                if flyDis then flyDis:Disconnect(); flyDis = nil end
            end
        end)
        table.insert(flyConnections, inputBegan)
        table.insert(flyConnections, inputEnded)
    end

