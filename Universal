                        local isInAir = currentState == Enum.HumanoidStateType.Freefall or currentState == Enum.HumanoidStateType.Jumping
                        if isInAir then
                            isJumping = true
                            lastGroundTime = tick()
                        elseif currentState == Enum.HumanoidStateType.Running or currentState == Enum.HumanoidStateType.Landed then
                            isJumping = false
                            lastGroundTime = tick()
                        end
