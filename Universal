-- FPS Cap (baseado no addcmd setfpscap)
-- ------------------------------------------------------------
local fpscaploop = nil
local FpsCapValue = 60
local FpsCapEnabled = false

local function ApplyFpsCap()
    if fpscaploop then
        task.cancel(fpscaploop)
        fpscaploop = nil
    end

    if not FpsCapEnabled then return end

    local fpsCap = FpsCapValue
    if not fpsCap or fpsCap <= 0 then return end

    if setfpscap and type(setfpscap) == "function" then
        pcall(setfpscap, fpsCap)
    else
        fpscaploop = task.spawn(function()
            local frameTime = 1 / fpsCap
            while FpsCapEnabled do
                local start = os.clock()
                task.wait(frameTime)
                local elapsed = os.clock() - start
                if elapsed < frameTime then
                    task.wait(frameTime - elapsed)
                end
            end
        end)
    end
end

CfgTab:CreateLabel("FPS Cap")
CfgTab:CreateLabel("Warning: low values may cause lag / freezing.")

CfgTab:CreateSlider({
    Title = "Set FPS Cap",
    Min = 1,
    Max = 240,
    Default = 60,
    Callback = function(Value)
        FpsCapValue = Value
        if FpsCapEnabled then ApplyFpsCap() end
    end,
})

CfgTab:CreateToggle({
    Title = "Enable FPS Cap",
    Default = false,
    Callback = function(Value)
        FpsCapEnabled = Value
        if Value then
            ApplyFpsCap()
        else
            if fpscaploop then
                task.cancel(fpscaploop)
                fpscaploop = nil
            end
            if setfpscap and type(setfpscap) == "function" then
                pcall(setfpscap, 240)
            end
        end
    end,
})
