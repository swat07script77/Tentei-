                local obj = getAnimObj(path)
                if obj and obj:IsA("Animation") and obj.AnimationId ~= "" then
                    table.insert(animIds, name .. ": " .. obj.AnimationId)
                end
            end
            if #animIds == 0 then return end
            setclipboard(table.concat(animIds, "\n"))
