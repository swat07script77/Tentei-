local MainSwordsTab = Window:CreateTab("Main Swords", "swords")

local function Root(M) return M and M:FindFirstChild("HumanoidRootPart") end
local function Hum(M) return M and M:FindFirstChildOfClass("Humanoid") end

local SwordsTarget = nil
local SwordsDropdown = nil

local function GetSwordsTarget()
    if not SwordsTarget or SwordsTarget == "" then return nil end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name == SwordsTarget then return plr end
    end
    return nil
end

local function RefreshSwords()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then table.insert(list, plr.Name) end
    end
    table.sort(list)
    if SwordsDropdown and SwordsDropdown.Update then
        pcall(function() SwordsDropdown:Update({ Options = list }) end)
    end
end

SwordsDropdown = MainSwordsTab:CreateDropdown({
    Title = "Select Target",
    Options = {},
    Callback = function(Value) SwordsTarget = Value end,
})
RefreshSwords()

MainSwordsTab:CreateButton({
    Title = "Refresh Target List",
    Callback = function() RefreshSwords() end,
})

local function Mvmentbtn(Name, Offset, IsFling)
    local Conn, SavedCF
    MainSwordsTab:CreateToggle({
        Title = Name, Default = false,
        Callback = function(State)
            if Conn then Conn:Disconnect(); Conn = nil end
            local LRoot = Root(LocalPlayer.Character)
            if not State then
                if LRoot and SavedCF then
                    LRoot.CFrame = SavedCF
                    LRoot.Velocity = Vector3.zero
                    LRoot.RotVelocity = Vector3.zero
                    SavedCF = nil
                end
                return
            end
            if LRoot then SavedCF = LRoot.CFrame end
            Conn = RunService.Heartbeat:Connect(function()
                local lr = Root(LocalPlayer.Character)
                local t = GetSwordsTarget()
                local tr = t and Root(t.Character)
                if not (lr and tr) then return end
                lr.CFrame = CFrame.new(tr.Position + Offset) * CFrame.Angles(-math.pi/2, 0, 0)
                local vel = IsFling and Vector3.new(500, 500, 500) or Vector3.zero
                lr.Velocity = vel
                lr.RotVelocity = vel
            end)
        end,
    })
end

Mvmentbtn("Fling Player", Vector3.new(0, 0, 0), true)
Mvmentbtn("Fling 2.0", Vector3.new(0, -2.5, 0), true)
Mvmentbtn("Platform Fly", Vector3.new(0, -2.8, 0), false)
Mvmentbtn("Magic Carpet", Vector3.new(0, -3.1, 0), false)
Mvmentbtn("Elevator", Vector3.new(0, -2.6, 0), false)
Mvmentbtn("Anti Jump", Vector3.new(0, 3.5, 0), false)

local function Bind(Name, Offset)
    local Conn
    MainSwordsTab:CreateToggle({
        Title = Name, Default = false,
        Callback = function(State)
            if Conn then Conn:Disconnect(); Conn = nil end
            if not State then return end
            Conn = RunService.Heartbeat:Connect(function()
                local lr = Root(LocalPlayer.Character)
                local t = GetSwordsTarget()
                local tr = t and Root(t.Character)
                if lr and tr then
                    lr.CFrame = tr.CFrame * CFrame.new(Offset)
                    lr.Velocity = Vector3.zero
                end
            end)
        end,
    })
end

