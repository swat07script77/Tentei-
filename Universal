        fpsPingFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
        fpsPingFrame.BackgroundTransparency = 0.3
        fpsPingFrame.BorderSizePixel = 0
        fpsPingFrame.Size = UDim2.new(0, 180, 0, 40)
