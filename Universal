-- ============================================================
-- ANTI STUN
-- ============================================================
pcall(function()
    local antiStunActive = false
    local antiStunConn = nil
    local originalWalkSpeed = 16
    local originalJumpPower = 50
    local lastMoveTime = tick()
    local isJumping = false
    local lastGroundTime = tick()
    local STUN_STATES = {
        [Enum.HumanoidStateType.Physics] = true,
        [Enum.HumanoidStateType.Ragdoll] = true,
        [Enum.HumanoidStateType.FallingDown] = true,
        [Enum.HumanoidStateType.PlatformStanding] = true,
        [Enum.HumanoidStateType.StrafingNoPhysics] = true,
    }

    AntiTab:CreateToggle({
        Title = "Anti Stun",
        Default = false,
        Callback = function(state)
            antiStunActive = state
            if state then
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum then
                    originalWalkSpeed = hum.WalkSpeed
                    originalJumpPower = hum.JumpPower
                    hum.AutoRotate = true
                end
                antiStunConn = RunService.Heartbeat:Connect(function()
                    pcall(function()
                        if not antiStunActive then return end
                        local curChar = LocalPlayer.Character
                        local curHum = curChar and curChar:FindFirstChildOfClass("Humanoid")
                        if not curHum then return end
                        local curRoot = curChar:FindFirstChild("HumanoidRootPart")
                        if curHum.WalkSpeed < 1 then curHum.WalkSpeed = originalWalkSpeed end
                        if curHum.JumpPower < 1 then curHum.JumpPower = originalJumpPower end
                        if not curHum.AutoRotate then curHum.AutoRotate = true end
                        if curHum.PlatformStand and (not curRoot or not curRoot:FindFirstChild("StompBP")) then
                            curHum.PlatformStand = false
                        end
                        local currentState = curHum:GetState()
                        local isInAir = currentState == Enum.HumanoidStateType.Freefall or currentState == Enum.HumanoidStateType.Jumping
                        if isInAir then
                            isJumping = true
                            lastGroundTime = tick()
                        elseif currentState == Enum.HumanoidStateType.Running or currentState == Enum.HumanoidStateType.Landed then
                            isJumping = false
                            lastGroundTime = tick()
                        end
                        if not isInAir and STUN_STATES[currentState] and currentState ~= Enum.HumanoidStateType.Freefall then
                            pcall(function() curHum:ChangeState(Enum.HumanoidStateType.Running) end)
                        end
                        if curRoot then
                            for _, child in ipairs(curRoot:GetChildren()) do
                                if child:IsA("BodyPosition") or child:IsA("BodyVelocity")
                                or child:IsA("BodyGyro") or child:IsA("AlignPosition")
                                or child:IsA("AlignOrientation") or child:IsA("AngularVelocity")
                                or child:IsA("RocketPropulsion") or child:IsA("BallSocketConstraint")
                                or child:IsA("HingeConstraint") or child:IsA("SpringConstraint")
                                or child:IsA("RopeConstraint") or child:IsA("CylindricalConstraint")
                                or child:IsA("PrismaticConstraint") or child:IsA("UniversalConstraint") then
                                    if child.Name ~= "StompBP" and child.Name ~= "StompBV" then
                                        child:Destroy()
                                    end
                                end
                            end
                            pcall(function() curRoot:SetNetworkOwner(LocalPlayer) end)
                        end
                        for _, part in ipairs(curChar:GetDescendants()) do
                            if part:IsA("BasePart") then
                                local hasStomp = part:FindFirstChild("StompBP") or part:FindFirstChild("StompBV")
                                for _, child in ipairs(part:GetChildren()) do
                                    if child:IsA("Torque") and not hasStomp then child:Destroy() end
                                    if child:IsA("Attachment") then
                                        local other = child.Attachment0 or child.Attachment1
                                        if other and other:IsA("Attachment") then
                                            local otherPart = other.Parent
                                            if otherPart and otherPart:IsA("BasePart") and not otherPart:IsDescendantOf(curChar) then
                                                child:Destroy()
                                            end
                                        end
                                    end
                                end
                            end
                        end
                        if curRoot then
                            if curHum.MoveDirection.Magnitude > 0 then
                                lastMoveTime = tick()
                            elseif tick() - lastMoveTime > 1.5 and not isJumping and tick() - lastGroundTime > 1 then
                                pcall(function() curHum:ChangeState(Enum.HumanoidStateType.Running) end)
                                curRoot.Velocity = Vector3.zero
                                curRoot.RotVelocity = Vector3.zero
                                lastMoveTime = tick()
                            end
                        end
                        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                        if playerGui then
                            local badOverlays = {"StunOverlay", "StunGui", "FreezeOverlay", "FreezeGui",
                                                 "IceOverlay", "ParalyzeGui", "StunEffect", "StunScreen",
                                                 "FrozenGui", "FrozenEffect", "FreezeEffect", "IceEffect"}
                            for _, name in ipairs(badOverlays) do
                                local overlay = playerGui:FindFirstChild(name)
                                if overlay then overlay:Destroy() end
                            end
                        end
                        local camera = workspace.CurrentCamera
                        if camera and camera.CameraType ~= Enum.CameraType.Custom then
                            camera.CameraType = Enum.CameraType.Custom
                            camera.CameraSubject = curHum
                        end
                    end)
                end)
            else
                if antiStunConn then antiStunConn:Disconnect(); antiStunConn = nil end
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.WalkSpeed = originalWalkSpeed
                    hum.JumpPower = originalJumpPower
                end
            end
        end,
    })
end)

