MainTab:CreateButton({
    Title = "Goto",
    Callback = function()
        local t = GetMainTarget()
        if not t then return end
        local tr = Root(t.Character)
        local mr = Root(LocalPlayer.Character)
        if tr and mr then mr.CFrame = tr.CFrame * CFrame.new(2, 0, 0) end
    end,
})

MainTab:CreateButton({
    Title = "Kill All",
    Callback = function()
        local c = LocalPlayer.Character
        if not c then return end
        local h = Hum(c)
        local r = Root(c)
        if not h or not r then return end
        local orig = r.CFrame
        local origP = h.PlatformStand
        h.PlatformStand = true
        local UP = Vector3.new(0, 9e9, 0)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local hrp = Root(p.Character)
                if hrp then hrp.Velocity = UP; hrp.RotVelocity = Vector3.zero end
            end
        end
        task.delay(1.5, function()
            h.PlatformStand = origP
            r.CFrame = orig
            r.Velocity = Vector3.zero
            r.RotVelocity = Vector3.zero
        end)
    end,
})

MainTab:CreateToggle({
    Title = "Loop Kill",
    Default = false,
    Callback = function(Value)
        if not Value then return end
        local t = GetMainTarget()
        if not t then
            Window:Notify({ Title = "Loop Kill", Description = "Select a player.", Duration = 2, Type = "warning" })
            return
        end
        local c = LocalPlayer.Character
        if not c then return end
        local r = Root(c)
        local h = Hum(c)
        if not r or not h then return end
        local orig = r.CFrame
        local origP = h.PlatformStand
        h.PlatformStand = true
        local UP = Vector3.new(0, 9e9, 0)
        local running = true
        local conn
        conn = RunService.Heartbeat:Connect(function()
            if not running then return end
            local tt = GetMainTarget()
            if not tt or not tt.Character then return end
            local tr = Root(tt.Character)
            local head = tt.Character:FindFirstChild("Head")
            local cr = Root(LocalPlayer.Character)
            if not tr or not head or not cr then return end
            local cycle = (tick() * 20) % 1
            local y = head.Position.Y + (tr.Position.Y - head.Position.Y) * (0.5 - 0.5 * math.cos(cycle * 2 * math.pi))
            cr.CFrame = CFrame.new(head.Position.X, y, head.Position.Z)
            cr.Velocity = Vector3.zero
            cr.RotVelocity = Vector3.zero
            tr.Velocity = UP
            tr.RotVelocity = Vector3.zero
        end)
        -- Salva conn para desligar
        _G._LoopKillConn = conn
    end,
})

MainTab:CreateButton({
    Title = "Reset",
    Callback = function()
        local c = LocalPlayer.Character
        local h = c and Hum(c)
        if replicatesignal then pcall(function() replicatesignal(LocalPlayer.Kill) end) end
        if h then h:ChangeState(Enum.HumanoidStateType.Dead); h.Health = 0 end
    end,
})

