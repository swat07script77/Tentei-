        if antiJumpTarget and antiJumpTarget.Character then
            local targetHum = antiJumpTarget.Character:FindFirstChildOfClass("Humanoid")
            if targetHum and antiJumpOriginalJumpPower then
                targetHum.JumpPower = antiJumpOriginalJumpPower
                antiJumpOriginalJumpPower = nil
            end
        end
