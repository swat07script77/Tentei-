PlayTab:CreateButton({
    Title = "Fling Target",
    Callback = function()
        local t = GetPlayTarget()
        if not t then return end
        local tr = Root(t.Character)
        local mr = Root(LocalPlayer.Character)
        if not tr or not mr then return end
        local bv = Instance.new("BodyVelocity")
        bv.Velocity = Vector3.new(9e8, 9e8, 9e8)
        bv.MaxForce = Vector3.new(1/0, 1/0, 1/0)
        bv.Parent = tr
        task.delay(3, function() bv:Destroy() end)
    end,
})

PlayTab:CreateButton({
    Title = "Fling All",
    Callback = function()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local r = Root(p.Character)
                if r then
                    local bv = Instance.new("BodyVelocity")
                    bv.Velocity = Vector3.new(9e8, 9e8, 9e8)
                    bv.MaxForce = Vector3.new(1/0, 1/0, 1/0)
                    bv.Parent = r
                    task.delay(3, function() bv:Destroy() end)
                end
            end
        end
    end,
})

PlayTab:CreateToggle({
    Title = "Orbit",
    Default = false,
    Callback = function(Value)
        if not Value then return end
        local ang = 0
        local conn
        conn = RunService.Heartbeat:Connect(function()
            if not Value then conn:Disconnect(); return end
            local t = GetPlayTarget()
            if not t or not t.Character then return end
            local tr = Root(t.Character)
            local mr = Root(LocalPlayer.Character)
            if not tr or not mr then return end
            ang = ang + 0.1
            mr.CFrame = CFrame.new(tr.Position + Vector3.new(math.cos(ang)*5, 0, math.sin(ang)*5), tr.Position)
            mr.Velocity = Vector3.zero
            mr.RotVelocity = Vector3.zero
        end)
    end,
})

PlayTab:CreateToggle({
    Title = "View Target",
    Default = false,
    Callback = function(Value)
        if not Value then
            local mh = Hum(LocalPlayer.Character)
            if mh then workspace.CurrentCamera.CameraSubject = mh end
            return
        end
        local conn
        conn = RunService.Heartbeat:Connect(function()
            if not Value then conn:Disconnect(); return end
            local t = GetPlayTarget()
            if not t or not t.Character then return end
            local th = Hum(t.Character)
            if th then
                workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
                workspace.CurrentCamera.CameraSubject = th
            end
        end)
    end,
})

PlayTab:CreateButton({
    Title = "Copy Name",
    Callback = function()
        local t = GetPlayTarget()
        if not t then return end
        if setclipboard then setclipboard(t.Name) end
    end,
})

PlayTab:CreateButton({
    Title = "Copy User ID",
    Callback = function()
        local t = GetPlayTarget()
        if not t then return end
        if setclipboard then setclipboard(tostring(t.UserId)) end
    end,
})
