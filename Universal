        controlHum = char:FindFirstChild("Humanoid")
        if not controlRoot or not controlHum then return end
        controlTarget = targetPlayer
        controlSavedPos = controlRoot.CFrame
        controlActive = true
        controlMode = "Default"
        controlLastMode = "Default"
        controlCanAnchor = true
        controlReanchorId = 0
        local targetChar = targetPlayer.Character
        if targetChar then
            controlTargetRoot = targetChar:FindFirstChild("HumanoidRootPart")
            if targetChar:FindFirstChild("Humanoid") then
                workspace.CurrentCamera.CameraSubject = targetChar.Humanoid
            end
        end
        controlMobileGui = Instance.new("ScreenGui")
        controlMobileGui.Name = "ControlMobileButtons"
        controlMobileGui.ResetOnSpawn = false
        controlMobileGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        controlMobileGui.DisplayOrder = 2147483647
        controlMobileGui.Parent = player:WaitForChild("PlayerGui")
        createMobileButtons(controlMobileGui)
        if keyboardBeganConn then keyboardBeganConn:Disconnect() end
        if keyboardEndedConn then keyboardEndedConn:Disconnect() end
        keyboardBeganConn, keyboardEndedConn = setupKeyboardInput()
        controlConn = RunService.Heartbeat:Connect(function()
            if not controlActive or not controlTarget then
                if controlConn then controlConn:Disconnect() end
                return
            end
            if not controlRoot or not controlRoot.Parent or controlHum.Health <= 0 then
                detach(controlRoot)
                if controlConn then controlConn:Disconnect() end
                setHeadAnchored(false)
                return
            end
            local curTargetChar = controlTarget.Character
            if not curTargetChar then return end
            local curTargetRoot = curTargetChar:FindFirstChild("HumanoidRootPart")
            if not curTargetRoot then return end
            controlTargetRoot = curTargetRoot
            local currentPO = DefaultOffset
            local currentRO = CFrame.Angles(0, 0, 0)
            local mode = "Default"
            if controlMode == "W" then currentPO = Offset_W; mode = "W"
            elseif controlMode == "A" then currentPO = Offset_A; mode = "A"
            elseif controlMode == "S" then currentPO = Offset_S; mode = "S"
            elseif controlMode == "D" then currentPO = Offset_D; mode = "D"
            elseif controlMode == "Space" then currentPO = Offset_Space; currentRO = CFrame.Angles(math.rad(-90), 0, 0); mode = "Space" end
            if mode ~= controlLastMode then
                controlLastMode = mode
                beginOffsetSwitch()
            end
            controlRoot.CFrame = controlTargetRoot.CFrame * CFrame.new(currentPO) * currentRO
            controlRoot.Velocity = Vector3.zero
            controlRoot.RotVelocity = Vector3.zero
            attach(controlRoot, controlTargetRoot)
            if mode == "Space" then setHeadAnchored(false)
            elseif controlCanAnchor then setHeadAnchored(true)
            else setHeadAnchored(false) end
        end)
    end

