    })

    local auraActive = false
    local auraConn = nil
    local auraAttackConn = nil
    local auraAttacking = false
    local auraLastAttack = 0
    local AURA_DIST = 2
    local ATTACK_DURATION = 2
    local COOLDOWN = 1
    MainTab:CreateToggle({
        Title = "Kill Aura", Default = false,
        Callback = function(Value)
            auraActive = Value
            if auraConn then auraConn:Disconnect(); auraConn = nil end
            if auraAttackConn then auraAttackConn:Disconnect(); auraAttackConn = nil end
            auraAttacking = false
            if Value then
                auraConn = RunService.Heartbeat:Connect(function()
                    if not auraActive or auraAttacking then return end
                    if tick() - auraLastAttack < COOLDOWN then return end
                    local myRoot = Root(LocalPlayer.Character)
                    if not myRoot then return end
                    local closest, minDist = nil, AURA_DIST
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character then
                            local head = getHead(p.Character)
                            if head then
                                local d = (head.Position - myRoot.Position).Magnitude
                                if d < minDist then
                                    minDist = d
                                    closest = p
                                end
                            end
                        end
                    end
                    if closest then
                        local tc = closest.Character
                        local tHead = getHead(tc)
                        local tHRP = Root(tc)
                        if not tHead or not tHRP then return end
                        local myChar = LocalPlayer.Character
                        local myR = Root(myChar)
                        local myH = Hum(myChar)
                        if not myR or not myH then return end
                        local origCF = myR.CFrame
                        myH.PlatformStand = true
                        auraAttacking = true
                        local start = tick()
                        auraAttackConn = RunService.Heartbeat:Connect(function()
                            if tick() - start >= ATTACK_DURATION or not auraActive then
                                if auraAttackConn then auraAttackConn:Disconnect(); auraAttackConn = nil end
                                local ch = LocalPlayer.Character
                                if ch then
                                    local hh = Hum(ch)
                                    local rr = Root(ch)
                                    if hh then hh.PlatformStand = false end
                                    if rr then
                                        rr.CFrame = origCF
                                        rr.Velocity = Vector3.zero
                                        rr.RotVelocity = Vector3.zero
                                    end
                                end
                                auraAttacking = false
                                auraLastAttack = tick()
                                return
                            end
                            local c = LocalPlayer.Character
                            local tcc = closest.Character
                            if not c or not tcc then
                                if auraAttackConn then auraAttackConn:Disconnect(); auraAttackConn = nil end
                                auraAttacking = false
                                return
                            end
                            local cr = Root(c)
                            local ch = getHead(tcc)
                            local chr = Root(tcc)
                            if not cr or not ch or not chr then
                                if auraAttackConn then auraAttackConn:Disconnect(); auraAttackConn = nil end
                                auraAttacking = false
                                return
                            end
                            local headPos = ch.Position
                            local bellyPos = chr.Position
                            local cycle = (tick() * BOBBING_SPEED) % 1
                            local y = headPos.Y + (bellyPos.Y - headPos.Y) * (0.5 - 0.5 * math.cos(cycle * 2 * math.pi))
                            cr.CFrame = CFrame.new(headPos.X, y, headPos.Z)
                            cr.Velocity = Vector3.zero
                            cr.RotVelocity = Vector3.zero
                            chr.Velocity = UP_FORCE
                            chr.RotVelocity = Vector3.zero
                        end)
                    end
                end)
            end
        end,
    })

    local walkFlingEnabled = false
    local walkFlingThread = nil
    MainTab:CreateToggle({
        Title = "WalkFling", Default = false,
        Callback = function(State)
            walkFlingEnabled = State
            if State then
                local movel = 0.1
                if walkFlingThread then task.cancel(walkFlingThread) end
                walkFlingThread = task.spawn(function()
                    while walkFlingEnabled do
                        RunService.Heartbeat:Wait()
                        local char = LocalPlayer.Character
                        local root = char and Root(char)
                        while walkFlingEnabled and not (char and char.Parent and root and root.Parent) do
                            RunService.Heartbeat:Wait()
                            char = LocalPlayer.Character
                            root = char and Root(char)
                        end
                        if not walkFlingEnabled then break end
                        local vel = root.Velocity
                        root.Velocity = vel * 10000 + Vector3.new(0, 10000, 0)
                        RunService.RenderStepped:Wait()
                        if walkFlingEnabled and char.Parent and root.Parent then
                            root.Velocity = vel
                        end
                        RunService.Stepped:Wait()
                        if walkFlingEnabled and char.Parent and root.Parent then
                            root.Velocity = vel + Vector3.new(0, movel, 0)
                            movel = movel * -1
                        end
                    end
                end)
            else
                walkFlingEnabled = false
                if walkFlingThread then task.cancel(walkFlingThread); walkFlingThread = nil end
                local root = LocalPlayer.Character and Root(LocalPlayer.Character)
                if root then root.Velocity = Vector3.zero end
            end
        end,
    })

    local spawnLockEnabled = false
    local deathPosition = nil
    local spawnLockConn = nil
    MainTab:CreateToggle({
        Title = "Spawn Lock", Default = false,
        Callback = function(State)
            spawnLockEnabled = State
            if spawnLockConn then spawnLockConn:Disconnect(); spawnLockConn = nil end
