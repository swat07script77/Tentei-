local walksitOriginalAnims = {}
MainTab:CreateToggle({
    Title = "Walksit",
    Default = false,
    Callback = function(Value)
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildWhichIsA("Humanoid")
        if not char or not hum then return end
        local anims = char:FindFirstChild("Animate")
        if not anims then return end
        if Value then
            walksitOriginalAnims = {
                idle = anims.idle:FindFirstChildWhichIsA("Animation").AnimationId,
                walk = anims.walk:FindFirstChildWhichIsA("Animation").AnimationId,
                run = anims.run:FindFirstChildWhichIsA("Animation").AnimationId,
                jump = anims.jump:FindFirstChildWhichIsA("Animation").AnimationId,
            }
            local sitId = anims.sit:FindFirstChildWhichIsA("Animation").AnimationId
            anims.idle:FindFirstChildWhichIsA("Animation").AnimationId = sitId
            anims.walk:FindFirstChildWhichIsA("Animation").AnimationId = sitId
            anims.run:FindFirstChildWhichIsA("Animation").AnimationId = sitId
            anims.jump:FindFirstChildWhichIsA("Animation").AnimationId = sitId
            for _, track in pairs(hum:GetPlayingAnimationTracks()) do track:Stop() end
            hum.HipHeight = (hum.RigType == Enum.HumanoidRigType.R15) and 1.35 or -1.45
        else
            if anims.idle:FindFirstChildWhichIsA("Animation") then anims.idle:FindFirstChildWhichIsA("Animation").AnimationId = walksitOriginalAnims.idle end
            if anims.walk:FindFirstChildWhichIsA("Animation") then anims.walk:FindFirstChildWhichIsA("Animation").AnimationId = walksitOriginalAnims.walk end
            if anims.run:FindFirstChildWhichIsA("Animation") then anims.run:FindFirstChildWhichIsA("Animation").AnimationId = walksitOriginalAnims.run end
            if anims.jump:FindFirstChildWhichIsA("Animation") then anims.jump:FindFirstChildWhichIsA("Animation").AnimationId = walksitOriginalAnims.jump end
            hum.HipHeight = (hum.RigType == Enum.HumanoidRigType.R15) and 2 or 0
        end
    end,
})

MainTab:CreateButton({
    Title = "Re",
    Callback = function()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local savedPos = root.Position
        _G.savedPosition = savedPos
        local hum = char:FindFirstChildWhichIsA("Humanoid")
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Dead)
            hum.Health = 0
        else
            char:BreakJoints()
        end
        local conn
        conn = LocalPlayer.CharacterAdded:Connect(function(newChar)
            conn:Disconnect()
            if not _G.savedPosition then return end
            local newRoot = newChar:WaitForChild("HumanoidRootPart", 5)
            if newRoot then
                newRoot.CFrame = CFrame.new(_G.savedPosition)
            end
            _G.savedPosition = nil
        end)
    end,
})
