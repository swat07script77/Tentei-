                            for _, child in ipairs(curRoot:GetChildren()) do
                                if child:IsA("BodyPosition") or child:IsA("BodyVelocity")
                                or child:IsA("BodyGyro") or child:IsA("AlignPosition")
                                or child:IsA("AlignOrientation") or child:IsA("AngularVelocity")
                                or child:IsA("RocketPropulsion") or child:IsA("BallSocketConstraint")
                                or child:IsA("HingeConstraint") or child:IsA("SpringConstraint")
                                or child:IsA("RopeConstraint") or child:IsA("CylindricalConstraint")
