local flingAllToggleActive = false
local flingAllToggleConn = nil
local flingAllToggleIndex = 1
local flingAllToggleOriginal = nil
local flingAllToggleLastSwitch = 0
local flingAllBvTable = {}

PlayTab:CreateToggle({
    Title = "Fling All Toggle",
    Default = false,
    Callback = function(Value)
        if Value then
            flingAllToggleActive = true
            flingAllToggleIndex = 1
            flingAllToggleLastSwitch = tick()
            local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if myRoot then flingAllToggleOriginal = myRoot.CFrame end
            local orbitAngle = 0
            local orbitPositions = {
                CFrame.new(0, 1.5, 0),
                CFrame.new(0, -1.5, 0),
                CFrame.new(2.25, 1.5, -2.25),
                CFrame.new(-2.25, -1.5, 2.25),
                CFrame.new(0, 1.5, 0),
                CFrame.new(0, -1.5, 0)
            }
            local orbitIndex = 1
            workspace.FallenPartsDestroyHeight = 0/0
            flingAllToggleConn = RunService.Heartbeat:Connect(function(dt)
                if not flingAllToggleActive then return end
                local targets = {}
                for _, target in ipairs(Players:GetPlayers()) do
                    if target ~= player and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                        table.insert(targets, target.Character.HumanoidRootPart)
                    end
                end
                if #targets == 0 then return end
                if tick() - flingAllToggleLastSwitch >= 0.5 then
                    flingAllToggleIndex = flingAllToggleIndex % #targets + 1
                    flingAllToggleLastSwitch = tick()
                end
                orbitIndex = orbitIndex % #orbitPositions + 1
                orbitAngle = orbitAngle + 100 * dt
                local currentRoot = targets[flingAllToggleIndex]
                local myRootNow = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if not myRootNow or not currentRoot or not currentRoot.Parent then return end
                if not flingAllBvTable[currentRoot] then
                    local bv = Instance.new("BodyVelocity")
                    bv.Name = "EpixVel"
                    bv.Velocity = Vector3.new(9e8, 9e8, 9e8)
                    bv.MaxForce = Vector3.new(1/0, 1/0, 1/0)
                    bv.Parent = currentRoot
                    flingAllBvTable[currentRoot] = bv
                    pcall(function()
                        currentRoot.Parent:FindFirstChildOfClass("Humanoid"):SetStateEnabled(Enum.HumanoidStateType.Seated, false)
                    end)
                end
                local offset = orbitPositions[orbitIndex]
                local rotatedOffset = offset * CFrame.Angles(math.rad(orbitAngle), 0, 0)
                myRootNow.CFrame = CFrame.new(currentRoot.Position) * rotatedOffset
                myRootNow.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
                myRootNow.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
                attach(myRootNow, currentRoot)
            end)
        else
            flingAllToggleActive = false
            if flingAllToggleConn then flingAllToggleConn:Disconnect(); flingAllToggleConn = nil end
            for _, bv in pairs(flingAllBvTable) do pcall(function() bv:Destroy() end) end
            flingAllBvTable = {}
            workspace.FallenPartsDestroyHeight = -500
            local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if myRoot and flingAllToggleOriginal then
                myRoot.CFrame = flingAllToggleOriginal
                myRoot.Velocity = Vector3.zero
                myRoot.RotVelocity = Vector3.zero
                detach(myRoot)
            end
        end
    end,
})

local superFlingActive = false
local superFlingConn = nil
local superFlingTarget = nil
local superFlingOriginalCFrame = nil
local superFlingMenu = nil
local superFlingOffset = Vector3.new(0, -3, 0)
local superFlingBvTable = {}

local function stopSuperFling()
    superFlingActive = false
    if superFlingConn then superFlingConn:Disconnect(); superFlingConn = nil end
    if superFlingMenu then superFlingMenu:Destroy(); superFlingMenu = nil end
    for _, bv in pairs(superFlingBvTable) do pcall(function() bv:Destroy() end) end
    superFlingBvTable = {}
    superFlingTarget = nil
    local char = player.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if root then
            if superFlingOriginalCFrame then root.CFrame = superFlingOriginalCFrame; superFlingOriginalCFrame = nil end
            root.Velocity = Vector3.zero
            root.RotVelocity = Vector3.zero
            detach(root)
        end
        if hum then hum.PlatformStand = false end
    end
end

PlayTab:CreateToggle({
    Title = "Super Fling",
    Default = false,
    Callback = function(Value)
        if not Value then stopSuperFling() return end
        local t = GetPlayTarget()
        if not t or not t.Character then return end
        local char = player.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end
        local targetRoot = t.Character:FindFirstChild("HumanoidRootPart")
        if not targetRoot then return end
        superFlingOriginalCFrame = root.CFrame
        hum.PlatformStand = true
        superFlingActive = true
        superFlingTarget = t
        if not superFlingBvTable[targetRoot] then
            local bv = Instance.new("BodyVelocity")
            bv.Name = "EpixVel"
            bv.Velocity = Vector3.new(9e18, 9e18, 9e18)
            bv.MaxForce = Vector3.new(1/0, 1/0, 1/0)
            bv.Parent = targetRoot
            superFlingBvTable[targetRoot] = bv
        end
        pcall(function()
            targetRoot.Parent:FindFirstChildOfClass("Humanoid"):SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        end)
        superFlingConn = RunService.Heartbeat:Connect(function()
            if not superFlingActive then return end
            local curChar = player.Character
            local curTarget = superFlingTarget and superFlingTarget.Character
            if not curChar or not curTarget then stopSuperFling() return end
            local curRoot = curChar:FindFirstChild("HumanoidRootPart")
            local curTargetRoot = curTarget:FindFirstChild("HumanoidRootPart")
            if not curRoot or not curTargetRoot then return end
            curRoot.CFrame = CFrame.new(curTargetRoot.Position + superFlingOffset) * CFrame.Angles(-math.pi/2, 0, 0)
            curRoot.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
            curRoot.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
            attach(curRoot, curTargetRoot)
        end)
    end,
})
