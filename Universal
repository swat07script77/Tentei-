                curHum:ChangeState(Enum.HumanoidStateType.Physics)
            end
            local changeDelay = 1 / reverseSpinSpeed
            if tick() - reverseSpinLastChange >= changeDelay then
                reverseSpinLastChange = tick()
                reverseSpinIndex = reverseSpinIndex - 1
                if reverseSpinIndex < 1 then reverseSpinIndex = #positions end
            end
            local currentXAngle = positions[reverseSpinIndex]
            local rotationOffset = CFrame.Angles(currentXAngle, 0, 0)
            local currentY = curRoot.Velocity.Y
            if curHum.MoveDirection.Magnitude > 0 then
                local moveDirectionXZ = Vector3.new(curHum.MoveDirection.X, 0, curHum.MoveDirection.Z).Unit
