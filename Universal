ToolTab:CreateButton({
    Title = "ToolAttach",
    Callback = function()
        local RunService = game:GetService("RunService")
        local me = LocalPlayer
        local mouse = me:GetMouse()

        -- anti-delay
        local function attach(P1, P2)
            if sethiddenproperty and InstanceHandle then
                pcall(function()
                    sethiddenproperty(P1, "PhysicsRepRootRef", InstanceHandle.new(P2 or P1))
                end)
            end
        end
        local function detach(P1)
            if sethiddenproperty then
                pcall(function()
                    sethiddenproperty(P1, "PhysicsRepRootRef", nil)
                end)
            end
        end

        task.spawn(function()
            while true do
                RunService.Heartbeat:Wait()
                local char = me.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local humanoid = char and char:FindFirstChildOfClass("Humanoid")

                if humanoid then
                    humanoid.MaxHealth = math.huge
                    humanoid.Health = humanoid.MaxHealth
                end

                local destroyHeight = workspace.FallenPartsDestroyHeight or -500
                if root and root.Position.Y < destroyHeight + 100 then
                    root.CFrame = CFrame.new(root.Position.X, 50, root.Position.Z)
                    root.Velocity = Vector3.zero
                    root.RotVelocity = Vector3.zero
                end
            end
        end)

        local function WalkFlingVoid(state)
            if not state then
                _G.WalkFlingVoidActive = false
                if _G.WalkFlingVoidThread then
                    task.cancel(_G.WalkFlingVoidThread)
                    _G.WalkFlingVoidThread = nil
                end
                local char = me.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root then
                    root.Velocity = Vector3.zero
                    root.RotVelocity = Vector3.zero
                    detach(root)
                end
                return
            end

            _G.WalkFlingVoidActive = true
            _G.WalkFlingVoidThread = task.spawn(function()
                repeat
                    RunService.Heartbeat:Wait()
                    if not _G.WalkFlingVoidActive then break end
                    local character = me.Character
                    local root = character and character:FindFirstChild("HumanoidRootPart")
                    if not root then break end

                    root.Velocity = Vector3.new(0, -10000, 0)
                    RunService.RenderStepped:Wait()
                    if _G.WalkFlingVoidActive and character and character.Parent and root and root.Parent then
                        root.Velocity = Vector3.new(0, -10000, 0)
                    end
                    RunService.Stepped:Wait()
                    if _G.WalkFlingVoidActive and character and character.Parent and root and root.Parent then
                        root.Velocity = Vector3.new(0, -10000, 0)
                    end
                until not _G.WalkFlingVoidActive
            end)
        end

        local tool = Instance.new("Tool")
        tool.Name = "attach"
        tool.RequiresHandle = false
        tool.CanBeDropped = false

        local isExecuting = false

        tool.Activated:Connect(function()
            if isExecuting then return end

            local myChar = me.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not myRoot then return end

            local targetPart = mouse.Target
            if not targetPart then return end

            local targetChar = targetPart:FindFirstAncestorOfClass("Model")
            local targetPlayer = Players:GetPlayerFromCharacter(targetChar)
            local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")

            if targetPlayer and targetPlayer ~= me and targetRoot then
                isExecuting = true
                local originalCFrame = myRoot.CFrame
                WalkFlingVoid(true)

                local startTime = tick()
                local connection
                connection = RunService.Heartbeat:Connect(function()
                    if tick() - startTime < 2 and targetRoot and targetRoot.Parent and myRoot and myRoot.Parent then
                        myRoot.CFrame = targetRoot.CFrame * CFrame.Angles(math.rad(90), 0, 0)
                        attach(myRoot, targetRoot)
                    else
                        connection:Disconnect()
                    end
                end)

                task.wait(2)

                detach(myRoot)
                WalkFlingVoid(false)
                if myRoot and myRoot.Parent then
                    myRoot.CFrame = originalCFrame
                    myRoot.Velocity = Vector3.zero
                    myRoot.RotVelocity = Vector3.zero
                end

                isExecuting = false
            end
        end)

        tool.GripPos = Vector3.new(0, 9e99, 0)
        tool.Parent = me.Character or me:WaitForChild("Backpack")
    end,
})
ToolTab:CreateButton({
    Title = "Toolbringnpc",
    Callback = function()
        local runService = game:GetService("RunService")

        local tool = Instance.new("Tool")
        tool.Name = "toolbringnpc"
        tool.RequiresHandle = true

        local handle = Instance.new("Part")
        handle.Name = "Handle"
        handle.Size = Vector3.new(0.1, 0.1, 0.1)
        handle.Transparency = 1
        handle.CanCollide = false
        handle.Parent = tool

        tool.Parent = LocalPlayer:WaitForChild("Backpack")

        local heldNpc = nil
        local isEquipped = false
        local lastClick = 0
        local originalCollisions = {}
        local conn, renderConn = nil, nil

        local function disableNpcCollision(model)
            if originalCollisions[model] then return end
            originalCollisions[model] = {}
            for _, p in ipairs(model:GetDescendants()) do
                if p:IsA("BasePart") then
                    originalCollisions[model][p] = p.CanCollide
                    p.CanCollide = false
                end
            end
        end

        local function restoreNpcCollision(model)
            if originalCollisions[model] then
                for p, state in pairs(originalCollisions[model]) do
                    if p and p.Parent then p.CanCollide = state end
                end
                originalCollisions[model] = nil
            end
        end

        tool.Equipped:Connect(function()
            isEquipped = true
            local mouse = LocalPlayer:GetMouse()

            conn = mouse.Button1Down:Connect(function()
                if not isEquipped then return end
                local now = tick()

                if (now - lastClick) <= 0.3 and heldNpc then
                    local char = LocalPlayer.Character
                    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
                    local npcRoot = heldNpc:FindFirstChild("HumanoidRootPart")

                    if myRoot and npcRoot then
                        local hitPos = mouse.Hit.Position
                        local npcToThrow = heldNpc
                        heldNpc = nil

                        task.spawn(function()
                            local startCFrame = myRoot.CFrame
                            local targetLook = CFrame.lookAt(myRoot.Position, Vector3.new(hitPos.X, myRoot.Position.Y, hitPos.Z))

                            for i = 0, 1, 0.15 do
                                if not myRoot or not myRoot.Parent then break end
                                myRoot.CFrame = startCFrame:Lerp(targetLook, i) * CFrame.Angles(0, math.rad(i * 360), 0)
                                task.wait(0.02)
                            end
                            if myRoot then myRoot.CFrame = targetLook end

                            if npcToThrow and npcToThrow.Parent then
                                local finalRoot = npcToThrow:FindFirstChild("HumanoidRootPart")
                                if finalRoot then
                                    local throwDir = (hitPos - finalRoot.Position).Unit
                                    finalRoot.AssemblyLinearVelocity = throwDir * 160 + Vector3.new(0, 60, 0)
                                end
                                task.delay(0.3, function()
                                    restoreNpcCollision(npcToThrow)
                                end)
                            end
                        end)
                    end

                    lastClick = 0
                    return
                end

                lastClick = now

                if not heldNpc then
                    local target = mouse.Target
                    if target and target.Parent then
                        local hum = target.Parent:FindFirstChildOfClass("Humanoid")
                        if hum and not Players:GetPlayerFromCharacter(target.Parent) then
                            local npcRoot = target.Parent:FindFirstChild("HumanoidRootPart")
                            local char = LocalPlayer.Character
                            local myRoot = char and char:FindFirstChild("HumanoidRootPart")

                            if npcRoot and myRoot and (npcRoot.Position - myRoot.Position).Magnitude <= 15 then
                                heldNpc = target.Parent
                                disableNpcCollision(heldNpc)
                            end
                        end
                    end
                end
            end)

            renderConn = runService.RenderStepped:Connect(function()
                if not isEquipped or not heldNpc then return end
                local char = LocalPlayer.Character
                local rightArm = char and (char:FindFirstChild("Right Arm") or char:FindFirstChild("RightHand"))
                local npcRoot = heldNpc:FindFirstChild("HumanoidRootPart")

                if rightArm and npcRoot then
                    npcRoot.CFrame = rightArm.CFrame * CFrame.new(0, -1, -1.5) * CFrame.Angles(math.rad(90), 0, 0)
                    npcRoot.AssemblyLinearVelocity = Vector3.zero
                    npcRoot.AssemblyAngularVelocity = Vector3.zero
                end
            end)
        end)

        tool.Unequipped:Connect(function()
            isEquipped = false
            if conn then conn:Disconnect() end
            if renderConn then renderConn:Disconnect() end
            if heldNpc then
                restoreNpcCollision(heldNpc)
                heldNpc = nil
            end
        end)
    end,
})

