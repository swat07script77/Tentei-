do
    local originalSettings = {}
    local lighting = game:GetService("Lighting")
    local terrain = workspace:FindFirstChildWhichIsA("Terrain")

    local function saveOriginalObject(obj)
        if originalSettings[obj] then return end
        local data = {}
        if obj:IsA("BasePart") then
            data.Material = obj.Material
            data.Reflectance = obj.Reflectance
            data.CastShadow = obj.CastShadow
            data.BackSurface = obj.BackSurface
            data.BottomSurface = obj.BottomSurface
            data.FrontSurface = obj.FrontSurface
            data.LeftSurface = obj.LeftSurface
            data.RightSurface = obj.RightSurface
            data.TopSurface = obj.TopSurface
        elseif obj:IsA("Decal") then
            data.Transparency = obj.Transparency
            data.Texture = obj.Texture
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") then
            data.Lifetime = obj.Lifetime
        elseif obj:IsA("PostEffect") then
            data.Enabled = obj.Enabled
        end
        originalSettings[obj] = data
    end

    local function applyBooster()
        if not originalSettings._global then
            originalSettings._global = {}
            if terrain then
                originalSettings._global.Terrain = {
                    WaterWaveSize = terrain.WaterWaveSize,
                    WaterWaveSpeed = terrain.WaterWaveSpeed,
                    WaterReflectance = terrain.WaterReflectance,
                    WaterTransparency = terrain.WaterTransparency,
                }
            end
            originalSettings._global.Lighting = {
                GlobalShadows = lighting.GlobalShadows,
                FogEnd = lighting.FogEnd,
                FogStart = lighting.FogStart,
            }
            pcall(function() originalSettings._global.QualityLevel = settings().Rendering.QualityLevel end)
        end
        if terrain then
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
            terrain.WaterReflectance = 0
            terrain.WaterTransparency = 1
        end
        lighting.GlobalShadows = false
        lighting.FogEnd = 9e9
        lighting.FogStart = 9e9
        pcall(function() settings().Rendering.QualityLevel = 1 end)
        for _, v in pairs(game:GetDescendants()) do
            pcall(function()
                saveOriginalObject(v)
                if v:IsA("BasePart") then
                    v.CastShadow = false
                    v.Material = "Plastic"
                    v.Reflectance = 0
                    v.BackSurface = "SmoothNoOutlines"
                    v.BottomSurface = "SmoothNoOutlines"
                    v.FrontSurface = "SmoothNoOutlines"
                    v.LeftSurface = "SmoothNoOutlines"
                    v.RightSurface = "SmoothNoOutlines"
                    v.TopSurface = "SmoothNoOutlines"
                elseif v:IsA("Decal") then
                    v.Transparency = 1
                    v.Texture = ""
                elseif v:IsA("ParticleEmitter") or v:IsA("Trail") then
                    v.Lifetime = NumberRange.new(0)
                end
            end)
        end
        for _, v in pairs(lighting:GetDescendants()) do
            pcall(function()
                if v:IsA("PostEffect") then
                    saveOriginalObject(v)
                    v.Enabled = false
                end
            end)
        end
    end

    local function restoreSettings()
        local global = originalSettings._global
        if global then
            if global.Terrain and terrain then
                terrain.WaterWaveSize = global.Terrain.WaterWaveSize
                terrain.WaterWaveSpeed = global.Terrain.WaterWaveSpeed
                terrain.WaterReflectance = global.Terrain.WaterReflectance
                terrain.WaterTransparency = global.Terrain.WaterTransparency
            end
            if global.Lighting then
                lighting.GlobalShadows = global.Lighting.GlobalShadows
                lighting.FogEnd = global.Lighting.FogEnd
                lighting.FogStart = global.Lighting.FogStart
            end
            pcall(function() settings().Rendering.QualityLevel = global.QualityLevel or 21 end)
        end
        for obj, data in pairs(originalSettings) do
            if obj and obj.Parent then
                pcall(function()
                    if obj:IsA("BasePart") then
                        if data.Material then obj.Material = data.Material end
                        if data.Reflectance then obj.Reflectance = data.Reflectance end
                        if data.CastShadow ~= nil then obj.CastShadow = data.CastShadow end
                        if data.BackSurface then obj.BackSurface = data.BackSurface end
                        if data.BottomSurface then obj.BottomSurface = data.BottomSurface end
                        if data.FrontSurface then obj.FrontSurface = data.FrontSurface end
                        if data.LeftSurface then obj.LeftSurface = data.LeftSurface end
                        if data.RightSurface then obj.RightSurface = data.RightSurface end
                        if data.TopSurface then obj.TopSurface = data.TopSurface end
                    elseif obj:IsA("Decal") then
                        if data.Transparency then obj.Transparency = data.Transparency end
                        if data.Texture then obj.Texture = data.Texture end
                    elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") then
                        if data.Lifetime then obj.Lifetime = data.Lifetime end
                    elseif obj:IsA("PostEffect") then
                        if data.Enabled ~= nil then obj.Enabled = data.Enabled end
                    end
                end)
            end
        end
        originalSettings = {}
    end

    CfgTab:CreateToggle({
        Title = "FPS Booster", Default = false,
        Callback = function(value)
            if value then
                applyBooster()
            else
                restoreSettings()
            end
        end,
    })
end

