-- =============================================
local antiDamageActive = false
local antiDamageDiedConn = nil
local antiDamageLastActivation = 0
local antiDamageJaClonado = false
local antiDamageHealthConn = nil
local antiDamageCharConn = nil

local function antiDamageFazerClone(character)
    if antiDamageJaClonado then return end
    antiDamageJaClonado = true
    local Cam = workspace.CurrentCamera
    local Char = character
    local Pos = Cam.CFrame
    local Human = Char and Char:FindFirstChildWhichIsA("Humanoid")
    if not Human then antiDamageJaClonado = false; return end
    local nHuman = Human:Clone()
    nHuman.Parent = Char
    LocalPlayer.Character = nil
    nHuman:SetStateEnabled(15, false)
    nHuman:SetStateEnabled(1, false)
    nHuman:SetStateEnabled(0, false)
    nHuman.BreakJointsOnDeath = true
    Human:Destroy()
    LocalPlayer.Character = Char
    Cam.CameraSubject = nHuman
    Cam.CFrame = Pos
    nHuman.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    local Script = Char:FindFirstChild("Animate")
    if Script then Script.Disabled = true; task.wait(); Script.Disabled = false end
    nHuman.Health = nHuman.MaxHealth
    if antiDamageDiedConn then antiDamageDiedConn:Disconnect() end
    antiDamageDiedConn = nHuman.Died:Connect(function() antiDamageJaClonado = false end)
end

local function setupAntiDamageMonitor()
    if antiDamageHealthConn then antiDamageHealthConn:Disconnect(); antiDamageHealthConn = nil end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local lastHealth = hum.Health
    antiDamageHealthConn = hum:GetPropertyChangedSignal("Health"):Connect(function()
        if not antiDamageActive then return end
        if tick() - antiDamageLastActivation < 0.1 then return end
        local newHealth = hum.Health
        if newHealth < lastHealth then
            antiDamageLastActivation = tick()
            antiDamageJaClonado = false
            local curChar = LocalPlayer.Character
            if curChar then antiDamageFazerClone(curChar) end
        end
        lastHealth = newHealth
    end)
end

local function stopAntiDamage()
    antiDamageActive = false
    if antiDamageDiedConn then antiDamageDiedConn:Disconnect(); antiDamageDiedConn = nil end
    if antiDamageHealthConn then antiDamageHealthConn:Disconnect(); antiDamageHealthConn = nil end
    if antiDamageCharConn then antiDamageCharConn:Disconnect(); antiDamageCharConn = nil end
    antiDamageJaClonado = false
end

AbuseTab:CreateToggle({
    Title = "Anti Damage",
    Default = false,
    Callback = function(Value)
        antiDamageActive = Value
        if Value then
            antiDamageCharConn = LocalPlayer.CharacterAdded:Connect(function()
                task.wait(0.5)
                if antiDamageActive then
                    antiDamageFazerClone(LocalPlayer.Character)
                    setupAntiDamageMonitor()
                end
            end)
            if LocalPlayer.Character then
                task.wait(0.1)
                antiDamageFazerClone(LocalPlayer.Character)
                setupAntiDamageMonitor()
            end
        else
            stopAntiDamage()
        end
    end,
})


