        Default = false,
        Callback = function(state)
            antiRingActive = state
            if state then
                for _, part in ipairs(workspace:GetDescendants()) do
                    setNoClipOnPart(part)
                end
                antiRingConn = workspace.DescendantAdded:Connect(function(desc)
                    if not antiRingActive then return end
                    if desc:IsA("BasePart") then setNoClipOnPart(desc) end
                end)
            else
                if antiRingConn then antiRingConn:Disconnect(); antiRingConn = nil end
                for part, _ in pairs(noclipParts) do
                    if part and part.Parent then part.CanCollide = true end
                end
