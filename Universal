do
    local fpsPingActive = false
    local fpsPingGui = nil
    local fpsPingConn = nil
    local fpsPingFrame = nil
    local fpsPingLabel = nil
    local pingPingLabel = nil
    local fpsPingDragging = false
    local fpsPingDragStart = nil
    local fpsPingStartPos = nil
    local fpsPingFrameCount = 0
    local fpsPingTimeAccumulator = 0

    local function GetPing()
        local success, result = pcall(function() return player:GetNetworkPing() end)
        if success and result then return math.floor(result * 1000) end
        return 0
    end

    local function GetFpsColor(v)
        if v >= 60 then return Color3.fromRGB(0, 255, 100)
        elseif v >= 50 then return Color3.fromRGB(0, 255, 100):Lerp(Color3.fromRGB(200, 255, 50), (v - 50) / 10)
        elseif v >= 40 then return Color3.fromRGB(200, 255, 50):Lerp(Color3.fromRGB(255, 200, 0), (v - 40) / 10)
        elseif v >= 30 then return Color3.fromRGB(255, 200, 0):Lerp(Color3.fromRGB(255, 100, 0), (v - 30) / 10)
        elseif v >= 20 then return Color3.fromRGB(255, 100, 0):Lerp(Color3.fromRGB(200, 0, 0), (v - 20) / 10)
        else return Color3.fromRGB(200, 0, 0) end
    end

    local function GetPingColor(v)
        if v <= 50 then return Color3.fromRGB(0, 255, 100)
        elseif v <= 100 then return Color3.fromRGB(0, 255, 100):Lerp(Color3.fromRGB(255, 200, 0), (v - 50) / 50)
        elseif v <= 200 then return Color3.fromRGB(255, 200, 0):Lerp(Color3.fromRGB(255, 100, 0), (v - 100) / 100)
        elseif v <= 300 then return Color3.fromRGB(255, 100, 0):Lerp(Color3.fromRGB(200, 0, 0), (v - 200) / 100)
        else return Color3.fromRGB(200, 0, 0) end
    end

    local function CreateFPSPingUI()
        if fpsPingGui then fpsPingGui:Destroy(); fpsPingGui = nil end
        fpsPingGui = Instance.new("ScreenGui")
        fpsPingGui.Name = "FPSPingDisplay"
        fpsPingGui.ResetOnSpawn = false
        fpsPingGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        fpsPingGui.Parent = player:WaitForChild("PlayerGui")
        fpsPingFrame = Instance.new("Frame")
        fpsPingFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
        fpsPingFrame.BackgroundTransparency = 0.3
        fpsPingFrame.BorderSizePixel = 0
        fpsPingFrame.Size = UDim2.new(0, 180, 0, 40)
        fpsPingFrame.Position = UDim2.new(0.85, -90, 0.02, 5)
        fpsPingFrame.Active = true
        fpsPingFrame.ClipsDescendants = true
        fpsPingFrame.Parent = fpsPingGui
        Instance.new("UICorner", fpsPingFrame).CornerRadius = UDim.new(0, 8)
        local gr = Instance.new("UIGradient", fpsPingFrame)
        gr.Color = ColorSequence.new(Color3.fromRGB(30, 30, 45), Color3.fromRGB(15, 15, 25))
        fpsPingLabel = Instance.new("TextLabel", fpsPingFrame)
        fpsPingLabel.Size = UDim2.new(0.5, -10, 1, 0)
        fpsPingLabel.Position = UDim2.new(0, 5, 0, 0)
        fpsPingLabel.BackgroundTransparency = 1
        fpsPingLabel.Font = Enum.Font.GothamBold
        fpsPingLabel.Text = "FPS: 60"
        fpsPingLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
        fpsPingLabel.TextSize = 14
        fpsPingLabel.TextXAlignment = Enum.TextXAlignment.Left
        pingPingLabel = Instance.new("TextLabel", fpsPingFrame)
        pingPingLabel.Size = UDim2.new(0.5, -10, 1, 0)
        pingPingLabel.Position = UDim2.new(0.5, 5, 0, 0)
        pingPingLabel.BackgroundTransparency = 1
        pingPingLabel.Font = Enum.Font.GothamBold
        pingPingLabel.Text = "PING: 0"
        pingPingLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
        pingPingLabel.TextSize = 14
        pingPingLabel.TextXAlignment = Enum.TextXAlignment.Left
        fpsPingFrame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                fpsPingDragging = true
                fpsPingDragStart = input.Position
                fpsPingStartPos = fpsPingFrame.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then fpsPingDragging = false end
                end)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if fpsPingDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - fpsPingDragStart
                fpsPingFrame.Position = UDim2.new(
                    fpsPingStartPos.X.Scale, fpsPingStartPos.X.Offset + delta.X,
                    fpsPingStartPos.Y.Scale, fpsPingStartPos.Y.Offset + delta.Y
                )
            end
        end)
        fpsPingFrameCount = 0
        fpsPingTimeAccumulator = 0
        if fpsPingConn then fpsPingConn:Disconnect() end
        fpsPingConn = RunService.RenderStepped:Connect(function(dt)
            if not fpsPingActive or not fpsPingFrame or not fpsPingFrame.Parent then return end
            fpsPingFrameCount = fpsPingFrameCount + 1
            fpsPingTimeAccumulator = fpsPingTimeAccumulator + dt
            if fpsPingTimeAccumulator >= 0.5 then
                local fps = math.floor(fpsPingFrameCount / fpsPingTimeAccumulator)
                local ping = GetPing()
                if fpsPingLabel then
                    fpsPingLabel.Text = "FPS: " .. fps
                    fpsPingLabel.TextColor3 = GetFpsColor(fps)
                end
                if pingPingLabel then
                    pingPingLabel.Text = "PING: " .. ping
                    pingPingLabel.TextColor3 = GetPingColor(ping)
                end
                fpsPingFrameCount = 0
                fpsPingTimeAccumulator = 0
            end
        end)
    end

