                    if not tpWallActive then return end
                    local char = player.Character
                    if not char then return end
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if not root then return end
                    local params = RaycastParams.new()
                    params.FilterDescendantsInstances = {char}
                    params.FilterType = Enum.RaycastFilterType.Exclude
                    local direction = root.CFrame.LookVector * 3
                    local result = workspace:Raycast(root.Position, direction, params)
                    if result and result.Instance then
                        local hit = result.Instance
                        if hit.CanCollide and hit.Size.Y > 2 then
                            local topY = hit.Position.Y + (hit.Size.Y / 2) + 3
                            local forwardOffset = root.CFrame.LookVector * 1.5
                            local targetPosition = Vector3.new(result.Position.X, topY, result.Position.Z) + forwardOffset
                            root.CFrame = CFrame.new(targetPosition) * (root.CFrame - root.Position)
                        end
                    end
                end)
                Notify("TP to Wall Top", "Enabled", 2)
            else
                if tpWallConn then tpWallConn:Disconnect(); tpWallConn = nil end
                Notify("TP to Wall Top", "Disabled", 1)
            end
        end,
    })
