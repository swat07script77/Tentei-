pcall(function()
    local bringActive = false
    local bringTarget = nil
    local bringOriginalCFrame = nil
    local bringSpeeding = 60
    local bringMaxSpeed = 75
    local bringOffRot = CFrame.Angles(-1.5707963267948966, 0, 0)
    local v3_0 = Vector3.new(0, 0, 0)

    PlayTab:CreateSlider({
        Title = "Bring Speed", Min = 20, Max = 200, Default = 75,
        Callback = function(Value)
            bringMaxSpeed = Value
            bringSpeeding = Value * 0.8
        end,
    })

    local function stopBring()
        bringActive = false
        local char = player.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                if bringOriginalCFrame then
                    root.CFrame = bringOriginalCFrame
                    bringOriginalCFrame = nil
                end
                root.Velocity = v3_0
                root.RotVelocity = v3_0
                detach(root)
            end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.PlatformStand = false
                local animate = char:FindFirstChild("Animate")
                if animate then animate.Disabled = false end
            end
        end
    end

    PlayTab:CreateToggle({
        Title = "Bring Target",
        Default = false,
        Callback = function(Value)
            if not Value then stopBring() return end
            local t = GetPlayTarget()
            if not t or not t.Character then return end
            bringTarget = t
            bringActive = true
            task.spawn(function()
                local c = player.Character
                local c1 = bringTarget.Character
                if not (c and c1) then stopBring() return end
                local hrp = c:FindFirstChild("HumanoidRootPart")
                local hrp1 = c1:FindFirstChild("HumanoidRootPart")
                if not (hrp and hrp1) then stopBring() return end
                local hum = c:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.PlatformStand = true
                    local animate = c:FindFirstChild("Animate")
                    if animate then animate.Disabled = true end
                end
                bringOriginalCFrame = hrp.CFrame
                local fromP = hrp1.CFrame.Position
                local toP = hrp.CFrame.Position
                local to = hrp.CFrame
                local mag = (fromP - toP).Magnitude - 3
                local lv = CFrame.new(fromP, toP).LookVector
                local vel = 0
                local pos = fromP - Vector3.new(0, 2, 0)
                toP = toP - Vector3.new(0, 2, 0)
                local lastsine = os.clock()
                local way = 0
                local reachedmaxspeed = false
                while bringActive and c:IsDescendantOf(workspace) and c1:IsDescendantOf(workspace) do
                    local sine = os.clock()
                    local dt = sine - lastsine
                    lastsine = sine
                    if reachedmaxspeed then
                        if mag - way < reachedmaxspeed then
                            vel = vel - dt * bringSpeeding
                            if vel < 0 then break end
                        end
                    else
                        if way > mag / 2 then
                            vel = vel - dt * bringSpeeding
                            if vel < 0 then break end
                        else
                            vel = vel + dt * bringSpeeding
                            if vel > bringMaxSpeed then
                                reachedmaxspeed = way
                                vel = bringMaxSpeed
                            end
                        end
                    end
                    way = way + vel * dt
                    if not hrp:IsGrounded() then
                        hrp.CFrame = CFrame.new(pos + lv * way, toP) * bringOffRot
                        hrp.Velocity = lv * (vel + 1)
                        hrp.RotVelocity = v3_0
                    end
                    attach(hrp, hrp1)
                    task.wait()
                end
                hrp.CFrame = to
                hrp.Velocity = v3_0
                hrp.RotVelocity = v3_0
                stopBring()
            end)
        end,
    })
end)

