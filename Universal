-- ANTI-KICK (Toggle) - Anti
-- ============================================================
local antiKickActive = false
local antiKickHooked = false
local antiKickOldNamecall = nil
local antiKickOldKick = nil

local function EnableAntiKick()
    if antiKickActive then return end
    antiKickActive = true

    if antiKickHooked then return end
    antiKickHooked = true

    pcall(function()
        local mt = getrawmetatable(game)
        setreadonly(mt, false)
        antiKickOldNamecall = mt.__namecall
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if antiKickActive then
                if self == LocalPlayer then
                    local m = method:lower()
                    if m == "kick" or m:find("kick") or m:find("ban") then return end
                    if m == "disconnect" then return end
                end
                if method == "FireServer" then
                    local s = tostring(self)
                    if s:find("Kick") or s:find("Ban") or s:find("exploit") then return end
                end
            end
            return antiKickOldNamecall(self, ...)
        end)
        setreadonly(mt, true)
    end)

    if hookfunction then
        pcall(function()
            antiKickOldKick = hookfunction(LocalPlayer.Kick, function()
                if antiKickActive then return end
                return antiKickOldKick and antiKickOldKick(LocalPlayer)
            end)
        end)
    end

    if hookfunction then
        pcall(function()
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                local oldChangeState = hum.ChangeState
                hookfunction(hum.ChangeState, function(self, state)
                    if antiKickActive and state == Enum.HumanoidStateType.Dead then return end
                    return oldChangeState(self, state)
                end)
            end
        end)
    end
end

local function DisableAntiKick()
    if not antiKickActive then return end
    antiKickActive = false
    if antiKickOldNamecall then
        pcall(function()
            local mt = getrawmetatable(game)
            setreadonly(mt, false)
            mt.__namecall = antiKickOldNamecall
            setreadonly(mt, true)
        end)
        antiKickOldNamecall = nil
    end
    if antiKickOldKick and hookfunction then
        pcall(function() hookfunction(LocalPlayer.Kick, antiKickOldKick) end)
        antiKickOldKick = nil
    end
    antiKickHooked = false
end

AntiTab:CreateToggle({
    Title = "Anti-Kick",
    Default = false,
    Callback = function(Value)
        if Value then EnableAntiKick() else DisableAntiKick() end
    end,
})


