local MainTab = Window:CreateTab("Main", "home")

local function SetHidden(obj, prop, value)
    if sethiddenproperty then
        pcall(sethiddenproperty, obj, prop, value)
    end
end

local function AttachRoot(root, targetRoot)
    SetHidden(root, "PhysicsRepRootPart", targetRoot)
end

local TargetPlayer = nil
local TargetDropdown = nil

local function GetTarget()
    if not TargetPlayer or TargetPlayer == "" then return nil end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name == TargetPlayer then return plr end
    end
    return nil
end

local function RefreshTargetList()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then table.insert(list, plr.Name) end
    end
    table.sort(list)
    if TargetDropdown and TargetDropdown.Update then
        pcall(function() TargetDropdown:Update({ Options = list }) end)
    end
end

TargetDropdown = MainTab:CreateDropdown({
    Title = "Select Target",
    Options = {},
    Callback = function(Value) TargetPlayer = Value end,
})
RefreshTargetList()

MainTab:CreateButton({
    Title = "Refresh Target List",
    Callback = function() RefreshTargetList() end,
})

local killAllLoopActive = false
local killAllLoopConnection = nil
local currentTargetIndex = 1
local SWITCH_INTERVAL = 0.2
local BOBBING_SPEED = 20
local originalLoopCFrame = nil

MainTab:CreateToggle({
    Title = "Kill All Loop",
    Default = false,
    Callback = function(Value)
        killAllLoopActive = Value
        if Value then
            if not LocalPlayer.Character then
                LocalPlayer.CharacterAdded:Wait()
            end
            local localChar = LocalPlayer.Character
            if not localChar then return end

            for _, part in pairs(localChar:GetDescendants()) do
                if part:IsA("BasePart") then
                    pcall(function() part:SetNetworkOwner(LocalPlayer) end)
                end
            end

            local localRoot = localChar:FindFirstChild("HumanoidRootPart")
            local localHum = localChar:FindFirstChild("Humanoid")
            if not localRoot or not localHum then return end

            originalLoopCFrame = localRoot.CFrame
            local UP_FORCE = Vector3.new(0, 9e9, 0)
            local lastSwitch = tick()

            killAllLoopConnection = RunService.Heartbeat:Connect(function()
                if not killAllLoopActive then return end
                localChar = LocalPlayer.Character
                if not localChar then return end
                localRoot = localChar:FindFirstChild("HumanoidRootPart")
                localHum = localChar:FindFirstChild("Humanoid")
                if not localRoot or not localHum then return end

                localHum.PlatformStand = true
                localRoot.Velocity = Vector3.zero
                localRoot.RotVelocity = Vector3.zero

                local targets = {}
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        local head = p.Character:FindFirstChild("Head")
                        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                        if head and hrp then
                            table.insert(targets, {head = head, hrp = hrp})
                        end
                    end
                end
                if #targets == 0 then return end

                if tick() - lastSwitch >= SWITCH_INTERVAL then
                    currentTargetIndex = (currentTargetIndex % #targets) + 1
                    lastSwitch = tick()
                end

                local target = targets[currentTargetIndex]
                if target and target.head and target.hrp then
                    local headPos = target.head.Position
                    local bellyPos = target.hrp.Position
                    local cycle = (tick() * BOBBING_SPEED) % 1
                    local y = headPos.Y + (bellyPos.Y - headPos.Y) * (0.5 - 0.5 * math.cos(cycle * 2 * math.pi))
                    localRoot.CFrame = CFrame.new(headPos.X, y, headPos.Z)
                    localRoot.Velocity = Vector3.zero
                    localRoot.RotVelocity = Vector3.zero
                    target.hrp.Velocity = UP_FORCE
                    target.hrp.RotVelocity = Vector3.zero
                    AttachRoot(localRoot, target.hrp)
                end
            end)
        else
            if killAllLoopConnection then killAllLoopConnection:Disconnect(); killAllLoopConnection = nil end
            local localChar = LocalPlayer.Character
            if localChar then
                local hum = localChar:FindFirstChild("Humanoid")
                local root = localChar:FindFirstChild("HumanoidRootPart")
                if hum then hum.PlatformStand = false end
                if root then
                    AttachRoot(root, nil)
                    root.Velocity = Vector3.zero
                    root.RotVelocity = Vector3.zero
                    if originalLoopCFrame then root.CFrame = originalLoopCFrame end
                end
            end
        end
    end,
})

local killAllRunning = false
MainTab:CreateButton({
    Title = "Kill All",
    Callback = function()
        if killAllRunning then return end
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChild("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not hum or not root then return end

        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                pcall(function() part:SetNetworkOwner(LocalPlayer) end)
            end
        end

        killAllRunning = true
        local UP_FORCE = Vector3.new(0, 9e9, 0)
        local originalCFrame = root.CFrame
        local originalPlatformStand = hum.PlatformStand
        hum.PlatformStand = true

        local targets = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local head = p.Character:FindFirstChild("Head")
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if head and hrp then
                    table.insert(targets, {head = head, hrp = hrp})
                end
            end
        end
        if #targets == 0 then
            hum.PlatformStand = originalPlatformStand
            killAllRunning = false
            return
        end

        local index = 1
        local connection
        connection = RunService.Heartbeat:Connect(function()
            if index > #targets then
                connection:Disconnect()
                hum.PlatformStand = originalPlatformStand
                root.CFrame = originalCFrame
                root.Velocity = Vector3.zero
                root.RotVelocity = Vector3.zero
                AttachRoot(root, nil)
                killAllRunning = false
                return
            end
            local target = targets[index]
            if target and target.head and target.hrp and target.head.Parent and target.hrp.Parent then
                local headPos = target.head.Position
                local bellyPos = target.hrp.Position
                local cycle = (tick() * BOBBING_SPEED) % 1
                local y = headPos.Y + (bellyPos.Y - headPos.Y) * (0.5 - 0.5 * math.cos(cycle * 2 * math.pi))
                root.CFrame = CFrame.new(headPos.X, y, headPos.Z)
                root.Velocity = Vector3.zero
                root.RotVelocity = Vector3.zero
                target.hrp.Velocity = UP_FORCE
                target.hrp.RotVelocity = Vector3.zero
                AttachRoot(root, target.hrp)
                task.wait(0.08)
            end
            index = index + 1
        end)
    end,
})

local loopKillActive = false
