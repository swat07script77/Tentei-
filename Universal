    local function CreateRocket(Name, Speed)
        local Conn
        MainSwordsTab:CreateToggle({
            Title = Name, Default = false,
            Callback = function(State)
                if Conn then Conn:Disconnect(); Conn = nil end
                if not State then return end
                local LRoot = Root(LocalPlayer.Character)
                local t = GetSwordsTarget()
                local TRoot = t and Root(t.Character)
                if not (LRoot and TRoot) then return end
                local SavedCF = LRoot.CFrame
                Conn = RunService.Heartbeat:Connect(function()
                    if not TRoot.Parent then return end
                    local Pos = TRoot.Position + Vector3.new(0, -3, 0)
                    LRoot.CFrame = CFrame.new(Pos, Pos + Vector3.new(0, 1, 0))
                    LRoot.Velocity = Vector3.new(0, Speed, 0)
                    LRoot.RotVelocity = Vector3.zero
                    attach(LRoot, TRoot)
                end)
                task.delay(0.2, function()
                    if Conn then Conn:Disconnect(); Conn = nil end
                    LRoot.CFrame = SavedCF
                    LRoot.Velocity = Vector3.zero
                    LRoot.RotVelocity = Vector3.zero
                    attach(LRoot, LRoot)
                end)
            end,
        })
    end
