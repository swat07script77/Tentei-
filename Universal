-- GOD MODE
-- ============================================================
local godModeActive = false
local godModeConnections = {}

local function enableGodMode()
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    hum.MaxHealth = math.huge
    hum.Health = math.huge
    table.insert(godModeConnections, hum.HealthChanged:Connect(function(newHealth)
        if not godModeActive then return end
        if newHealth < math.huge then hum.Health = math.huge end
    end))
    table.insert(godModeConnections, char.ChildAdded:Connect(function(child)
        if not godModeActive then return end
        if child:IsA("ForceField") then child:Destroy() end
    end))
    local function removeDamageOverlay()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not playerGui then return end
        for _, name in ipairs({"HurtOverlay", "DamageOverlay", "RedEffect", "BloodOverlay", "DamageHud"}) do
            local overlay = playerGui:FindFirstChild(name)
            if overlay then overlay:Destroy() end
        end
    end
    removeDamageOverlay()
    table.insert(godModeConnections, RunService.Heartbeat:Connect(function()
        if not godModeActive then return end
        removeDamageOverlay()
    end))
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.CanTouch = false end
    end
    table.insert(godModeConnections, char.DescendantAdded:Connect(function(desc)
        if not godModeActive then return end
        if desc:IsA("BasePart") then desc.CanTouch = false end
    end))
    return true
end

local function disableGodMode()
    for _, conn in ipairs(godModeConnections) do conn:Disconnect() end
    godModeConnections = {}
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.MaxHealth = 100; hum.Health = 100 end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanTouch = true end
        end
    end
end

LocalPlayer.CharacterAdded:Connect(function()
    if godModeActive then
        task.wait(0.1)
        enableGodMode()
    end
end)

