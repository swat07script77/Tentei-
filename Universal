    local fpsPingDragStart = nil
    local fpsPingStartPos = nil
    local fpsPingFrameCount = 0
    local fpsPingTimeAccumulator = 0

    local function GetPing()
        local success, result = pcall(function() return player:GetNetworkPing() end)
        if success and result then return math.floor(result * 1000) end
        return 0
    end

    local function GetFpsColor(v)
        if v >= 60 then return Color3.fromRGB(0, 255, 100)
        elseif v >= 50 then return Color3.fromRGB(0, 255, 100):Lerp(Color3.fromRGB(200, 255, 50), (v - 50) / 10)
        elseif v >= 40 then return Color3.fromRGB(200, 255, 50):Lerp(Color3.fromRGB(255, 200, 0), (v - 40) / 10)
        elseif v >= 30 then return Color3.fromRGB(255, 200, 0):Lerp(Color3.fromRGB(255, 100, 0), (v - 30) / 10)
        elseif v >= 20 then return Color3.fromRGB(255, 100, 0):Lerp(Color3.fromRGB(200, 0, 0), (v - 20) / 10)
        else return Color3.fromRGB(200, 0, 0) end
    end

    local function GetPingColor(v)
        if v <= 50 then return Color3.fromRGB(0, 255, 100)
        elseif v <= 100 then return Color3.fromRGB(0, 255, 100):Lerp(Color3.fromRGB(255, 200, 0), (v - 50) / 50)
        elseif v <= 200 then return Color3.fromRGB(255, 200, 0):Lerp(Color3.fromRGB(255, 100, 0), (v - 100) / 100)
        elseif v <= 300 then return Color3.fromRGB(255, 100, 0):Lerp(Color3.fromRGB(200, 0, 0), (v - 200) / 100)
        else return Color3.fromRGB(200, 0, 0) end
    end

