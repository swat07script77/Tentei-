-- ANTI ITEM FLING
-- ============================================================
pcall(function()
    local antiItemFlingEnabled = false
    local conns = {}
    local processed = {}

    local function ghostifyTool(tool)
        if processed[tool] then return end
        processed[tool] = true
        for _, part in ipairs(tool:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
        tool.Destroying:Connect(function() processed[tool] = nil end)
    end

    AntiTab:CreateToggle({
        Title = "Anti Item Fling",
        Default = false,
        Callback = function(state)
            antiItemFlingEnabled = state
            if state then
                for _, tool in ipairs(workspace:GetDescendants()) do
                    if tool:IsA("Tool") then
                        local owner = tool.Parent
                        if owner ~= LocalPlayer.Character and owner ~= LocalPlayer:FindFirstChild("Backpack") then
                            ghostifyTool(tool)
                        end
                    end
                end
                table.insert(conns, workspace.DescendantAdded:Connect(function(desc)
                    if not antiItemFlingEnabled then return end
                    if desc:IsA("Tool") then
                        local owner = desc.Parent
                        if owner ~= LocalPlayer.Character and owner ~= LocalPlayer:FindFirstChild("Backpack") then
                            ghostifyTool(desc)
                        end
                    end
                end))
            else
                for _, c in ipairs(conns) do c:Disconnect() end
                conns = {}
                processed = {}
            end
        end,
    })
end)

