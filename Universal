        Title = "Show FPS Ping", Default = false,
        Callback = function(v)
            fpsPingActive = v
            if v then
                CreateFPSPingUI()
            else
                if fpsPingConn then fpsPingConn:Disconnect(); fpsPingConn = nil end
                if fpsPingGui then fpsPingGui:Destroy(); fpsPingGui = nil end
                fpsPingFrame = nil
                fpsPingLabel = nil
                pingPingLabel = nil
            end
        end,
    })
end
