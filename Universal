pcall(function()
    local bringActive = false
    local bringTarget = nil
    local bringOriginalCFrame = nil
    local bringSpeeding = 60
    local bringMaxSpeed = 75
    local bringOffRot = CFrame.Angles(-1.5707963267948966, 0, 0)
    local v3_0 = Vector3.new(0, 0, 0)

    PlayTab:CreateSlider({
        Title = "Bring Speed", Min = 20, Max = 200, Default = 75,
