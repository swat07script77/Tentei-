    CreateDropdownFor(MainTab, function(v) TargetPlayer = v end)

    local BOBBING_SPEED = 20
    local UP_FORCE = Vector3.new(0, 9e9, 0)

    local killAllLoopActive = false
    local killAllLoopConn = nil
    local killAllIndex = 1
    local killAllSwitch = 0.2
    local killAllLastSwitch = 0
    local killAllOriginalCF = nil
    MainTab:CreateToggle({
        Title = "Kill All Loop", Default = false,
        Callback = function(Value)
            killAllLoopActive = Value
            if killAllLoopConn then killAllLoopConn:Disconnect(); killAllLoopConn = nil end
            if Value then
                local char = LocalPlayer.Character
                if not char then return end
                local root = Root(char)
                if not root then return end
                killAllOriginalCF = root.CFrame
                killAllLastSwitch = tick()
                killAllLoopConn = RunService.Heartbeat:Connect(function()
                    if not killAllLoopActive then return end
                    local c = LocalPlayer.Character
                    if not c then return end
                    local r = Root(c)
                    local h = Hum(c)
                    if not r or not h then return end
                    h.PlatformStand = true
                    r.Velocity = Vector3.zero
                    r.RotVelocity = Vector3.zero
                    local targets = {}
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character then
                            local head = getHead(p.Character)
                            local hrp = Root(p.Character)
                            if head and hrp then table.insert(targets, {head = head, hrp = hrp}) end
                        end
                    end
                    if #targets == 0 then return end
                    if tick() - killAllLastSwitch >= killAllSwitch then
                        killAllIndex = (killAllIndex % #targets) + 1
                        killAllLastSwitch = tick()
                    end
                    local t = targets[killAllIndex]
                    if t and t.head and t.hrp then
                        local headPos = t.head.Position
                        local bellyPos = t.hrp.Position
                        local cycle = (tick() * BOBBING_SPEED) % 1
                        local y = headPos.Y + (bellyPos.Y - headPos.Y) * (0.5 - 0.5 * math.cos(cycle * 2 * math.pi))
                        r.CFrame = CFrame.new(headPos.X, y, headPos.Z)
                        r.Velocity = Vector3.zero
                        r.RotVelocity = Vector3.zero
                        t.hrp.Velocity = UP_FORCE
                        t.hrp.RotVelocity = Vector3.zero
                    end
                end)
            else
                local c = LocalPlayer.Character
                if c then
                    local h = Hum(c)
                    local r = Root(c)
                    if h then h.PlatformStand = false end
                    if r then
                        r.Velocity = Vector3.zero
                        r.RotVelocity = Vector3.zero
                        if killAllOriginalCF then r.CFrame = killAllOriginalCF end
                    end
                end
                killAllOriginalCF = nil
            end
        end,
    })

    local killAllRunning = false
    MainTab:CreateButton({
        Title = "Kill All",
        Callback = function()
            if killAllRunning then return end
            local c = LocalPlayer.Character
            if not c then return end
            local h = Hum(c)
            local r = Root(c)
            if not h or not r then return end
            killAllRunning = true
            local originalCF = r.CFrame
            local originalPlatform = h.PlatformStand
            h.PlatformStand = true
            local targets = {}
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local head = getHead(p.Character)
                    local hrp = Root(p.Character)
                    if head and hrp then table.insert(targets, {head = head, hrp = hrp}) end
                end
            end
            if #targets == 0 then
                h.PlatformStand = originalPlatform
                killAllRunning = false
                return
            end
            local idx = 1
            local conn
            conn = RunService.Heartbeat:Connect(function()
                if idx > #targets then
                    conn:Disconnect()
                    h.PlatformStand = originalPlatform
                    r.CFrame = originalCF
                    r.Velocity = Vector3.zero
                    r.RotVelocity = Vector3.zero
                    killAllRunning = false
                    return
                end
                local t = targets[idx]
                if t and t.head and t.head.Parent and t.hrp and t.hrp.Parent then
                    local headPos = t.head.Position
                    local bellyPos = t.hrp.Position
                    local cycle = (tick() * BOBBING_SPEED) % 1
                    local y = headPos.Y + (bellyPos.Y - headPos.Y) * (0.5 - 0.5 * math.cos(cycle * 2 * math.pi))
                    r.CFrame = CFrame.new(headPos.X, y, headPos.Z)
                    r.Velocity = Vector3.zero
                    r.RotVelocity = Vector3.zero
                    t.hrp.Velocity = UP_FORCE
                    t.hrp.RotVelocity = Vector3.zero
                    task.wait(0.08)
                end
                idx = idx + 1
            end)
        end,
    })

    MainTab:CreateButton({
        Title = "Kill Player",
        Callback = function()
