    local function SaveCollision(part)
        if savedCollisions[part] == nil then
            savedCollisions[part] = part.CanCollide
        end
    end

    local function RestorePart(part)
        if savedCollisions[part] ~= nil then
            if part and part.Parent then
                pcall(function() part.CanCollide = savedCollisions[part] end)
            end
            savedCollisions[part] = nil
        end
    end

    local function RestoreAllCollisions()
        for part, original in pairs(savedCollisions) do
            if part and part.Parent then
                pcall(function() part.CanCollide = original end)
            end
        end
        savedCollisions = {}
    end

    local function ApplyCollision(character)
        if not character then return end
        local hum = character:FindFirstChildOfClass("Humanoid")

        -- ✅ Só aplica se estiver MORTO (Health <= 0 ou sem Humanoid)
        local isDead = (not hum) or (hum.Health <= 0)

        if isDead then
            -- Aplica colisão falsa
            for _, v in ipairs(character:GetChildren()) do
                if v:IsA("BasePart") then
                    SaveCollision(v)
                    v.CanCollide = false
                    v.Velocity = Vector3.zero
                    v.RotVelocity = Vector3.zero
                end
            end
            for _, v in ipairs(character:GetChildren()) do
                if v:IsA("Accessory") then
                    for _, p in ipairs(v:GetDescendants()) do
                        if p:IsA("BasePart") then
                            SaveCollision(p)
                            p.CanCollide = false
                            p.Velocity = Vector3.zero
                            p.RotVelocity = Vector3.zero
                        end
                    end
                end
            end
        else
            -- ✅ Vivo → restaura o que foi salvo (caso tenha acabado de reviver)
            for _, v in ipairs(character:GetChildren()) do
                if v:IsA("BasePart") then RestorePart(v) end
            end
            for _, v in ipairs(character:GetChildren()) do
                if v:IsA("Accessory") then
                    for _, p in ipairs(v:GetDescendants()) do
                        if p:IsA("BasePart") then RestorePart(p) end
                    end
                end
            end
        end
    end

    local function BindCharacterRespawn(plr)
        if bypassCharConns[plr] then
            bypassCharConns[plr]:Disconnect()
            bypassCharConns[plr] = nil
        end
        bypassCharConns[plr] = plr.CharacterAdded:Connect(function(newChar)
            if not bypassActive then return end
            local root = newChar:WaitForChild("HumanoidRootPart", 3)
            if not root then return end
            ApplyCollision(newChar)
            task.delay(0.1, function() if bypassActive then ApplyCollision(newChar) end end)
            task.delay(0.3, function() if bypassActive then ApplyCollision(newChar) end end)
            task.delay(0.6, function() if bypassActive then ApplyCollision(newChar) end end)
        end)
        if plr.Character then
            ApplyCollision(plr.Character)
        end
    end

    local function UnbindAll()
        for _, conn in pairs(bypassCharConns) do
            if conn then conn:Disconnect() end
        end
        bypassCharConns = {}
        if bypassPlayerAddedConn then
            bypassPlayerAddedConn:Disconnect()
            bypassPlayerAddedConn = nil
        end
    end

    local function ProcessAllPlayers()
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                BindCharacterRespawn(plr)
            end
        end
    end

    AntiTab:CreateToggle({
        Title = "Anti Fling Bypass",
        Default = false,
        Callback = function(Value)
            bypassActive = Value

            if bypassConn then bypassConn:Disconnect(); bypassConn = nil end
            bypassLastRun = 0

            if not Value then
                UnbindAll()
                RestoreAllCollisions()
                return
            end

            ProcessAllPlayers()

            bypassConn = RunService.Heartbeat:Connect(function()
                if not bypassActive then return end
                local now = tick()
                if now - bypassLastRun < 0.15 then return end
                bypassLastRun = now
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character then
                        ApplyCollision(plr.Character)
                    end
                end
            end)

            bypassPlayerAddedConn = Players.PlayerAdded:Connect(function(plr)
                if bypassActive and plr ~= LocalPlayer then
                    BindCharacterRespawn(plr)
                end
            end)
        end,
    })
end)
