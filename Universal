                    local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum.Died:Connect(function()
                            if not spawnLockEnabled then return end
                            local r = LocalPlayer.Character and Root(LocalPlayer.Character)
                            if r then deathPosition = r.Position end
                        end)
                    end
                end
