    end

    local function stopFreeCam()
        freeCamActive = false
        if freeCamConn then freeCamConn:Disconnect(); freeCamConn = nil end
        local camera = workspace.CurrentCamera
        local char = player.Character
        if savedCamera.CameraType then camera.CameraType = savedCamera.CameraType end
        if savedCamera.CFrame then camera.CFrame = savedCamera.CFrame end
        if savedCamera.Focus then camera.Focus = savedCamera.Focus end
        if savedCamera.FieldOfView then camera.FieldOfView = savedCamera.FieldOfView end
        if savedCamera.CameraSubject then camera.CameraSubject = savedCamera.CameraSubject end
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = false end
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                root.Anchored = false
                if savedCharacter.Position then root.CFrame = CFrame.new(savedCharacter.Position) end
            end
        end
        savedCamera = {}
        savedCharacter = {}
        if speedMenu then speedMenu:Destroy(); speedMenu = nil; speedLabel = nil end
    end

    CfgTab:CreateToggle({
        Title = "Free Cam", Default = false,
        Callback = function(value)
            freeCamActive = value
            if not value then stopFreeCam() return end
            local camera = workspace.CurrentCamera
            local char = player.Character
            savedCamera = {
                CameraType = camera.CameraType, CFrame = camera.CFrame,
                Focus = camera.Focus, FieldOfView = camera.FieldOfView,
                CameraSubject = camera.CameraSubject,
            }
            if char then
                local root = char:FindFirstChild("HumanoidRootPart")
                if root then savedCharacter.Position = root.Position; root.Anchored = true end
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then hum.PlatformStand = true end
            end
            camera.CameraType = Enum.CameraType.Scriptable
            camera.FieldOfView = 70
            local cf = camera.CFrame
            camPos = cf.Position
            local lv = cf.LookVector
            yaw = math.deg(math.atan2(-lv.X, -lv.Z))
            pitch = math.deg(math.asin(math.clamp(lv.Y, -1, 1)))
            createSpeedMenu()
            local uis = UserInputService
            local upHeld, downHeld = false, false
            uis.InputBegan:Connect(function(input)
                if input.KeyCode == Enum.KeyCode.E then upHeld = true end
                if input.KeyCode == Enum.KeyCode.Q then downHeld = true end
            end)
            uis.InputEnded:Connect(function(input)
                if input.KeyCode == Enum.KeyCode.E then upHeld = false end
                if input.KeyCode == Enum.KeyCode.Q then downHeld = false end
            end)
            freeCamConn = RunService.RenderStepped:Connect(function(dt)
                if not freeCamActive then return end
                local vertInput = 0
                if upHeld then vertInput = vertInput + 1 end
                if downHeld then vertInput = vertInput - 1 end
                local moveVector = getMoveVector()
                local rotation = CFrame.Angles(0, math.rad(yaw), 0) * CFrame.Angles(math.rad(pitch), 0, 0)
                local right = rotation.RightVector
                local fwd = rotation.LookVector
                local move = (right * moveVector.X) + (fwd * -moveVector.Z) + (Vector3.yAxis * vertInput)
                camPos = camPos + move * camSpeed * dt
                local md = uis:GetMouseDelta()
                if md.X ~= 0 or md.Y ~= 0 then
                    yaw = yaw - md.X * LOOK_SENSITIVITY
                    pitch = math.clamp(pitch - md.Y * LOOK_SENSITIVITY, -89, 89)
                end
                camera.CFrame = CFrame.new(camPos) * rotation
            end)
        end,
    })
end

