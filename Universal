pcall(function()
    local HitboxTab = Window:CreateTab("Hitbox", "crosshair")

    local hitboxAllActive = false
    local hitboxSize = 2
    local hitboxTransparency = 0.3
    local hitboxRoundness = 0
    local hitboxColor = Color3.fromRGB(255, 0, 0)

    local hitboxTargetActive = false
    local hitboxTargetPlayer = nil
    local hitboxTargetMenu = nil

    local hitboxParts = {}
    local hitboxOriginalData = {}
    local hitboxAllConnections = {}
    local hitboxTargetConnections = {}
    local hitboxAllPlayerAddedConn = nil

    local function getHumanoidRootPart(plr)
        if not plr or not plr.Character then return nil end
        return plr.Character:FindFirstChild("HumanoidRootPart")
    end

    local function createHitboxMesh(part, roundness)
        if part:FindFirstChild("HitboxMesh") then part.HitboxMesh:Destroy() end
        if part:FindFirstChild("HitboxSphere") then part.HitboxSphere:Destroy() end
        if part:FindFirstChild("HitboxBlock") then part.HitboxBlock:Destroy() end
        local mesh
        local r = math.clamp(roundness / 100, 0, 1)
        if r >= 0.99 then
            mesh = Instance.new("SpecialMesh")
            mesh.Name = "HitboxSphere"
            mesh.MeshType = Enum.MeshType.Sphere
            mesh.Scale = Vector3.new(1, 1, 1)
        elseif r >= 0.5 then
            mesh = Instance.new("SpecialMesh")
            mesh.Name = "HitboxMesh"
            mesh.MeshType = Enum.MeshType.FileMesh
            mesh.MeshId = "rbxassetid://779073531"
            mesh.Scale = Vector3.new(1, 1, 1)
        else
            mesh = Instance.new("SpecialMesh")
            mesh.Name = "HitboxBlock"
            mesh.MeshType = Enum.MeshType.Brick
            mesh.Scale = Vector3.new(1, 1, 1)
        end
        mesh.Parent = part
        return mesh
    end

    local function applyHitboxToPart(part, size, transparency, roundness, color)
        if not part or not part:IsA("BasePart") then return end
        if not hitboxOriginalData[part] then
            hitboxOriginalData[part] = {
                Size = part.Size,
                Transparency = part.Transparency,
                Color = part.Color,
                Material = part.Material,
                CanCollide = part.CanCollide,
            }
        end
        part.CanCollide = false
        part.Size = Vector3.new(size, size, size)
        part.Transparency = transparency
        part.Material = Enum.Material.SmoothPlastic
        part.Color = color
        createHitboxMesh(part, roundness)
        local outline = part:FindFirstChild("HitboxOutline")
        if not outline then
            outline = Instance.new("SelectionBox")
            outline.Name = "HitboxOutline"
            outline.Adornee = part
            outline.Color3 = color
            outline.Transparency = math.max(0, transparency - 0.2)
            outline.Parent = part
        else
            outline.Color3 = color
            outline.Transparency = math.max(0, transparency - 0.2)
        end
        table.insert(hitboxParts, part)
    end

    local function removeHitboxFromPart(part)
        if not part or not part.Parent then return end
        if hitboxOriginalData[part] then
            local data = hitboxOriginalData[part]
            part.Size = data.Size
            part.Transparency = data.Transparency
            part.Color = data.Color
            part.Material = data.Material
            part.CanCollide = data.CanCollide
            hitboxOriginalData[part] = nil
        end
        if part:FindFirstChild("HitboxMesh") then part.HitboxMesh:Destroy() end
        if part:FindFirstChild("HitboxSphere") then part.HitboxSphere:Destroy() end
        if part:FindFirstChild("HitboxBlock") then part.HitboxBlock:Destroy() end
        if part:FindFirstChild("HitboxOutline") then part.HitboxOutline:Destroy() end
        for i = #hitboxParts, 1, -1 do
            if hitboxParts[i] == part then
                table.remove(hitboxParts, i)
                break
            end
        end
    end

    local function removeFromAllPlayers()
        local partsToRemove = {}
        for _, part in pairs(hitboxParts) do table.insert(partsToRemove, part) end
        for _, part in pairs(partsToRemove) do removeHitboxFromPart(part) end
        hitboxParts = {}
        hitboxOriginalData = {}
    end

    local function refreshAllHitboxes()
        if hitboxAllActive then
            for _, plr in pairs(game.Players:GetPlayers()) do
                if plr ~= player then
                    local root = getHumanoidRootPart(plr)
                    if root then applyHitboxToPart(root, hitboxSize, hitboxTransparency, hitboxRoundness, hitboxColor) end
                end
            end
        end
        if hitboxTargetActive and hitboxTargetPlayer then
            local root = getHumanoidRootPart(hitboxTargetPlayer)
            if root then applyHitboxToPart(root, hitboxSize, hitboxTransparency, hitboxRoundness, hitboxColor) end
        end
    end

    local function setupPlayerAutoReconnect(plr, isTarget)
        if not plr or plr == player then return end
        local function onCharacterAdded()
            task.wait(0.5)
            if not plr or not plr.Parent then return end
            if isTarget and hitboxTargetActive and hitboxTargetPlayer == plr then
                local root = getHumanoidRootPart(plr)
                if root then applyHitboxToPart(root, hitboxSize, hitboxTransparency, hitboxRoundness, hitboxColor) end
            elseif not isTarget and hitboxAllActive then
                local root = getHumanoidRootPart(plr)
                if root then applyHitboxToPart(root, hitboxSize, hitboxTransparency, hitboxRoundness, hitboxColor) end
            end
        end
        local conn = plr.CharacterAdded:Connect(onCharacterAdded)
        if isTarget then table.insert(hitboxTargetConnections, conn)
        else table.insert(hitboxAllConnections, conn) end
        if plr.Character then task.wait(0.1); onCharacterAdded() end
    end

    local function setupAllPlayersAutoReconnect()
        for _, conn in pairs(hitboxAllConnections) do conn:Disconnect() end
        hitboxAllConnections = {}
        if hitboxAllPlayerAddedConn then hitboxAllPlayerAddedConn:Disconnect(); hitboxAllPlayerAddedConn = nil end
        for _, plr in pairs(game.Players:GetPlayers()) do
            if plr ~= player then setupPlayerAutoReconnect(plr, false) end
        end
        hitboxAllPlayerAddedConn = game.Players.PlayerAdded:Connect(function(plr)
            if plr ~= player then setupPlayerAutoReconnect(plr, false) end
        end)
        table.insert(hitboxAllConnections, hitboxAllPlayerAddedConn)
    end

    local function setupTargetAutoReconnect(plr)
        for _, conn in pairs(hitboxTargetConnections) do conn:Disconnect() end
        hitboxTargetConnections = {}
        if plr and plr ~= player then setupPlayerAutoReconnect(plr, true) end
    end

    HitboxTab:CreateToggle({
        Title = "Hitbox",
        Default = false,
        Callback = function(Value)
            hitboxAllActive = Value
            if Value then
                for _, plr in pairs(game.Players:GetPlayers()) do
                    if plr ~= player then
                        local root = getHumanoidRootPart(plr)
                        if root then applyHitboxToPart(root, hitboxSize, hitboxTransparency, hitboxRoundness, hitboxColor) end
                    end
                end
                setupAllPlayersAutoReconnect()
                Notify("Hitbox", "Enabled for all players", 2)
            else
                removeFromAllPlayers()
                for _, conn in pairs(hitboxAllConnections) do conn:Disconnect() end
                hitboxAllConnections = {}
                if hitboxAllPlayerAddedConn then hitboxAllPlayerAddedConn:Disconnect(); hitboxAllPlayerAddedConn = nil end
                Notify("Hitbox", "Disabled", 1)
            end
        end,
    })

    HitboxTab:CreateToggle({
        Title = "Hitbox Target",
        Default = false,
        Callback = function(Value)
            if Value then
                if hitboxTargetMenu then hitboxTargetMenu:Destroy() end
                hitboxTargetMenu = Instance.new("Frame")
