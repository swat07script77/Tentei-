local auraActive = false
local auraConnection = nil
local auraAttackConnection = nil
local isAttacking = false
local lastAttackTime = 0
local auraOriginalCFrame = nil
local AURA_DISTANCE = 2
local ATTACK_DURATION = 2
local COOLDOWN = 1

local function restoreCharacter(originalCFrame)
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if hum then hum.PlatformStand = false; hum.AutoRotate = true end
    if root then
        attach(root, nil)
        root.Velocity = Vector3.zero
        root.RotVelocity = Vector3.zero
        if originalCFrame then root.CFrame = originalCFrame end
    end
end

local function attackTarget(targetPlayer)
    if isAttacking then return end
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar:FindFirstChild("Humanoid")
    if not myRoot or not myHum then return end
    local targetChar = targetPlayer.Character
    if not targetChar then return end
    local targetHead = targetChar:FindFirstChild("Head")
    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetHead or not targetHRP then return end
    auraOriginalCFrame = myRoot.CFrame
    myHum.PlatformStand = true
    isAttacking = true
    local startTime = tick()
    auraAttackConnection = RunService.Heartbeat:Connect(function()
        if tick() - startTime >= ATTACK_DURATION or not auraActive then
            if auraAttackConnection then auraAttackConnection:Disconnect(); auraAttackConnection = nil end
            restoreCharacter(auraOriginalCFrame)
            isAttacking = false
            lastAttackTime = tick()
            return
        end
        local curChar = LocalPlayer.Character
        local curTarget = targetPlayer.Character
        if not curChar or not curTarget then
            if auraAttackConnection then auraAttackConnection:Disconnect(); auraAttackConnection = nil end
            restoreCharacter(auraOriginalCFrame)
            isAttacking = false
            return
        end
        local curRoot = curChar:FindFirstChild("HumanoidRootPart")
        local curHead = curTarget:FindFirstChild("Head")
        local curHRP = curTarget:FindFirstChild("HumanoidRootPart")
        if not curRoot or not curHead or not curHRP then
            if auraAttackConnection then auraAttackConnection:Disconnect(); auraAttackConnection = nil end
            restoreCharacter(auraOriginalCFrame)
            isAttacking = false
            return
        end
        local headPos = curHead.Position
        local bellyPos = curHRP.Position
        local cycle = (tick() * BOBBING_SPEED) % 1
        local y = headPos.Y + (bellyPos.Y - headPos.Y) * (0.5 - 0.5 * math.cos(cycle * 2 * math.pi))
        curRoot.CFrame = CFrame.new(headPos.X, y, headPos.Z)
        curRoot.Velocity = Vector3.zero
        curRoot.RotVelocity = Vector3.zero
        curHRP.Velocity = Vector3.new(0, 9e9, 0)
        curHRP.RotVelocity = Vector3.zero
        attach(curRoot, curHRP)
    end)
end

MainTab:CreateToggle({
    Title = "Kill Aura",
    Default = false,
    Callback = function(Value)
        auraActive = Value
        if auraConnection then auraConnection:Disconnect(); auraConnection = nil end
        if auraAttackConnection then auraAttackConnection:Disconnect(); auraAttackConnection = nil end
        isAttacking = false
        if Value then
            auraConnection = RunService.Heartbeat:Connect(function()
                if not auraActive or isAttacking then return end
                if tick() - lastAttackTime < COOLDOWN then return end
                local myChar = LocalPlayer.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if not myRoot then return end
                local closest = nil
                local minDist = AURA_DISTANCE
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        local head = p.Character:FindFirstChild("Head")
                        if head then
                            local dist = (head.Position - myRoot.Position).Magnitude
                            if dist < minDist then
                                minDist = dist
                                closest = p
                            end
                        end
                    end
                end
                if closest then attackTarget(closest) end
            end)
        else
            restoreCharacter(auraOriginalCFrame)
        end
    end,
})

local walkFlingEnabled = false
local walkFlingThread = nil
MainTab:CreateToggle({
    Title = "WalkFling",
    Default = false,
    Callback = function(State)
        walkFlingEnabled = State
        if State then
            local movel = 0.1
            if walkFlingThread then task.cancel(walkFlingThread) end
            walkFlingThread = task.spawn(function()
                while walkFlingEnabled do
                    RunService.Heartbeat:Wait()
                    local char = LocalPlayer.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    while walkFlingEnabled and not (char and char.Parent and root and root.Parent) do
                        RunService.Heartbeat:Wait()
                        char = LocalPlayer.Character
                        root = char and char:FindFirstChild("HumanoidRootPart")
                    end
                    if not walkFlingEnabled then break end
                    local vel = root.Velocity
                    root.Velocity = vel * 10000 + Vector3.new(0, 10000, 0)
                    RunService.RenderStepped:Wait()
                    if walkFlingEnabled and char.Parent and root.Parent then
                        root.Velocity = vel
                    end
                    RunService.Stepped:Wait()
                    if walkFlingEnabled and char.Parent and root.Parent then
                        root.Velocity = vel + Vector3.new(0, movel, 0)
                        movel = movel * -1
                    end
                end
            end)
        else
            walkFlingEnabled = false
            if walkFlingThread then task.cancel(walkFlingThread); walkFlingThread = nil end
            local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if root then root.Velocity = Vector3.zero end
        end
    end,
})

local spawnLockEnabled = false
local deathPosition = nil
local spawnLockConnection = nil
MainTab:CreateToggle({
    Title = "Spawn Lock",
    Default = false,
    Callback = function(State)
        spawnLockEnabled = State
        if State then
            if spawnLockConnection then spawnLockConnection:Disconnect() end
            spawnLockConnection = LocalPlayer.CharacterAdded:Connect(function(char)
                if not spawnLockEnabled then return end
                local root = char:WaitForChild("HumanoidRootPart", 5)
                if not root then return end
                if deathPosition then
                    root.CFrame = CFrame.new(deathPosition)
                    attach(root, root)
                end
                local hum = char:WaitForChild("Humanoid")
                if hum then
                    hum.Died:Connect(function()
                        if not spawnLockEnabled then return end
                        local currentRoot = char:FindFirstChild("HumanoidRootPart")
                        if currentRoot then deathPosition = currentRoot.Position end
                    end)
                end
            end)
            if LocalPlayer.Character then
                local currentChar = LocalPlayer.Character
                local hum = currentChar:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.Died:Connect(function()
                        if not spawnLockEnabled then return end
                        local root = currentChar:FindFirstChild("HumanoidRootPart")
                        if root then deathPosition = root.Position end
                    end)
                end
            end
        else
            if spawnLockConnection then spawnLockConnection:Disconnect(); spawnLockConnection = nil end
            deathPosition = nil
            local currentChar = LocalPlayer.Character
            if currentChar then
                local root = currentChar:FindFirstChild("HumanoidRootPart")
                if root then attach(root, nil) end
            end
        end
    end,
})

local swimActive = false
local swimLoop = nil
MainTab:CreateToggle({
    Title = "Swim",
    Default = false,
    Callback = function(Value)
        swimActive = Value
        local char = LocalPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        if not root or not hum then return end
        local function cleanup()
            if root then
                if root:FindFirstChild("SwimVelocity") then root.SwimVelocity:Destroy() end
                if root:FindFirstChild("SwimGyro") then root.SwimGyro:Destroy() end
            end
            if hum then
                hum.PlatformStand = false
                hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
            if swimLoop then swimLoop:Disconnect(); swimLoop = nil end
        end
        if Value then
            local speed = 60
            local bv = Instance.new("BodyVelocity")
            bv.Name = "SwimVelocity"
            bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bv.Parent = root
            local bg = Instance.new("BodyGyro")
            bg.Name = "SwimGyro"
            bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            bg.P = 5000
            bg.Parent = root
            local camera = workspace.CurrentCamera
            local uis = UserInputService
            swimLoop = RunService.RenderStepped:Connect(function()
                if not swimActive or not char.Parent then cleanup(); return end
                hum:ChangeState(Enum.HumanoidStateType.Swimming)
                local moveDir = hum.MoveDirection
                local verticalMove = 0
                if uis:IsKeyDown(Enum.KeyCode.Space) then verticalMove = 1
                elseif uis:IsKeyDown(Enum.KeyCode.LeftControl) then verticalMove = -1 end
                local totalDir = moveDir + Vector3.new(0, verticalMove, 0)
                if totalDir.Magnitude > 0 then
                    bv.Velocity = totalDir.Unit * speed
                else
                    bv.Velocity = Vector3.zero
                end
                bg.CFrame = camera.CFrame * CFrame.Angles(math.rad(-90), 0, 0)
            end)
        else
            cleanup()
        end
    end,
})

