do
    local active = false
    local speedFactor = 1
    local animLoop = nil
    local animCharConn = nil
    local animHeartbeat = nil

    local function applyToAllAnimations(factor)
        local char = player.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local animator = hum:FindFirstChildOfClass("Animator")
        if not animator then return end
        for _, track in pairs(animator:GetPlayingAnimationTracks()) do
            pcall(function() track:AdjustSpeed(factor) end)
        end
    end

    local function forceAnimSpeed()
        if active then applyToAllAnimations(speedFactor) end
    end

    local function setupAnimLoop()
        if animLoop then animLoop:Disconnect(); animLoop = nil end
        if animHeartbeat then animHeartbeat:Disconnect(); animHeartbeat = nil end
        local char = player.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        animHeartbeat = RunService.Heartbeat:Connect(forceAnimSpeed)
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            animLoop = animator:GetPropertyChangedSignal("IsPlaying"):Connect(forceAnimSpeed)
        end
    end

    CfgTab:CreateToggle({
        Title = "AnimSpeed",
        Default = false,
        Callback = function(v)
            active = v
            if v then
                speedFactor = 1
                applyToAllAnimations(1)
                setupAnimLoop()
                Notify("AnimSpeed", "Enabled", 2)
            else
                if animLoop then animLoop:Disconnect(); animLoop = nil end
                if animHeartbeat then animHeartbeat:Disconnect(); animHeartbeat = nil end
                applyToAllAnimations(1)
                Notify("AnimSpeed", "Disabled", 1)
            end
        end,
    })

    local function mapSpeed(value) return (value + 10) * 0.045454545 end

    CfgTab:CreateSlider({
        Title = "Anim Speed", Min = -10, Max = 100, Default = 0,
        Callback = function(v)
            speedFactor = mapSpeed(v)
            if active then applyToAllAnimations(speedFactor) end
        end,
    })

    animCharConn = player.CharacterAdded:Connect(function()
        if active then task.wait(0.3); applyToAllAnimations(speedFactor) end
    end)
end

do
    local spinActive = false
    local spinSpeed = 10
    local spinConnection = nil
    local originalAutoRotate = nil
    local spinCharConn = nil

    local function startSpin()
        local char = player.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end
        if originalAutoRotate == nil then originalAutoRotate = hum.AutoRotate end
        hum.AutoRotate = false
        if spinConnection then spinConnection:Disconnect(); spinConnection = nil end
        spinConnection = RunService.Heartbeat:Connect(function(dt)
            if not spinActive then return end
            local curChar = player.Character
            if not curChar then return end
            local curRoot = curChar:FindFirstChild("HumanoidRootPart")
            if not curRoot then return end
            local angle = math.rad(spinSpeed) * dt * 10
            curRoot.CFrame = curRoot.CFrame * CFrame.Angles(0, angle, 0)
        end)
    end

    CfgTab:CreateToggle({
        Title = "Spin",
        Default = false,
        Callback = function(value)
            spinActive = value
            if value then
                startSpin()
                Notify("Spin", "Enabled", 2)
            else
                if spinConnection then spinConnection:Disconnect(); spinConnection = nil end
                local char = player.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum and originalAutoRotate ~= nil then hum.AutoRotate = originalAutoRotate end
                    originalAutoRotate = nil
                end
                Notify("Spin", "Disabled", 1)
            end
        end,
    })

    CfgTab:CreateSlider({
        Title = "Spin Speed", Min = -1000, Max = 1000, Default = 10,
        Callback = function(value) spinSpeed = value; if spinActive then startSpin() end end,
    })

    spinCharConn = player.CharacterAdded:Connect(function()
        if spinActive then task.wait(0.5); originalAutoRotate = nil; startSpin() end
    end)
end
