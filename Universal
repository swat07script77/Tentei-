                                for _, child in ipairs(part:GetChildren()) do
                                    if child:IsA("Torque") and not hasStomp then child:Destroy() end
                                    if child:IsA("Attachment") then
                                        local other = child.Attachment0 or child.Attachment1
                                        if other and other:IsA("Attachment") then
                                            local otherPart = other.Parent
                                            if otherPart and otherPart:IsA("BasePart") and not otherPart:IsDescendantOf(curChar) then
                                                child:Destroy()
                                            end
                                        end
                                    end
                                end
                            end
