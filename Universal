    local controlActive = false
    local controlMode = "Default"
    local controlOffsets = {
        Default = Vector3.new(0, -20, 0),
        W = Vector3.new(0, 0.7, 0.5),
        A = Vector3.new(1.7, 0.7, 0),
        S = Vector3.new(0, 0.7, -0.5),
        D = Vector3.new(-1.7, 0.7, 0),
        Space = Vector3.new(0, -3, 0),
    }
    PlayTab:CreateToggle({
        Title = "Control",
        Default = false,
        Callback = function(Value)
            controlActive = Value
            controlMode = "Default"
            if not Value then
                local mh = Hum(LocalPlayer.Character)
                if mh then workspace.CurrentCamera.CameraSubject = mh end
                return
            end
            local t = GetPlayTarget()
            if not t or not t.Character then return end
            local th = Hum(t.Character)
            if th then workspace.CurrentCamera.CameraSubject = th end
            local inputBegan = UserInputService.InputBegan:Connect(function(input, gp)
                if gp or not controlActive then return end
                if input.KeyCode == Enum.KeyCode.W then controlMode = "W"
                elseif input.KeyCode == Enum.KeyCode.A then controlMode = "A"
                elseif input.KeyCode == Enum.KeyCode.S then controlMode = "S"
                elseif input.KeyCode == Enum.KeyCode.D then controlMode = "D"
                elseif input.KeyCode == Enum.KeyCode.Space then controlMode = "Space"
                end
            end)
            local inputEnded = UserInputService.InputEnded:Connect(function(input, gp)
                if not controlActive then return end
                if input.KeyCode == Enum.KeyCode.W or input.KeyCode == Enum.KeyCode.A or input.KeyCode == Enum.KeyCode.S or input.KeyCode == Enum.KeyCode.D or input.KeyCode == Enum.KeyCode.Space then
                    controlMode = "Default"
                end
            end)
            local conn
            conn = RunService.Heartbeat:Connect(function()
                if not controlActive then
                    conn:Disconnect()
                    inputBegan:Disconnect()
                    inputEnded:Disconnect()
                    return
                end
                local tt = GetPlayTarget()
                if not tt or not tt.Character then return end
                local tr = Root(tt.Character)
                local mr = Root(LocalPlayer.Character)
                if not tr or not mr then return end
                local offset = controlOffsets[controlMode] or controlOffsets.Default
                mr.CFrame = tr.CFrame * CFrame.new(offset)
                mr.Velocity = Vector3.zero
                mr.RotVelocity = Vector3.zero
            end)
        end,
    })
end)
    
