local killRunning = false

MainTab:CreateButton({
    Title = "Kill",
    Callback = function()
        if killRunning then return end

        local t = GetTarget()
        if not t or not t.Character then
            Window:Notify({
                Title       = "Kill",
                Description = "Select a player in the dropdown first.",
                Duration    = 2,
                Type        = "warning",
            })
            return
        end

        local char = LocalPlayer.Character
        if not char then return end

        local root = char:FindFirstChild("HumanoidRootPart")
        local hum  = char:FindFirstChildOfClass("Humanoid")
        local targetRoot = t.Character:FindFirstChild("HumanoidRootPart")
        local targetHead = t.Character:FindFirstChild("Head")
        if not root or not hum or not targetRoot or not targetHead then
            Window:Notify({
                Title       = "Kill",
                Description = "Character or target incomplete.",
                Duration    = 2,
                Type        = "warning",
            })
            return
        end

        killRunning = true

        local KILL_DURATION = 1.5
        local originalCFrame = root.CFrame
        local originalPlatform = hum.PlatformStand
        hum.PlatformStand = true

        local UP_FORCE = Vector3.new(0, 9e9, 0)
        local bobbingSpeed = 20
        local startTime = tick()
        local conn
        local done = false

        local function finishKill()
            if done then return end
            done = true
            killRunning = false

            if conn then
                pcall(function() conn:Disconnect() end)
                conn = nil
            end

            pcall(function()
                local curChar = LocalPlayer.Character
                if not curChar then return end

                local curRoot = curChar:FindFirstChild("HumanoidRootPart")
                local curHum  = curChar:FindFirstChildOfClass("Humanoid")

                if curHum and curHum.Parent then
                    curHum.PlatformStand = originalPlatform or false
                end

                if curRoot and curRoot.Parent then
                    attach(curRoot, nil)
                    curRoot.Velocity    = Vector3.zero
                    curRoot.RotVelocity = Vector3.zero
                    curRoot.CFrame      = originalCFrame
                end
            end)
        end

        conn = RunService.Heartbeat:Connect(function()
            if done then return end

            if tick() - startTime >= KILL_DURATION then
                finishKill()
                Window:Notify({
                    Title       = "Kill",
                    Description = "Returned to original position.",
                    Duration    = 1.5,
                    Type        = "success",
                })
                return
            end

            local curChar = LocalPlayer.Character
            if not curChar then finishKill() return end

            local curRoot = curChar:FindFirstChild("HumanoidRootPart")
            local curHum  = curChar:FindFirstChildOfClass("Humanoid")
            if not curRoot or not curHum or curHum.Health <= 0 then
                finishKill()
                return
            end

            local curTarget = t.Character
            if not curTarget then finishKill() return end
            local tRoot = curTarget:FindFirstChild("HumanoidRootPart")
            local tHead = curTarget:FindFirstChild("Head")
            if not tRoot or not tHead then finishKill() return end

            curHum.PlatformStand = true

            local headPos = tHead.Position
            local bellyPos = tRoot.Position
            local cycle = (tick() * bobbingSpeed) % 1
            local y = headPos.Y + (bellyPos.Y - headPos.Y) * (0.5 - 0.5 * math.cos(cycle * 2 * math.pi))

            curRoot.CFrame = CFrame.new(headPos.X, y, headPos.Z)
            curRoot.Velocity = Vector3.zero
            curRoot.RotVelocity = Vector3.zero

            tRoot.Velocity = UP_FORCE
            tRoot.RotVelocity = Vector3.zero

            attach(curRoot, tRoot)
        end)
    end,
})
