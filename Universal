pcall(function()
    local MainSwordsTab = Window:CreateTab("Main Swords", "swords")
    local MainTab = Window:CreateTab("Main", "home")
    local PlayTab = Window:CreateTab("Play", "play")
    local AntiTab = Window:CreateTab("Anti", "shield")

    local function Root(M) return M and M:FindFirstChild("HumanoidRootPart") end
    local function Hum(M) return M and M:FindFirstChildOfClass("Humanoid") end
    local function getHead(c) return c and c:FindFirstChild("Head") end
    local function attach(Part, TargetPart)
        pcall(sethiddenproperty, Part, 'PhysicsRepRootRef', InstanceHandle and InstanceHandle.new(TargetPart or Part) or (TargetPart or Part))
    end

    local function CreateDropdownFor(Tab, setter)
        local dropdown
        local list = {}
        local function refresh()
            list = {}
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then table.insert(list, plr.Name) end
            end
            table.sort(list)
            if dropdown and dropdown.Update then
                pcall(function() dropdown:Update({ Options = list }) end)
            end
        end
        dropdown = Tab:CreateDropdown({
            Title = "Select Target",
            Options = {},
            Callback = function(Value) setter(Value) end,
        })
        refresh()
        Tab:CreateButton({
            Title = "Refresh Target List",
            Callback = function() refresh() end,
        })
        return function() return dropdown end
    end

    local SwordsTarget = nil
    local function GetSwordsTarget()
        if not SwordsTarget or SwordsTarget == "" then return nil end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Name == SwordsTarget then return plr end
        end
        return nil
    end
    CreateDropdownFor(MainSwordsTab, function(v) SwordsTarget = v end)

    local function Mvmentbtn(Name, Offset, IsFling)
        local Conn, SavedCF
        MainSwordsTab:CreateToggle({
            Title = Name, Default = false,
            Callback = function(State)
                if Conn then Conn:Disconnect(); Conn = nil end
                local LRoot = Root(LocalPlayer.Character)
                if not State then
                    if LRoot and SavedCF then
                        LRoot.CFrame = SavedCF
                        LRoot.Velocity = Vector3.zero
                        LRoot.RotVelocity = Vector3.zero
                        SavedCF = nil
                    end
                    if LRoot then attach(LRoot, LRoot) end
                    return
                end
                if LRoot then SavedCF = LRoot.CFrame end
                Conn = RunService.Heartbeat:Connect(function()
                    local CurrentLRoot = Root(LocalPlayer.Character)
                    local t = GetSwordsTarget()
                    local TRoot = t and Root(t.Character)
                    if not (CurrentLRoot and TRoot) then return end
                    CurrentLRoot.CFrame = CFrame.new(TRoot.Position + Offset) * CFrame.Angles(-math.pi/2, 0, 0)
                    local Vel = IsFling and Vector3.new(500, 500, 500) or Vector3.zero
                    CurrentLRoot.Velocity = Vel
                    CurrentLRoot.RotVelocity = Vel
                    attach(CurrentLRoot, TRoot)
                end)
            end,
        })
    end
    Mvmentbtn("Fling Player", Vector3.new(0, 0, 0), true)
    Mvmentbtn("Fling 2.0", Vector3.new(0, -2.5, 0), true)
    Mvmentbtn("Platform Fly", Vector3.new(0, -2.8, 0), false)
    Mvmentbtn("Magic Carpet", Vector3.new(0, -3.1, 0), false)
    Mvmentbtn("Elevator", Vector3.new(0, -2.6, 0), false)
    Mvmentbtn("Anti Jump", Vector3.new(0, 3.5, 0), false)

    local function Bind(Name, Offset)
        local Conn
        MainSwordsTab:CreateToggle({
            Title = Name, Default = false,
            Callback = function(State)
                if Conn then Conn:Disconnect(); Conn = nil end
                local LRoot = Root(LocalPlayer.Character)
                if not State then
                    if LRoot then
                        LRoot.Velocity = Vector3.zero
                        attach(LRoot, LRoot)
                    end
                    return
                end
                Conn = RunService.Heartbeat:Connect(function()
                    local CurrentLRoot = Root(LocalPlayer.Character)
                    local t = GetSwordsTarget()
                    local TRoot = t and Root(t.Character)
                    if CurrentLRoot and TRoot then
                        CurrentLRoot.CFrame = TRoot.CFrame * CFrame.new(Offset)
                        CurrentLRoot.Velocity = Vector3.zero
                        attach(CurrentLRoot, TRoot)
                    end
                end)
            end,
        })
    end
