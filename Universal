        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                if bringOriginalCFrame then
                    root.CFrame = bringOriginalCFrame
                    bringOriginalCFrame = nil
                end
                root.Velocity = v3_0
                root.RotVelocity = v3_0
                detach(root)
            end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.PlatformStand = false
