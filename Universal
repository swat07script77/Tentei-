local flingTargetRunning = false
PlayTab:CreateButton({
    Title = "Fling Target",
    Callback = function()
        if flingTargetRunning then return end
        local t = GetPlayTarget()
        if not t then return end
        local targetRoot = getRoot(t.Character)
        local myRoot = getRoot(player.Character)
        local myHum = getHum(player.Character)
        if not targetRoot or not myRoot or not myHum then return end
        flingTargetRunning = true
        local originalCFrame = myRoot.CFrame
        local orbitAngle = 0
        local orbitPositions = {
            CFrame.new(0, 1.5, 0),
            CFrame.new(0, -1.5, 0),
            CFrame.new(2.25, 1.5, -2.25),
            CFrame.new(-2.25, -1.5, 2.25),
            CFrame.new(0, 1.5, 0),
            CFrame.new(0, -1.5, 0)
        }
        local orbitIndex = 1
        local bv = Instance.new("BodyVelocity")
        bv.Name = "EpixVel"
        bv.Velocity = Vector3.new(9e8, 9e8, 9e8)
        bv.MaxForce = Vector3.new(1/0, 1/0, 1/0)
        bv.Parent = targetRoot
        pcall(function()
            targetRoot.Parent:FindFirstChildOfClass("Humanoid"):SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        end)
        workspace.FallenPartsDestroyHeight = 0/0
        local connection
        connection = RunService.Heartbeat:Connect(function(dt)
            if not targetRoot or not targetRoot.Parent or not myRoot or not myRoot.Parent then
                connection:Disconnect(); bv:Destroy(); flingTargetRunning = false; return
            end
            orbitIndex = orbitIndex % #orbitPositions + 1
            orbitAngle = orbitAngle + 100 * dt
            local offset = orbitPositions[orbitIndex]
            local rotatedOffset = offset * CFrame.Angles(math.rad(orbitAngle), 0, 0)
            myRoot.CFrame = CFrame.new(targetRoot.Position) * rotatedOffset
            myRoot.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
            myRoot.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
            attach(myRoot, targetRoot)
        end)
        task.delay(5, function()
            if connection then connection:Disconnect() end
            bv:Destroy()
            workspace.FallenPartsDestroyHeight = -500
            if myRoot and myRoot.Parent then
                myRoot.CFrame = originalCFrame
                myRoot.Velocity = Vector3.zero
                myRoot.RotVelocity = Vector3.zero
                detach(myRoot)
            end
            flingTargetRunning = false
        end)
    end,
})

