-- ============================================================
-- ANTI BANG
-- ============================================================
pcall(function()
    local ANTI_BANG_ANIMS = {"148840371", "5918726674"}
    local ANTI_BANG_RANGE = 15
    local antiBangInProgress = false
    local antiBangToggleActive = false
    local antiBangDetectionConn = nil

    local function isPlayerBanging(targetPlayer)
        if not targetPlayer.Character then return false end
        local hum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
        if not hum then return false end
        local animator = hum:FindFirstChildOfClass("Animator")
        if not animator then return false end
        for _, track in pairs(animator:GetPlayingAnimationTracks()) do
            if track.Animation then
                local id = track.Animation.AnimationId
                for _, bangId in ipairs(ANTI_BANG_ANIMS) do
                    if id:find(bangId) then return true end
                end
            end
        end
        return false
    end

    local function getBangPlayerWithinRange()
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not myRoot then return nil end
        for _, targetPlayer in ipairs(Players:GetPlayers()) do
            if targetPlayer ~= LocalPlayer and targetPlayer.Character then
                local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                if targetRoot and (targetRoot.Position - myRoot.Position).Magnitude <= ANTI_BANG_RANGE then
                    if isPlayerBanging(targetPlayer) then return targetPlayer end
                end
            end
        end
        return nil
    end

    local function doAntiBangTeleport()
        if antiBangInProgress then return end
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        antiBangInProgress = true
        local lastCFrame = root.CFrame
        pcall(function() workspace.FallenPartsDestroyHeight = -1000 end)
        root.CFrame = CFrame.new(0, -500, 0)
        task.wait(0.7)
        if root and root.Parent then root.CFrame = lastCFrame end
        pcall(function() workspace.FallenPartsDestroyHeight = -500 end)
        antiBangInProgress = false
    end

    AntiTab:CreateToggle({
        Title = "Anti Bang",
        Default = false,
        Callback = function(Value)
            antiBangToggleActive = Value
            if Value then
                if antiBangDetectionConn then antiBangDetectionConn:Disconnect() end
                antiBangDetectionConn = RunService.Heartbeat:Connect(function()
                    if not antiBangToggleActive or antiBangInProgress then return end
                    if getBangPlayerWithinRange() then doAntiBangTeleport() end
                end)
            else
                if antiBangDetectionConn then antiBangDetectionConn:Disconnect(); antiBangDetectionConn = nil end
            end
        end,
    })

    AntiTab:CreateButton({
        Title = "Bang Escape",
        Callback = function()
            if antiBangInProgress then return end
            if not getBangPlayerWithinRange() then return end
            doAntiBangTeleport()
        end,
    })
end)

